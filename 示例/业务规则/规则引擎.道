// 业务规则 DSL 引擎（纯道语言实现）
// 约定：业务侧用正谓词 风险(对象, 标签) 表达命中事实；本模块只做注册、
// 按优先级排序与处理器分派，不修改解释器核心。

// “无结果”字面量：道语言用 空 表示 None，这里给出契约中的 无 别名。
定义 无 = 空

// 已登记规则的共享表。元素形如：
// {"名称": 文本, "优先级": 数值, "条件": 标签文本, "处理器": 函数}
定义 规则表 = []

// 注解函数：拦截参数由解释器以 标注规则(处理器, 名称=..., 优先级=..., 条件=...)
// 的形式传入；登记后必须返回原处理器，否则被装饰函数会丢失。
函数 标注规则(处理器, 名称="", 优先级=0, 条件="")
    追加(规则表, {"名称": 名称, "优先级": 优先级, "条件": 条件, "处理器": 处理器})
    返回 处理器

// 查询知识库中该对象命中的正谓词标签集合。
// 查询结果字典的键带 ? 前缀，故取值用 解["?标签"]。
函数 命中标签(对象, 知识库)
    定义 标签列表 = []
    对于 解 在 查询(知识库, 风险(对象, ?标签))
        追加(标签列表, 解["?标签"])
    返回 标签列表

// 排序用的键函数：优先级数值大者先执行。
函数 取优先级(规则项)
    返回 规则项["优先级"]

// 按优先级降序取第一条命中的规则并执行其处理器。
// 无命中时严格返回 {"命中": 假, "规则名": "", "优先级": 0, "结果": 无}。
函数 判定(对象, 知识库)
    定义 标签列表 = 命中标签(对象, 知识库)
    定义 有序规则 = 排序(规则表, 键=取优先级, 降序=真)
    对于 规则项 在 有序规则
        如果 包含(标签列表, 规则项["条件"])
            定义 处理器 = 规则项["处理器"]
            定义 值 = 处理器(对象)
            返回 {"命中": 真, "规则名": 规则项["名称"],
                  "优先级": 规则项["优先级"], "结果": 值}
    返回 {"命中": 假, "规则名": "", "优先级": 0, "结果": 无}

// 与 判定 同理，但返回全部命中规则的结果列表（已按优先级降序）。
函数 全部判定(对象, 知识库)
    定义 标签列表 = 命中标签(对象, 知识库)
    定义 有序规则 = 排序(规则表, 键=取优先级, 降序=真)
    定义 结果 = []
    对于 规则项 在 有序规则
        如果 包含(标签列表, 规则项["条件"])
            定义 处理器 = 规则项["处理器"]
            追加(结果, {"命中": 真, "规则名": 规则项["名称"],
                        "优先级": 规则项["优先级"], "结果": 处理器(对象)})
    返回 结果

// 就地清空规则表，供测试隔离；保留引用，已导入的对象同样可见。
函数 清空规则()
    当 规则表.长度 > 0
        规则表.弹出()

导出 规则表, 标注规则, 判定, 全部判定, 清空规则
