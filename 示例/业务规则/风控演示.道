// 业务规则 DSL 演示：注解登记 + 逻辑知识库 + 动态事实
// 运行（需从本目录启动，模块搜索基于 cwd）：
//   cd 示例/业务规则 && python ../../源码/main.py 风控演示.道

从 规则引擎 导入 标注规则, 规则表, 判定, 全部判定

// 知识库由调用方创建：既有静态事实，也允许运行时动态注入。
// 规则体只用正谓词，阈值类判断请先在道语言侧算成标签事实。
逻辑 风控库
    事实: 风险("甲", "高风险")
    规则: 命中(?人, ?标签) 如果 风险(?人, ?标签)

// 四个带注解的处理器。优先级数值大者先执行。
@标注规则(名称="拦截", 优先级=100, 条件="高风险")
函数 拦截(对象)
    返回 "拦截:" + 对象

@标注规则(名称="人工复核", 优先级=50, 条件="高风险")
函数 人工复核(对象)
    返回 "复核:" + 对象

@标注规则(名称="限额放行", 优先级=10, 条件="低风险")
函数 限额放行(对象)
    返回 "放行:" + 对象

@标注规则(名称="白名单直达", 优先级=80, 条件="白名单")
函数 白名单直达(对象)
    返回 "白名单:" + 对象

打印("规则数:" + 文本(规则表.长度))
打印("场景1-高优先级命中:" + 文本(判定("甲", 风控库)))
打印("场景2-无命中:" + 文本(判定("陌生用户", 风控库)))

// 动态注入事实后重新判定：低风险命中低优先级规则。
添加事实(风控库, "风险", "陌生用户", "低风险")
打印("场景3-动态事实后重新判定:" + 文本(判定("陌生用户", 风控库)))

// 再注入高优先级标签，重新判定会改走白名单规则。
添加事实(风控库, "风险", "陌生用户", "白名单")
打印("场景3-再次改事实后重新判定:" + 文本(判定("陌生用户", 风控库)))

// 全部命中按优先级降序返回。
打印("全部命中:" + 文本(全部判定("甲", 风控库)))
