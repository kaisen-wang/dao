/// 道语言 × 本机 Ollama：gemma4:e4b 多轮对话（主示例）
///
/// 前置：本机已启动 ollama 服务，并已拉取 gemma4:e4b
///     ollama serve
///     ollama pull gemma4:e4b
/// 运行（仓库根目录下）：
///     源码/.venv/bin/python 源码/main.py 示例/AI对话/对话.道
/// 非交互（管道）示例：
///     printf '/帮助\n/退出\n' | 源码/.venv/bin/python 源码/main.py 示例/AI对话/对话.道
/// 可选环境变量：
///     OLLAMA_HOST   服务地址，默认 http://localhost:11434
///     OLLAMA_MODEL  模型名，默认 gemma4:e4b
///
/// 交互命令：/帮助 /清空 /历史 /模型 /思考 /退出
/// 也可直接输入 退出、quit、exit、:q 结束对话。

从 网络 导入 请求
从 编码 导入 JSON
从 系统 导入 取环境变量
从 文本 导入 去空格

定义 主机 = 取环境变量("OLLAMA_HOST", "http://localhost:11434")
定义 模型 = 取环境变量("OLLAMA_MODEL", "gemma4:e4b")
定义 系统提示 = "你是一个简洁、友善的中文助手，回答尽量简短。"
定义 地址 = 主机 + "/api/chat"

定义 历史 = []
定义 显示思考 = 假
定义 总轮数 = 0
定义 总生成 = 0

// 容错取字段：ollama 的统计字段在异常响应里可能缺失
函数 取字段(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

函数 打印帮助()
    打印("可用命令：")
    打印("  /帮助   显示本帮助")
    打印("  /清空   清空对话历史（保留系统提示）")
    打印("  /历史   查看当前历史条数与对话轮数")
    打印("  /模型   查看当前使用的模型与服务地址")
    打印("  /思考   开关 gemma4 思考过程的显示")
    打印("  /退出   结束对话（也可输入 退出 / quit / exit / :q）")

// 启动前探测 /api/tags，给出友好的环境提示
函数 检查环境(主机地址, 模型名)
    尝试
        定义 响应 = 请求(主机地址 + "/api/tags", {"超时": 5})
        如果 响应.状态码 != 200
            打印(`⚠️ ollama 返回状态码 {响应.状态码}`)
            返回 假
        定义 数据 = 响应.JSON()
        定义 找到 = 假
        遍历 项 在 数据["models"]
            如果 项["name"] == 模型名
                找到 = 真
        如果 找到
            返回 真
        否则
            打印(`⚠️ 本机未找到模型 {模型名}，请先运行：ollama pull {模型名}`)
            返回 假
    捕获 错误
        打印(`⚠️ 无法连接 ollama：{文本(错误)}`)
        打印("   请先运行：ollama serve")
        返回 假

// 发一次 /api/chat 请求。成功与失败都用字典返回，交给调用方处理。
函数 请求回答(接口地址, 模型名, 消息列表)
    定义 请求体 = {
        "model": 模型名,
        "messages": 消息列表,
        "stream": 假
    }
    定义 选项 = {
        "方法": "POST",
        "请求头": {"Content-Type": "application/json"},
        "数据": JSON.编码(请求体),
        "超时": 120
    }
    尝试
        定义 响应 = 请求(接口地址, 选项)
        如果 响应.状态码 != 200
            返回 {"成功": 假, "错误": `HTTP {响应.状态码}：{响应.响应体}`}
        返回 {"成功": 真, "结果": 响应.JSON()}
    捕获 错误
        返回 {"成功": 假, "错误": 文本(错误)}

打印("═" * 56)
打印("  道语言 × Ollama 本地对话 · gemma4:e4b")
打印("═" * 56)
定义 就绪 = 检查环境(主机, 模型)
如果 就绪
    打印(`模型 {模型} 已就绪。`)
否则
    打印("环境未就绪，仍可尝试提问；若失败请按上面的提示配置。")
追加(历史, {"role": "system", "content": 系统提示})
打印("输入 /帮助 查看命令，输入 /退出 结束对话。")
打印("")

当 真
    定义 行 = ""
    尝试
        行 = 去空格(输入("你："))
    捕获 错误
        打印("\n（输入结束，对话退出）")
        跳出

    如果 长度(行) == 0
        继续

    如果 行 == "/退出" 或者 行 == "退出" 或者 行 == "quit" 或者 行 == "exit" 或者 行 == ":q"
        跳出

    如果 行 == "/帮助"
        打印帮助()
        继续
    否则如果 行 == "/清空"
        历史 = []
        追加(历史, {"role": "system", "content": 系统提示})
        总轮数 = 0
        总生成 = 0
        打印("已清空对话历史。")
        继续
    否则如果 行 == "/历史"
        打印(`当前历史消息 {长度(历史)} 条，已完成 {总轮数} 轮对话，累计生成 {总生成} token。`)
        继续
    否则如果 行 == "/模型"
        打印(`当前模型：{模型}`)
        打印(`服务地址：{主机}`)
        继续
    否则如果 行 == "/思考"
        显示思考 = 不是 显示思考
        如果 显示思考
            打印("已开启思考过程显示。")
        否则
            打印("已关闭思考过程显示。")
        继续
    否则如果 行.开头是("/")
        打印(`未知命令：{行}，输入 /帮助 查看可用命令。`)
        继续

    追加(历史, {"role": "user", "content": 行})
    打印("助手：", 结尾="")

    定义 应答 = 请求回答(地址, 模型, 历史)
    如果 应答["成功"] == 假
        打印(`\n调用失败：{应答["错误"]}`)
        历史.弹出()
        继续

    定义 结果 = 应答["结果"]
    定义 消息 = 取字段(结果, "message", {})
    定义 回复 = 取字段(消息, "content", "")
    // gemma4 多轮对话：历史里只放最终回复，不要把 thinking 带进下一轮
    追加(历史, {"role": "assistant", "content": 回复})
    打印(回复)

    如果 显示思考
        定义 思考 = 取字段(消息, "thinking", "")
        如果 长度(思考) > 0
            打印(`\n[思考过程] {思考}`)

    总轮数 = 总轮数 + 1
    定义 本次生成 = 取字段(结果, "eval_count", 0)
    总生成 = 总生成 + 本次生成
    定义 耗时 = 整数(取字段(结果, "total_duration", 0) / 1000000000)
    打印(`\n[本次 {本次生成} token / {耗时} 秒]`)

打印("─" * 56)
打印(`对话结束：共 {总轮数} 轮，累计生成 {总生成} token。`)
