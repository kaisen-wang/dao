/// 道语言 × 本机 Ollama：大模型标准库接口层示例
///
/// 用新的「大模型」模块统一调用本地 ollama，演示三件事：
///   1. 单次对话    2. 流式对话（含思考过程）    3. 列出模型
/// 与 单次问答.道 / 流式对话.道 相比，这里不再手写 HTTP 请求与 NDJSON 解析：
/// 由「大模型」模块负责构造请求、把响应转成中文键字典、并累积流式内容。
///
/// 前置：本机已启动 ollama 服务，并已拉取 gemma4:e4b
///     ollama serve
///     ollama pull gemma4:e4b
/// 运行（仓库根目录下）：
///     源码/.venv/bin/python 源码/main.py 示例/AI对话/接口层示例.道
/// 可选环境变量：
///     OLLAMA_HOST   服务地址，默认 http://localhost:11434
///     OLLAMA_MODEL  模型名，默认 gemma4:e4b

从 大模型 导入 消息, 创建客户端, 对话, 流式对话, 列出模型
从 系统 导入 取环境变量

定义 主机 = 取环境变量("OLLAMA_HOST", "http://localhost:11434")
定义 模型 = 取环境变量("OLLAMA_MODEL", "gemma4:e4b")

// 配置字典的键直接传给 provider（ollama 使用 host / model / timeout）
定义 配置 = {"host": 主机, "model": 模型, "timeout": 120}
定义 客户端 = 创建客户端("ollama", 配置)

// 容错取字段：响应失败时是字典，成功时部分字段可能缺省
函数 取字段(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

打印("═" * 56)
打印("  道语言 × 大模型模块 · " + 模型)
打印("═" * 56)

// ── 1. 单次对话 ──────────────────────────────
打印("\n【1】单次对话")
定义 问题 = "用一句话说说你对「道」的理解。"
定义 回答 = 对话(客户端, [消息("user", 问题)], {"模型": 模型})
如果 回答["成功"]
    打印(`问题：{问题}`)
    打印(`模型：{回答["模型"]}`)
    打印("─" * 40)
    打印(回答["内容"])
    打印(`生成 token：{回答["用量"]["生成token"]}`)
否则
    打印(`对话失败：{回答["错误"]}`)

// ── 2. 流式对话 ──────────────────────────────
打印("\n【2】流式对话（逐块打印，含思考过程）")
定义 收集 = {"片段": [], "思考片段": [], "块数": 0}

// 回调收到中文键块字典 {"内容", "思考", "完成"}；
// 返回「假」可提前终止流，这里恒返回「真」读完整段。
函数 收到块(块)
    收集["块数"] = 收集["块数"] + 1
    如果 长度(块["思考"]) > 0
        追加(收集["思考片段"], 块["思考"])
        打印(块["思考"], 结尾="", 刷新=真)
    如果 长度(块["内容"]) > 0
        追加(收集["片段"], 块["内容"])
        打印(块["内容"], 结尾="", 刷新=真)
    返回 真

定义 流式回答 = 流式对话(客户端, [消息("user", "写一首关于道的简短三行诗。")], 收到块, {"模型": 模型})
打印("")  // 换行，结束打字机效果
如果 流式回答["成功"]
    打印(`共收到 {收集["块数"]} 个块`)
    打印(`完整内容：{流式回答["内容"]}`)
否则
    打印(`流式对话失败：{流式回答["错误"]}`)

// ── 3. 列出模型 ──────────────────────────────
打印("\n【3】列出模型")
定义 模型列表 = 列出模型(客户端)
如果 取字段(模型列表, "成功", 真) == 假
    打印(`列出模型失败：{取字段(模型列表, "错误", "未知错误")}`)
否则
    打印(`本机 ollama 可用模型（{主机}）：`)
    遍历 名称 在 模型列表
        打印(`  - {名称}`)
    如果 长度(模型列表) == 0
        打印("  （无，请先执行 ollama pull gemma4:e4b）")
