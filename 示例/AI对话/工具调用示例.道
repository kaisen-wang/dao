/// 道语言 × 大模型标准库：工具调用（Function Calling / Tool Use）示例
///
/// 演示完整链路：工具定义 → 创建客户端 → 工具对话 → 自动执行工具回调 → 打印工具调用记录。
/// 「工具对话」内部自动多轮：模型请求工具 → 回调执行 → 结果作为 tool 消息回填 →
/// 再请求，直到模型不再调用工具或达到「最大轮次」（默认 5）。
///
/// 前置（可选）：本机已启动 ollama 并拉取支持工具调用的模型
///     ollama serve
///     ollama pull gemma4:e4b
/// 运行（仓库根目录下）：
///     源码/.venv/bin/python 源码/main.py 示例/AI对话/工具调用示例.道
/// 可选环境变量：
///     OLLAMA_HOST   服务地址，默认 http://localhost:11434
///     OLLAMA_MODEL  模型名，默认 gemma4:e4b
/// 无 ollama、后端不支持工具调用或调用失败时：工具对话 返回「成功":假」字典，
/// 本例打印降级信息后正常结束，不抛异常。

从 大模型 导入 消息, 创建客户端, 工具定义, 工具对话
从 系统 导入 取环境变量

定义 主机 = 取环境变量("OLLAMA_HOST", "http://localhost:11434")
定义 模型 = 取环境变量("OLLAMA_MODEL", "gemma4:e4b")

// ── 1. 定义工具：参数模式支持中文键「属性 / 必填 / 类型 / 描述」 ──
定义 查天气 = 工具定义("查天气", "查询指定城市今天的天气情况", {
    "属性": {"城市": {"类型": "string", "描述": "城市名"}},
    "必填": ["城市"]
})
定义 加法 = 工具定义("加法", "计算两个整数的和", {
    "属性": {
        "甲": {"类型": "integer", "描述": "第一个整数"},
        "乙": {"类型": "integer", "描述": "第二个整数"}
    },
    "必填": ["甲", "乙"]
})
定义 工具列表 = [查天气, 加法]

// ── 2. 工具回调：固定收 2 个参数（名称、参数字典），返回结果文本 ──
函数 执行工具(名称, 参数)
    如果 名称 == "查天气"
        定义 城市 = 参数["城市"]
        返回 `城市「{城市}」今天晴，26℃。`
    如果 名称 == "加法"
        定义 和 = 参数["甲"] + 参数["乙"]
        返回 `两数之和是 {和}。`
    返回 `未知工具：{名称}`

// ── 3. 创建客户端并发起工具对话 ──
定义 配置 = {"host": 主机, "model": 模型, "timeout": 120}
定义 客户端 = 创建客户端("ollama", 配置)

打印("═" * 56)
打印("  道语言 × 工具调用协议（" + 模型 + "）")
打印("═" * 56)
打印(`已声明工具 {长度(工具列表)} 个：查天气、加法`)

定义 提问 = "北京今天天气怎么样？顺便帮我算一下 12 加 30。"
定义 应答 = 工具对话(客户端, [消息("user", 提问)], 工具列表, 执行工具, {"模型": 模型, "最大轮次": 5})

// ── 4. 打印结果：失败时走降级分支，不中断 ──
如果 应答["成功"]
    打印("\n【最终答复】")
    如果 长度(应答["内容"]) > 0
        打印(应答["内容"])
    否则
        打印("（模型未给出文字总结，工具执行结果见下方调用记录）")
    定义 成功记录 = 应答["工具调用记录"]
    打印(`\n【工具调用记录】共 {长度(成功记录)} 次`)
    遍历 一条 在 成功记录
        打印("  - 工具：" + 一条["名称"])
        打印("    参数：", 一条["参数"])
        打印("    结果：" + 一条["结果"])
    打印(`\n用量：提示 {应答["用量"]["提示token"]} / 生成 {应答["用量"]["生成token"]} / 共 {应答["用量"]["总token"]} token`)
    打印(`轮次：{应答["轮次"]}`)
否则
    打印("\n【降级】本次工具对话未成功，示例优雅退出：")
    打印("  原因：" + 应答["错误"])
    定义 降级记录 = 应答["工具调用记录"]
    如果 长度(降级记录) > 0
        打印(`  已完成 {长度(降级记录)} 次工具调用：`)
        遍历 一条 在 降级记录
            打印("    - " + 一条["名称"] + " → " + 一条["结果"])
    打印("  提示：启动 ollama 并使用支持工具调用的模型后可重试。")
