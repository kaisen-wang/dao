/// 道语言 × 本机 Ollama：流式输出（打字机效果）
///
/// 与 对话.道 的区别：请求体改成 "stream": 真，服务端每生成一小段就返回
/// 一行 NDJSON；示例用「流式请求」逐行回调，边收边打印，不必等整段回答生成完。
///
/// 前置：本机 ollama 已启动，且已拉取 gemma4:e4b
/// 运行（仓库根目录下）：
///     源码/.venv/bin/python 源码/main.py 示例/AI对话/流式对话.道
/// 管道方式：
///     printf '用一句话介绍道语言\n/退出\n' | 源码/.venv/bin/python 源码/main.py 示例/AI对话/流式对话.道
/// 可选环境变量：OLLAMA_HOST（默认 http://localhost:11434）、OLLAMA_MODEL（默认 gemma4:e4b）
///
/// 命令：/帮助 /清空 /模型 /思考 /退出；也可直接输入 退出 / quit / exit。

从 网络 导入 流式请求
从 编码 导入 JSON
从 文本 导入 连接, 去空格
从 系统 导入 取环境变量

定义 主机 = 取环境变量("OLLAMA_HOST", "http://localhost:11434")
定义 模型 = 取环境变量("OLLAMA_MODEL", "gemma4:e4b")
定义 地址 = 主机 + "/api/chat"
定义 系统提示 = "你是一个简洁、友善的中文助手，回答尽量简短。"

定义 历史 = []
定义 总轮数 = 0
定义 总生成 = 0

// 回调是独立函数，用同一个字典共享本轮状态；
// 修改字典元素不依赖「函数内重新赋值外层变量」，更稳妥。
定义 状态 = {
    "片段": [], "思考片段": [], "token": 0, "耗时": 0,
    "完成": 假, "显示思考": 真, "已提示思考": 假, "已提示回答": 假
}

函数 取字段(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

函数 重置状态()
    状态["片段"] = []
    状态["思考片段"] = []
    状态["token"] = 0
    状态["耗时"] = 0
    状态["完成"] = 假
    状态["已提示思考"] = 假
    状态["已提示回答"] = 假

// 每读到一行 NDJSON 就调用一次。
// 返回「假」可让流式请求提前结束；这里恒返回真，读完整个流。
函数 处理数据块(行)
    定义 块 = {}
    尝试
        块 = JSON.解码(行)
    捕获 错误
        // 忽略非 JSON 行（如 SSE 的 data 前缀或心跳行）
        返回 真

    定义 消息 = 取字段(块, "message", {})

    // gemma4 的 thinking 也是逐块流式返回的，默认显示，
    // 否则用户会在回答开始前盯着一片空白，误以为卡住。
    定义 思考 = 取字段(消息, "thinking", "")
    如果 长度(思考) > 0
        追加(状态["思考片段"], 思考)
        如果 状态["显示思考"] == 真
            如果 状态["已提示思考"] == 假
                打印("\n  〔思考〕", 结尾="", 刷新=真)
                状态["已提示思考"] = 真
            打印(思考, 结尾="", 刷新=真)

    定义 片段 = 取字段(消息, "content", "")
    如果 长度(片段) > 0
        追加(状态["片段"], 片段)
        如果 状态["已提示回答"] == 假
            打印("\n  〔回答〕", 结尾="", 刷新=真)
            状态["已提示回答"] = 真
        // 关键：结尾为空并刷新，形成打字机效果
        打印(片段, 结尾="", 刷新=真)

    如果 取字段(块, "done", 假) == 真
        状态["token"] = 取字段(块, "eval_count", 0)
        状态["耗时"] = 整数(取字段(块, "total_duration", 0) / 1000000000)
        状态["完成"] = 真
    返回 真

打印("═" * 56)
打印("  道语言 × Ollama 流式对话 · gemma4:e4b")
打印("═" * 56)
追加(历史, {"role": "system", "content": 系统提示})
打印("输入 /帮助 查看命令，输入 /退出 结束对话。")
打印("")

当 真
    定义 行 = ""
    尝试
        行 = 去空格(输入("你："))
    捕获 错误
        打印("\n（输入结束，对话退出）")
        跳出
    如果 长度(行) == 0
        继续
    如果 行 == "/退出" 或者 行 == "退出" 或者 行 == "quit" 或者 行 == "exit"
        跳出

    如果 行 == "/帮助"
        打印("  /清空 清空历史  /模型 查看模型  /思考 开关思考过程  /退出 结束")
        继续
    否则如果 行 == "/清空"
        历史 = []
        追加(历史, {"role": "system", "content": 系统提示})
        总轮数 = 0
        总生成 = 0
        打印("已清空对话历史。")
        继续
    否则如果 行 == "/模型"
        打印(`当前模型：{模型}  服务：{主机}`)
        继续
    否则如果 行 == "/思考"
        状态["显示思考"] = 不是 状态["显示思考"]
        如果 状态["显示思考"] == 真
            打印("已开启思考过程显示。")
        否则
            打印("已关闭思考过程显示。")
        继续
    否则如果 行.开头是("/")
        打印(`未知命令：{行}`)
        继续

    追加(历史, {"role": "user", "content": 行})
    重置状态()

    定义 请求体 = {
        "model": 模型,
        "messages": 历史,
        "stream": 真
    }
    定义 选项 = {
        "方法": "POST",
        "请求头": {"Content-Type": "application/json"},
        "数据": JSON.编码(请求体),
        "超时": 120
    }

    打印("助手（流式）：", 结尾="", 刷新=真)
    定义 块数 = 0
    尝试
        块数 = 流式请求(地址, 选项, 处理数据块)
        打印("")
    捕获 错误
        打印(`\n流式请求失败：{文本(错误)}`)
        打印("请确认已运行 ollama serve，且模型已拉取：ollama pull gemma4:e4b")
        历史.弹出()
        继续

    // 多轮历史里只放最终回答，不带 thinking（Gemma 4 官方建议）
    定义 全文 = 连接(状态["片段"], "")
    追加(历史, {"role": "assistant", "content": 全文})
    总轮数 = 总轮数 + 1
    总生成 = 总生成 + 状态["token"]
    打印(`  〔本轮 {块数} 块 / {状态["token"]} token / {状态["耗时"]} 秒〕`)

打印("─" * 56)
打印(`对话结束：共 {总轮数} 轮，累计生成 {总生成} token。`)
