// 更夫 Nightwatch — 准入矩阵与白名单
// 对应 PRD《常驻研发协作 Agent》FR-02：机器人单列、白名单显式请求、CI/普通评论候选、其余忽略。
// 本模块只依赖共享契约 领域.道 的准入常量，不修改任何契约内容。

从 核心.领域 导入 准入显式, 准入候选, 准入忽略, 准入机器人
从 文本 导入 去空格, 正则匹配

// 明确请求词：白名单用户内容中命中任一，即视为显式请求。
定义 请求词 = ["@更夫", "请修复", "帮我处理", "开工单", "请处理", "请帮忙"]

// 已知噪音短语：整条消息仅为这些短语时直接视为噪音。
定义 噪音短语 = ["收到", "谢谢", "+1", "已阅", "好的", "OK", "ok", "666", "收到谢谢", "get"]

// 判断文本是否含任一明确请求词。
函数 含明确请求(文本)
    遍历 词 在 请求词
        如果 包含(文本, 词)
            返回 真
    返回 假

// 空内容、纯标点、纯表情、已知噪音短语均返回真。
导出 函数 是噪音(文本)
    如果 文本 == 空
        返回 真
    定义 净文本 = 去空格(文本)
    如果 净文本 == ""
        返回 真
    如果 净文本 在 噪音短语
        返回 真
    定义 匹配结果 = 正则匹配(净文本, """^[^\w\s]+$""")
    如果 长度(匹配结果) > 0
        返回 真
    返回 假

// 准入器：持有白名单，对触发逐条判定并写回 触.准入。
类型 准入器
    初始化(白名单列表)
        本对象.名单 = []
        遍历 名 在 白名单列表
            追加(本对象.名单, 名)

    函数 判定(触)
        定义 结论 = 准入忽略
        如果 触.是否机器人
            结论 = 准入机器人
        否则 如果 是噪音(触.内容)
            结论 = 准入忽略
        否则
            定义 是白名单 = 触.发起人 在 本对象.名单
            如果 是白名单 并且 含明确请求(触.内容)
                结论 = 准入显式
            否则
                结论 = 准入候选
        触.准入 = 结论
        返回 结论

    函数 加白(用户名)
        如果 用户名 不在 本对象.名单
            追加(本对象.名单, 用户名)

    函数 移除白(用户名)
        定义 剩余 = []
        遍历 名 在 本对象.名单
            如果 名 != 用户名
                追加(剩余, 名)
        本对象.名单 = 剩余

    函数 白名单()
        返回 本对象.名单

// 工厂：由白名单列表构造准入器。
导出 函数 创建准入器(白名单列表)
    返回 准入器(白名单列表)
