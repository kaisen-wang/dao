// 更夫 Nightwatch — 语义评估（Eval）
// 对应 PRD《常驻研发协作 Agent》FR-03/FR-04：模式关闭只记不执行，规则命中给出 would_accept 决策。
// 本模块只产出 领域.道 的决策对象，不修改共享契约。

从 核心.领域 导入 决策, 模式关闭

// 评估器：按规则列表与策略版本对触发逐条评估。
类型 评估器
    初始化(规则列表, 策略版本)
        本对象.规则表 = []
        遍历 条规则 在 规则列表
            追加(本对象.规则表, 条规则)
        本对象.策略版本 = 策略版本

    函数 评估(触, 模式)
        定义 编号 = 触.去重键()
        如果 模式 == 模式关闭
            返回 决策(编号, "would_ignore", "执行模式关闭", 本对象.策略版本)

        定义 命中名称 = ""
        定义 命中结论 = ""
        遍历 条规则 在 本对象.规则表
            如果 命中名称 == ""
                定义 词命中 = 假
                遍历 词 在 条规则["关键词"]
                    如果 包含(触.内容, 词)
                        词命中 = 真

                定义 范围列表 = []
                如果 包含(条规则, "范围")
                    范围列表 = 条规则["范围"]
                定义 范围命中 = 假
                如果 长度(范围列表) == 0
                    范围命中 = 真
                否则 如果 触.来源 在 范围列表
                    范围命中 = 真

                如果 词命中 并且 范围命中
                    命中名称 = 条规则["名称"]
                    命中结论 = "would_accept"
                    如果 包含(条规则, "结论")
                        定义 候选结论 = 条规则["结论"]
                        如果 候选结论 != 空 并且 候选结论 != ""
                            命中结论 = 候选结论

        如果 命中名称 != ""
            定义 命中理由 = `命中规则「{命中名称}」，来源 {触.来源}，采纳结论 {命中结论}。`
            返回 决策(编号, 命中结论, 命中理由, 本对象.策略版本)

        定义 忽略理由 = `来源 {触.来源} 未命中任何规则，仅做记录，不进入执行。`
        返回 决策(编号, "would_ignore", 忽略理由, 本对象.策略版本)

    函数 版本()
        返回 本对象.策略版本

// 工厂：由规则列表与策略版本构造评估器。
导出 函数 创建评估器(规则列表, 策略版本="v0.1")
    返回 评估器(规则列表, 策略版本)

// 按触发列表顺序逐条评估（同 Thread 串行），返回决策列表。
导出 函数 串行评估(评估器, 触发列表, 模式)
    定义 结果 = []
    遍历 触 在 触发列表
        追加(结果, 评估器.评估(触, 模式))
    返回 结果
