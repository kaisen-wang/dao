// 更夫 Nightwatch — SQLite 持久化层
// 对应 PRD《常驻研发协作 Agent》FR-11（Outbox 幂等）与 FR-13（持久化恢复）。
// 职责：建表、领域对象与数据库行的互转、工单/触发/报告/决策/授权/outbox/绑定的读写。
// 所有 SQL 一律使用 ? 占位符与列表参数绑定，禁止拼接 SQL 字符串。

从 数据库 导入 连接
从 编码 导入 JSON
从 核心.领域 导入 工单, 触发, 报告, 决策, 授权, 执行绑定

// 模块级连接：首次导入时为空，打开存储() 时赋值为真实连接。
定义 存储连接 = 空

// ======================== 内部辅助 ========================

// 取当前连接；供本模块与恢复模块使用。
导出 函数 取连接()
    返回 存储连接

// 文本列为空时解码为列表，避免 JSON.解码 收到空值。
函数 解码列表(文本值)
    如果 文本值 == 空 或者 文本值 == ""
        返回 []
    返回 JSON.解码(文本值)

// 授权对象 → 可 JSON 编码的字典文本。
函数 授权转文本(授)
    定义 数据 = {
        "工单编号": 授.工单编号,
        "授权人": 授.授权人,
        "策略版本": 授.策略版本,
        "范围": 授.范围,
        "创建时间": 授.创建时间
    }
    返回 JSON.编码(数据)

// 字典 → 授权对象；构造后再覆盖自动生成的字段。
函数 字典转授权(数据)
    定义 授 = 授权(数据["工单编号"], 数据["授权人"], 数据["策略版本"], 数据["范围"])
    授.创建时间 = 数据["创建时间"]
    返回 授

// 绑定对象 → 可 JSON 编码的字典文本。
函数 绑定转文本(绑)
    定义 数据 = {
        "编号": 绑.编号,
        "工单编号": 绑.工单编号,
        "执行者": 绑.执行者,
        "槽位": 绑.槽位,
        "状态": 绑.状态,
        "开始时间": 绑.开始时间
    }
    返回 JSON.编码(数据)

// 字典 → 绑定对象；编号/状态/开始时间都是构造函数自动生成的，需显式还原。
函数 字典转绑定(数据)
    定义 绑 = 执行绑定(数据["工单编号"], 数据["执行者"], 数据["槽位"])
    绑.编号 = 数据["编号"]
    绑.状态 = 数据["状态"]
    绑.开始时间 = 数据["开始时间"]
    返回 绑

// 数据库行 → 工单对象。
函数 行转工单(行)
    定义 单 = 工单(行["编号"], 行["标题"], 行["来源"], 行["外部编号"], 行["发起人"], 行["内容"], 行["模式"], 行["策略版本"])
    单.阶段 = 行["阶段"]
    单.准入 = 行["准入"]
    单.未交付输入 = 解码列表(行["未交付输入"])
    单.创建时间 = 行["创建时间"]
    单.结束原因 = 行["结束原因"]
    如果 行["授权"] != 空 并且 行["授权"] != ""
        单.授权 = 字典转授权(JSON.解码(行["授权"]))
    如果 行["绑定"] != 空 并且 行["绑定"] != ""
        单.绑定 = 字典转绑定(JSON.解码(行["绑定"]))
    返回 单

// 授权写入授权表；供 保存授权 与 保存工单 共用。
函数 写授权(授)
    定义 范围文本 = JSON.编码(授.范围)
    存储连接.执行("INSERT OR REPLACE INTO 授权 (工单编号, 授权人, 策略版本, 范围, 创建时间) VALUES (?, ?, ?, ?, ?)", [授.工单编号, 授.授权人, 授.策略版本, 范围文本, 授.创建时间])
    存储连接.提交()

// 绑定写入绑定表；恢复检查点以本表为状态基准。
函数 写绑定(绑)
    存储连接.执行("INSERT OR REPLACE INTO 绑定 (编号, 工单编号, 执行者, 槽位, 状态, 开始时间) VALUES (?, ?, ?, ?, ?, ?)", [绑.编号, 绑.工单编号, 绑.执行者, 绑.槽位, 绑.状态, 绑.开始时间])
    存储连接.提交()

// ======================== 5.1 导出接口 ========================

// 打开（或新建）数据库、建表、开启 WAL，并把连接保存到模块级变量。
导出 函数 打开存储(路径="更夫.db")
    定义 新连接 = 连接(路径)
    新连接.执行("CREATE TABLE IF NOT EXISTS 工单 (编号 TEXT PRIMARY KEY, 标题 TEXT, 来源 TEXT, 外部编号 TEXT, 发起人 TEXT, 内容 TEXT, 阶段 TEXT, 模式 TEXT, 策略版本 TEXT, 准入 TEXT, 授权 TEXT, 绑定 TEXT, 未交付输入 TEXT, 创建时间 INTEGER, 结束原因 TEXT)")
    新连接.执行("CREATE TABLE IF NOT EXISTS 触发 (去重键 TEXT PRIMARY KEY, 来源 TEXT, 外部编号 TEXT, 话题编号 TEXT, 发起人 TEXT, 内容 TEXT, 是否机器人 INTEGER, 是否CI INTEGER, 准入 TEXT, 策略版本 TEXT, 时间 INTEGER)")
    新连接.执行("CREATE TABLE IF NOT EXISTS 报告 (id INTEGER PRIMARY KEY AUTOINCREMENT, 工单编号 TEXT, 类型 TEXT, 消息 TEXT, 数据 TEXT, 时间 INTEGER)")
    新连接.执行("CREATE TABLE IF NOT EXISTS 决策 (id INTEGER PRIMARY KEY AUTOINCREMENT, 触发编号 TEXT, 结论 TEXT, 理由 TEXT, 策略版本 TEXT, 时间 INTEGER)")
    新连接.执行("CREATE TABLE IF NOT EXISTS 授权 (工单编号 TEXT PRIMARY KEY, 授权人 TEXT, 策略版本 TEXT, 范围 TEXT, 创建时间 INTEGER)")
    新连接.执行("CREATE TABLE IF NOT EXISTS 绑定 (编号 TEXT PRIMARY KEY, 工单编号 TEXT, 执行者 TEXT, 槽位 INTEGER, 状态 TEXT, 开始时间 INTEGER)")
    新连接.执行("CREATE TABLE IF NOT EXISTS outbox (id INTEGER PRIMARY KEY AUTOINCREMENT, 工单编号 TEXT, 类型 TEXT, 内容 TEXT, 幂等键 TEXT, 状态 TEXT, 时间 INTEGER)")
    新连接.执行("CREATE INDEX IF NOT EXISTS idx_outbox_幂等键 ON outbox (幂等键)")
    新连接.提交()
    尝试
        新连接.开启WAL()
    捕获 错误
        定义 忽略 = 错误
    存储连接 = 新连接
    返回 存储连接

// 新增或替换一个工单；同时持久化其授权与绑定。
导出 函数 保存工单(单)
    尝试
        定义 授权文本 = ""
        定义 绑定文本 = ""
        如果 单.授权 != 空
            授权文本 = 授权转文本(单.授权)
        如果 单.绑定 != 空
            绑定文本 = 绑定转文本(单.绑定)
        定义 输入文本 = JSON.编码(单.未交付输入)
        存储连接.执行("INSERT OR REPLACE INTO 工单 (编号, 标题, 来源, 外部编号, 发起人, 内容, 阶段, 模式, 策略版本, 准入, 授权, 绑定, 未交付输入, 创建时间, 结束原因) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", [单.编号, 单.标题, 单.来源, 单.外部编号, 单.发起人, 单.内容, 单.阶段, 单.模式, 单.策略版本, 单.准入, 授权文本, 绑定文本, 输入文本, 单.创建时间, 单.结束原因])
        如果 单.授权 != 空
            写授权(单.授权)
        如果 单.绑定 != 空
            写绑定(单.绑定)
        存储连接.提交()
        返回 真
    捕获 错误
        定义 忽略 = 错误
        返回 假

// 按编号读取工单，不存在返回空。
导出 函数 读取工单(编号)
    定义 行 = 存储连接.查询一个("SELECT * FROM 工单 WHERE 编号 = ?", [编号])
    如果 行 == 空
        返回 空
    返回 行转工单(行)

// 列出全部工单。
导出 函数 列出工单()
    定义 行列表 = 存储连接.查询("SELECT * FROM 工单", [])
    定义 结果 = []
    遍历 行 在 行列表
        追加(结果, 行转工单(行))
    返回 结果

// 按去重键幂等保存触发：新事件返回真，重复返回假。
导出 函数 保存触发(触)
    定义 键 = 触.去重键()
    定义 行数 = 存储连接.执行("INSERT OR IGNORE INTO 触发 (去重键, 来源, 外部编号, 话题编号, 发起人, 内容, 是否机器人, 是否CI, 准入, 策略版本, 时间) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", [键, 触.来源, 触.外部编号, 触.话题编号, 触.发起人, 触.内容, 触.是否机器人, 触.是否CI, 触.准入, 触.策略版本, 触.时间])
    存储连接.提交()
    如果 行数 > 0
        返回 真
    返回 假

// 列出全部触发，按插入顺序。
导出 函数 列出触发()
    定义 行列表 = 存储连接.查询("SELECT * FROM 触发 ORDER BY rowid", [])
    定义 结果 = []
    遍历 行 在 行列表
        定义 触 = 触发(行["来源"], 行["外部编号"], 行["话题编号"], 行["发起人"], 行["内容"], 行["是否机器人"] == 1, 行["是否CI"] == 1)
        触.准入 = 行["准入"]
        触.策略版本 = 行["策略版本"]
        触.时间 = 行["时间"]
        追加(结果, 触)
    返回 结果

// 保存一条报告。
导出 函数 保存报告(报)
    定义 数据文本 = JSON.编码(报.数据)
    存储连接.执行("INSERT INTO 报告 (工单编号, 类型, 消息, 数据, 时间) VALUES (?, ?, ?, ?, ?)", [报.工单编号, 报.类型, 报.消息, 数据文本, 报.时间])
    存储连接.提交()
    返回 真

// 列出某工单的全部报告，按时间顺序。
导出 函数 列出报告(工单编号)
    定义 行列表 = 存储连接.查询("SELECT * FROM 报告 WHERE 工单编号 = ? ORDER BY id", [工单编号])
    定义 结果 = []
    遍历 行 在 行列表
        定义 报 = 报告(行["工单编号"], 行["类型"], 行["消息"], JSON.解码(行["数据"]))
        报.时间 = 行["时间"]
        追加(结果, 报)
    返回 结果

// 保存一条决策。
导出 函数 保存决策(决)
    存储连接.执行("INSERT INTO 决策 (触发编号, 结论, 理由, 策略版本, 时间) VALUES (?, ?, ?, ?, ?)", [决.触发编号, 决.结论, 决.理由, 决.策略版本, 决.时间])
    存储连接.提交()
    返回 真

// 列出决策；给出话题编号时，只列出该话题下触发对应的决策。
导出 函数 列出决策(话题编号=空)
    定义 行列表 = []
    如果 话题编号 == 空
        行列表 = 存储连接.查询("SELECT * FROM 决策 ORDER BY id", [])
    否则
        定义 触行列表 = 存储连接.查询("SELECT 去重键 FROM 触发 WHERE 话题编号 = ?", [话题编号])
        遍历 触行 在 触行列表
            定义 匹配行 = 存储连接.查询("SELECT * FROM 决策 WHERE 触发编号 = ? ORDER BY id", [触行["去重键"]])
            遍历 决行 在 匹配行
                追加(行列表, 决行)
    定义 结果 = []
    遍历 行 在 行列表
        定义 决 = 决策(行["触发编号"], 行["结论"], 行["理由"], 行["策略版本"])
        决.时间 = 行["时间"]
        追加(结果, 决)
    返回 结果

// 保存授权（不可变记录，只有 INSERT OR REPLACE，无更新语义）。
导出 函数 保存授权(授)
    写授权(授)
    返回 真

// 按工单编号读取授权，不存在返回空。
导出 函数 读取授权(工单编号)
    定义 行 = 存储连接.查询一个("SELECT * FROM 授权 WHERE 工单编号 = ?", [工单编号])
    如果 行 == 空
        返回 空
    定义 数据 = {
        "工单编号": 行["工单编号"],
        "授权人": 行["授权人"],
        "策略版本": 行["策略版本"],
        "范围": 解码列表(行["范围"]),
        "创建时间": 行["创建时间"]
    }
    返回 字典转授权(数据)

// outbox 入队；幂等键非空且已存在时返回原投递ID。
导出 函数 投递入队(工单编号, 类型, 内容, 幂等键="")
    如果 幂等键 != ""
        定义 已有 = 存储连接.查询一个("SELECT id FROM outbox WHERE 幂等键 = ?", [幂等键])
        如果 已有 != 空
            返回 已有["id"]
    存储连接.执行("INSERT INTO outbox (工单编号, 类型, 内容, 幂等键, 状态, 时间) VALUES (?, ?, ?, ?, ?, ?)", [工单编号, 类型, 内容, 幂等键, "pending", 时间戳()])
    存储连接.提交()
    返回 存储连接.最后行ID()

// 待投递列表：状态为 pending 的字典行。
导出 函数 待投递列表()
    返回 存储连接.查询("SELECT * FROM outbox WHERE 状态 = ? ORDER BY id", ["pending"])

// 标记一条投递为已发送。
导出 函数 标记投递(投递ID)
    存储连接.执行("UPDATE outbox SET 状态 = ? WHERE id = ?", ["sent", 投递ID])
    存储连接.提交()
    返回 真

// 统计各表记录数。
导出 函数 统计()
    定义 结果 = {}
    结果["工单"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM 工单")["数量"]
    结果["触发"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM 触发")["数量"]
    结果["报告"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM 报告")["数量"]
    结果["决策"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM 决策")["数量"]
    结果["授权"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM 授权")["数量"]
    结果["绑定"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM 绑定")["数量"]
    结果["outbox"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM outbox")["数量"]
    结果["待投递"] = 存储连接.查询一个("SELECT COUNT(*) AS 数量 FROM outbox WHERE 状态 = ?", ["pending"])["数量"]
    返回 结果
