// 更夫 Nightwatch — Web 看板骨架与审计流
// 对应 PRD《常驻研发协作 Agent》FR-14（Web 面板）与 FR-16（Watchdog 巡检展示）。
// 本模块手写一个轻量 HTTP 看板：工单按阶段分组、决策审计流、全局暂停开关。
// 只产出简单 UTF-8 文本 HTML，不引入模板引擎，不依赖 GitHub 相关部分。

从 核心.领域 导入 阶段排队, 阶段执行中, 阶段等事件, 阶段待审核, 阶段受阻, 阶段失败, 阶段结束

// ======================== 渲染辅助（具名函数，避开匿名函数单行限制） ========================

// 过滤出指定阶段的工单列表。
函数 分组工单(工单列表, 阶段值)
    定义 结果 = []
    遍历 单 在 工单列表
        如果 单.阶段 == 阶段值
            追加(结果, 单)
    返回 结果

// 把一个阶段渲染成一段 HTML：中文标题、数量、工单描述列表。
函数 渲染阶段(工单列表, 阶段值, 标题)
    定义 组内 = 分组工单(工单列表, 阶段值)
    定义 数量 = 长度(组内)
    定义 片段 = `<h2>{标题}（{数量}）</h2>`
    如果 数量 > 0
        定义 列表HTML = ""
        遍历 单 在 组内
            定义 一行 = 单.描述()
            定义 条目 = `<li>{一行}</li>`
            列表HTML = 列表HTML + 条目
        片段 = 片段 + `<ul>` + 列表HTML + `</ul>`
    返回 片段

// 首页：展示当前模式、暂停状态，以及七个阶段的工单分组。
函数 渲染首页(工单列表, 状态字典)
    定义 模式 = 状态字典["模式"]
    定义 暂停中 = 状态字典["暂停中"]
    定义 暂停文本 = "运行中"
    如果 暂停中
        暂停文本 = "已暂停"
    定义 头部 = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>更夫看板</title></head><body>`
    定义 标题段 = `<h1>更夫 Nightwatch 看板</h1><p>当前模式：{模式}　暂停状态：{暂停文本}</p>`
    定义 正文 = ""
    正文 = 正文 + 渲染阶段(工单列表, 阶段排队, "排队")
    正文 = 正文 + 渲染阶段(工单列表, 阶段执行中, "执行中")
    正文 = 正文 + 渲染阶段(工单列表, 阶段等事件, "等事件")
    正文 = 正文 + 渲染阶段(工单列表, 阶段待审核, "待审核")
    正文 = 正文 + 渲染阶段(工单列表, 阶段受阻, "受阻")
    正文 = 正文 + 渲染阶段(工单列表, 阶段失败, "失败")
    正文 = 正文 + 渲染阶段(工单列表, 阶段结束, "结束")
    定义 尾部 = `<hr><a href="/审计">查看审计流</a></body></html>`
    返回 头部 + 标题段 + 正文 + 尾部

// 审计页：逐条显示决策描述，提供中文表头。
函数 渲染审计页(决策列表)
    定义 头部 = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>观察审计流</title></head><body>`
    定义 表头 = `<h1>观察候选审计流</h1><table border="1"><tr><th>序号</th><th>决策描述</th></tr>`
    定义 行集 = ""
    定义 序号 = 0
    遍历 决 在 决策列表
        序号 = 序号 + 1
        定义 描述 = 决.描述()
        定义 单元 = `<tr><td>{序号}</td><td>{描述}</td></tr>`
        行集 = 行集 + 单元
    定义 尾部 = `</table><hr><a href="/">返回看板</a></body></html>`
    返回 头部 + 表头 + 行集 + 尾部

// ======================== 看板对象 ========================

类型 看板
    初始化(取工单函数, 取决策函数, 状态字典)
        本对象.取工单函数 = 取工单函数
        本对象.取决策函数 = 取决策函数
        本对象.状态字典 = 状态字典

    函数 首页()
        定义 工单列表 = 本对象.取工单函数()
        返回 渲染首页(工单列表, 本对象.状态字典)

    函数 审计页()
        定义 决策列表 = 本对象.取决策函数()
        返回 渲染审计页(决策列表)

    // 具名响应函数：在内部构造返回字典，供单行匿名路由回调调用。
    函数 首页响应(请求)
        返回 {"状态码": 200, "内容": 本对象.首页()}

    函数 审计响应(请求)
        返回 {"状态码": 200, "内容": 本对象.审计页()}

    // 注册路由：处理函数一律写成单行 函数(请求) => 表达式，复杂逻辑留在具名函数里。
    函数 注册(服务器)
        定义 自我 = 本对象
        服务器.路由("GET", "/", 函数(请求) => 自我.首页响应(请求))
        服务器.路由("GET", "/审计", 函数(请求) => 自我.审计响应(请求))
        服务器.路由("POST", "/暂停", 函数(请求) => 处理暂停(自我.状态字典, 请求))

// ======================== 导出接口 ========================

// 切换全局暂停布尔值，返回带中文提示的响应字典。
导出 函数 处理暂停(状态字典, 请求)
    定义 提示 = ""
    如果 状态字典["暂停中"]
        状态字典["暂停中"] = 假
        提示 = "已恢复运行，工单继续处理"
    否则
        状态字典["暂停中"] = 真
        提示 = "已全局暂停，工单暂停处理"
    返回 {"状态码": 200, "内容": 提示}

// 工厂：由取工单函数、取决策函数与状态字典构造看板对象。
导出 函数 创建看板(取工单函数, 取决策函数, 状态字典)
    返回 看板(取工单函数, 取决策函数, 状态字典)
