// 更夫 Nightwatch — 主入口与端到端演示
// 用道语言实现 PRD《常驻研发协作 Agent》的非 GitHub 部分。
// 演示四类流程：显式请求 / observe 候选审计 / 评审跟进 / 中断恢复。
// 运行方式：先 cd 到本目录，再 python3 ../../../源码/main.py 入口.道

从 核心.领域 导入 工单, 触发, 执行绑定, 话题, 新工单编号
从 核心.领域 导入 模式审计, 模式自动, 准入显式, 阶段执行中, 阶段待审核
从 核心.领域 导入 推导阶段
从 核心.存储 导入 打开存储, 保存工单, 读取工单, 列出工单, 保存触发
从 核心.存储 导入 保存报告, 列出报告, 保存决策, 列出决策, 保存授权
从 核心.存储 导入 投递入队, 标记投递, 统计
从 核心.恢复 导入 恢复检查点
从 核心.准入 导入 创建准入器
从 核心.授权 导入 授予, 校验, 拒绝扩权
从 核心.评估 导入 创建评估器, 串行评估
从 核心.调度 导入 创建调度器, 创建预算
从 调度 导入 等待全部
从 核心.执行 导入 执行工单, 生成报告序列, 运行异步工具
从 核心.看板 导入 创建看板, 处理暂停
从 密码 导入 SHA256

// ======================== 全局对象 ========================
定义 存储 = 打开存储(":memory:")
定义 准入器 = 创建准入器(["张三", "维护者"])
定义 调度器 = 创建调度器(2)
定义 预算 = 创建预算(80, 100000, 5.0, 0.01)
定义 状态 = {"暂停中": 假, "模式": 模式审计}

// 审计规则：命中后只记 would_accept，observe 模式下不改代码。
定义 审计规则 = [
    {"名称": "CI失败修复", "关键词": ["构建失败", "测试失败", "红灯"], "结论": "would_accept", "范围": ["本地CI"]},
    {"名称": "明确缺陷修复", "关键词": ["修复", "缺陷", "崩溃"], "结论": "would_accept", "范围": []}
]
定义 评估器 = 创建评估器(审计规则, "v0.1")

// ======================== 辅助函数 ========================

// 报告回调：落库并打印一行中文摘要。
函数 记录报告(报)
    保存报告(报)
    定义 摘要 = 报.描述()
    打印(`    [报告] {摘要}`)

// 异步工具完成回调：打印本地模拟结果。
函数 记录异步结果(结果)
    定义 命令名 = 结果["命令"]
    定义 状态文本 = 结果["状态"]
    打印(`    [异步工具] {命令名} {状态文本}`)

// 看板数据源包装。
函数 取工单()
    返回 列出工单()

函数 取决策()
    返回 列出决策()

// Watchdog 停滞巡检（FR-16）：执行中但已无运行中绑定的工单视为停滞。
函数 巡检停滞()
    定义 列表 = 列出工单()
    定义 停滞数 = 0
    遍历 单 在 列表
        如果 单.阶段 == 阶段执行中
            如果 单.绑定 == 空 或者 单.绑定.状态 != "running"
                停滞数 = 停滞数 + 1
    返回 停滞数

// 打印统计摘要。
函数 打印统计()
    定义 数据 = 统计()
    定义 工单数 = 数据["工单"]
    定义 触发数 = 数据["触发"]
    定义 报告数 = 数据["报告"]
    定义 决策数 = 数据["决策"]
    定义 outbox数 = 数据["outbox"]
    打印(`    工单={工单数} 触发={触发数} 报告={报告数} 决策={决策数} outbox={outbox数}`)

// ======================== 流程一：显式请求 ========================
函数 演示显式请求()
    打印("")
    打印("=== 流程一：显式请求（FR-02/05/06/08/10/11） ===")

    定义 触 = 触发("本地", "E-1", "Th-登录", "张三", "@更夫 请修复登录页崩溃缺陷")
    定义 准入 = 准入器.判定(触)
    保存触发(触)
    打印(`    准入判定：{准入}`)

    定义 单 = 工单(新工单编号(), "修复登录页崩溃", 触.来源, 触.外部编号, 触.发起人, 触.内容, 模式审计)
    授予(单, "张三", "v0.1", ["修复", "测试"])
    单.准入 = 准入
    定义 授 = 单.授权
    定义 授权合法 = 校验(授, ["修复"])
    定义 越权决策 = 拒绝扩权(单, ["发布上线"], "张三")
    打印(`    授权校验：{授权合法}；越权结论：{越权决策.结论}`)

    定义 话题对象 = 话题("Th-登录", "登录缺陷话题")
    话题对象.订阅(单.编号)
    保存工单(单)
    保存授权(授)

    定义 末报 = 执行工单(单, 调度器, 预算, 记录报告, ["定位登录失败原因", "修复并补充测试"])
    单.阶段 = 推导阶段(单, 列出报告(单.编号))
    保存工单(单)

    定义 幂等键 = SHA256(单.编号)
    定义 投递号 = 投递入队(单.编号, "待审核通知", `工单 {单.编号} 已就绪待审核`, 幂等键)
    定义 重复投递号 = 投递入队(单.编号, "待审核通知", "重复投递测试", 幂等键)
    标记投递(投递号)
    定义 幂等有效 = 投递号 == 重复投递号
    打印(`    末报告类型：{末报.类型}；推导阶段：{单.阶段}；outbox幂等：{幂等有效}`)

// ======================== 流程二：observe 候选审计 ========================
函数 演示观察审计()
    打印("")
    打印("=== 流程二：候选事件 observe 审计（FR-03/04） ===")

    定义 触 = 触发("本地CI", "E-2", "Th-登录", "ci-bot", "构建失败：登录测试用例红灯", 假, 真)
    定义 准入 = 准入器.判定(触)
    保存触发(触)
    打印(`    准入判定：{准入}`)

    定义 决 = 评估器.评估(触, 模式审计)
    保存决策(决)
    定义 说明 = 决.描述()
    打印(`    决策：{说明}`)
    打印("    observe 模式只记 would_accept，不改动任何代码")

    定义 全部决策 = 串行评估(评估器, [触], 模式审计)
    定义 条数 = 长度(全部决策)
    打印(`    串行评估条数：{条数}`)

// ======================== 流程三：评审跟进 ========================
函数 演示评审跟进()
    打印("")
    打印("=== 流程三：评审意见直通原工单（FR-06/07） ===")

    定义 单 = 列出工单()[0]
    定义 话题对象 = 话题("Th-登录", "登录缺陷话题")
    话题对象.订阅(单.编号)
    定义 已订阅 = 话题对象.已订阅(单.编号)
    打印(`    话题已订阅原工单：{已订阅}；评审意见不重复建单、不重新评估`)

    单.加入输入("请补充登录失败边界条件测试")
    定义 待交付 = 单.待交付数()
    保存工单(单)
    打印(`    补投后待交付输入数：{待交付}`)

    定义 末报 = 执行工单(单, 调度器, 预算, 记录报告, ["处理评审意见并补充测试"])
    单.阶段 = 推导阶段(单, 列出报告(单.编号))
    保存工单(单)
    定义 已结束 = 单.已结束()
    定义 可重开 = 真
    打印(`    末报告类型：{末报.类型}；工单阶段：{单.阶段}；是否已结束：{已结束}`)

// ======================== 流程四：中断恢复 ========================
函数 演示中断恢复()
    打印("")
    打印("=== 流程四：崩溃恢复（FR-13） ===")

    定义 单 = 工单(新工单编号(), "中断续跑演示", "本地", "E-3", "李四", "模拟执行中进程崩溃", 模式自动)
    定义 绑定 = 执行绑定(单.编号, "worker-1", 1)
    绑定.开始()
    单.绑定 = 绑定
    单.阶段 = 阶段执行中
    保存工单(单)

    定义 结果 = 恢复检查点()
    定义 说明 = 结果["说明"]
    定义 补投数 = 结果["补投数"]
    定义 恢复后 = 读取工单(单.编号)
    定义 恢复阶段 = 恢复后.阶段
    定义 恢复待交付 = 恢复后.待交付数()
    定义 推导后阶段 = 推导阶段(恢复后, 列出报告(恢复后.编号))
    打印(`    {说明}`)
    打印(`    恢复后阶段：{恢复阶段}；按未交付输入推导应为：{推导后阶段}；待交付输入：{恢复待交付}`)

// ======================== 主流程 ========================
函数 主()
    打印("════════════════════════════════════════")
    打印("  更夫 Nightwatch — 常驻研发协作 Agent 演示")
    打印("  范围：非 GitHub 部分（GitHub 相关本轮不做）")
    打印("════════════════════════════════════════")

    演示显式请求()
    演示观察审计()
    演示评审跟进()
    演示中断恢复()

    打印("")
    打印("=== 六类报告与异步工具（FR-08/09） ===")
    定义 报告序列 = 生成报告序列("演示工单")
    定义 报告数 = 长度(报告序列)
    打印(`    六类报告序列长度：{报告数}`)
    运行异步工具("跑测试", 0.2, 记录异步结果)
    等待全部()

    打印("")
    打印("=== Watchdog 与全局暂停（FR-14/16） ===")
    定义 停滞数 = 巡检停滞()
    打印(`    停滞工单数：{停滞数}`)
    定义 看板对象 = 创建看板(取工单, 取决策, 状态)
    定义 首页 = 看板对象.首页()
    定义 审计页 = 看板对象.审计页()
    定义 暂停前 = 状态["暂停中"]
    定义 暂停响应 = 处理暂停(状态, {})
    定义 暂停后 = 状态["暂停中"]
    定义 看板长度 = 长度(首页)
    定义 审计长度 = 长度(审计页)
    打印(`    看板首页长度：{看板长度}；审计页长度：{审计长度}`)
    打印(`    全局暂停：{暂停前} → {暂停后}；响应：{暂停响应["内容"]}`)

    打印("")
    打印("=== 持久化统计 ===")
    打印统计()
    打印("")
    打印("演示完成。全部流程均为本地模拟，未发起任何 GitHub 网络请求。")

主()
