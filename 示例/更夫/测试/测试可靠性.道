// 更夫 Nightwatch — 主代理独立可靠性验收（第四轮）
// 对应 PRD §12 DoD 的「混沌测试」「合成负载测试」两项的本地模拟部分。
// 不依赖子代理的测试脚本，直接调用核心模块复验关键能力，避免只凭子代理自报。
// 使用独立 DB 路径，避免与其它测试脚本互相污染。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 测试报告
从 系统 导入 退出
从 基础设施层.存储 导入 打开存储, 保存触发, 列出触发, 取连接, 投递入队, 待投递列表
从 领域层.领域 导入 触发, 阶段排队
从 应用层.恢复 导入 恢复检查点
从 应用层.准入 导入 创建准入器, 是噪音
从 应用层.评估 导入 创建评估器
从 应用层.调度 导入 创建预算

定义 套件 = 测试套件("主代理可靠性独立验收")
套件.start()

// 1. 存储连接可用
尝试
    定义 连接对象 = 打开存储("_测_主代理可靠性.db")
    断言为真(连接对象 != 空)
    套件.record_pass("存储连接可用")
捕获 错误
    套件.record_fail("存储连接可用", 文本(错误))

// 2. 触发去重幂等：同一事件连续投递 10 次只落 1 条
尝试
    定义 唯一键 = `去重校验-{时间戳()}`
    定义 去重触 = 触发("本地模拟", 唯一键, "话题-去重", "维护者", "请修复登录问题")
    定义 成功次数 = 0
    遍历 序号 从 1 到 10
        如果 保存触发(去重触)
            成功次数 = 成功次数 + 1
    断言等于(1, 成功次数)
    套件.record_pass("重复投递幂等")
捕获 错误
    套件.record_fail("重复投递幂等", 文本(错误))

// 3. 恢复检查点返回完整字典且补投数非负
尝试
    定义 恢复结果 = 恢复检查点()
    断言为真("结束绑定数" 在 恢复结果)
    断言为真("补投数" 在 恢复结果)
    断言为真(恢复结果["补投数"] >= 0)
    套件.record_pass("恢复检查点")
捕获 错误
    套件.record_fail("恢复检查点", 文本(错误))

// 4. 噪音判定
尝试
    断言为真(是噪音(""))
    断言为假(是噪音("请修复登录页崩溃问题"))
    套件.record_pass("噪音判定")
捕获 错误
    套件.record_fail("噪音判定", 文本(错误))

// 5. 准入矩阵：白名单明确请求 → 显式；机器人 → 机器人
尝试
    定义 准入器 = 创建准入器(["维护者"])
    定义 明确触 = 触发("本地模拟", "准入-1", "话题-准入", "维护者", "请修复登录页崩溃")
    定义 机器触 = 触发("本地模拟", "准入-2", "话题-准入", "机器人", "CI 红灯", 真)
    断言等于("explicit", 准入器.判定(明确触))
    断言等于("bot", 准入器.判定(机器触))
    套件.record_pass("准入矩阵")
捕获 错误
    套件.record_fail("准入矩阵", 文本(错误))

// 6. 关键词评估器降级可用（不传语言模型）
尝试
    定义 规则列表 = [{"名称": "登录修复", "关键词": ["登录"], "结论": "would_accept", "范围": ["本地模拟"]}]
    定义 评估器 = 创建评估器(规则列表, "v0.1")
    定义 评估触 = 触发("本地模拟", "评估-1", "话题-评估", "维护者", "登录页崩溃请修复")
    定义 决策 = 评估器.评估(评估触, "observe")
    断言等于("would_accept", 决策.结论)
    断言为真("关键词规则：" 在 决策.理由)
    套件.record_pass("关键词评估降级")
捕获 错误
    套件.record_fail("关键词评估降级", 文本(错误))

// 7. 预算熔断：调用上限 2，第 3 次拒绝
尝试
    定义 预算 = 创建预算(2, 100000, 5.0, 0.01)
    断言为真(预算.记账("T-熔断测试"))
    断言为真(预算.记账("T-熔断测试"))
    断言为假(预算.记账("T-熔断测试"))
    套件.record_pass("预算熔断")
捕获 错误
    套件.record_fail("预算熔断", 文本(错误))

// 8. Outbox 幂等：同一幂等键只入队 1 条
尝试
    定义 键 = "幂等键-验收-1"
    投递入队("T-验收", "ready", "执行完成", 键)
    投递入队("T-验收", "ready", "执行完成", 键)
    定义 匹配数 = 0
    遍历 项 在 待投递列表()
        如果 项["幂等键"] == 键
            匹配数 = 匹配数 + 1
    断言等于(1, 匹配数)
    套件.record_pass("Outbox幂等")
捕获 错误
    套件.record_fail("Outbox幂等", 文本(错误))

// 9. 阶段常量可用
尝试
    断言等于("排队", 阶段排队)
    套件.record_pass("阶段常量")
捕获 错误
    套件.record_fail("阶段常量", 文本(错误))

定义 结果 = 测试报告(套件)
打印(结果)
如果 套件.failed > 0
    退出(1)
