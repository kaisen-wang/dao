// 更夫 Nightwatch — 合成负载压测（L1 测试层）
// 运行：cd 示例/更夫 && python ../../源码/main.py 测试/压测.道
// 职责：按《迭代规约-可靠性.md》§5 构造 300 条消息（280 噪音 + 20 显式请求）×5 轮，
//       验证三项硬指标（噪音误建单=0、20 显式请求全建单、重复投递只产生 1 条 Trigger），
//       并输出 p50/p95/最大值与「单会话基线 vs 批处理」耗时对照。
// 对应：PRD §12「合成负载测试」DoD 项。
// 注意：p95 仅作观测指标写入报告，不做硬断言（纯 CPU 模拟无真实并发收益）；
//       断言均被 尝试/捕获 保护，故末尾的 退出(1) 不可省略。
// 注意：「规则」是关键字，变量名一律用「规则列表」；时间戳() 为内置函数（返回秒）。

从 测试 导入 测试套件, 断言等于, 断言为真, 测试报告
从 系统 导入 退出
从 数学 导入 向下取整, 四舍五入

从 领域层.领域 导入 触发, 准入显式, 模式审计
从 应用层.准入 导入 创建准入器
从 应用层.评估 导入 创建评估器
从 基础设施层.存储 导入 打开存储, 保存触发, 列出触发

// ======================== 负载参数与口径 ========================
定义 噪音条数 = 280
定义 显式条数 = 20
定义 轮数 = 5
定义 重复投递次数 = 10
定义 空内容数 = 94
定义 纯符号数 = 93
定义 噪音短语数 = 93

// 关键词规则：「规则」为关键字，故用「规则列表」命名；不传语言模型，走纯关键词规则。
定义 规则列表 = [
    {"名称":"显式请求建单", "关键词":["@更夫", "请修复", "请处理", "帮我处理", "开工单", "请帮忙"], "结论":"would_accept", "范围":[]}
]

// 纯符号池与已知噪音短语池：全部为非请求文本，用于制造「应当被忽略」的噪音。
定义 纯符号池 = ["！！！", "，。", "@@@", "###", "——", "。。。", "！！！？", "***", "///", "~~~", "!!!", "???", "···", "==", "++", "--", "……", "￥￥", "^^^", "&&&"]
定义 噪音短语池 = ["收到", "谢谢", "+1", "已阅", "好的", "OK", "ok", "666", "收到谢谢", "get", "在吗", "哈哈", "嗯嗯", "好的收到", "稍等", "了解", "赞", "收到啦", "辛苦了", "OK谢谢"]

// 20 条显式请求：均由白名单「维护者」发起、含明确请求词，且命中关键词规则。
定义 显式请求池 = [
    "@更夫 请修复登录缺陷",
    "请处理订单超时问题",
    "@更夫 帮我处理支付报错",
    "请修复首页样式错乱",
    "开工单修复搜索失败",
    "请帮忙排查内存泄漏",
    "@更夫 请处理接口500错误",
    "请修复数据同步延迟",
    "@更夫 请修复按钮失效",
    "请处理日志堆积问题",
    "帮我处理构建失败问题",
    "@更夫 开工单处理崩溃",
    "请修复鉴权漏洞",
    "@更夫 请处理慢查询",
    "请帮忙修复文件上传失败",
    "请处理缓存击穿问题",
    "@更夫 请修复并发问题",
    "请处理消息队列积压",
    "@更夫 请修复导出失败",
    "请帮忙处理定时任务异常"
]

// ======================== 测试框架 ========================
定义 套件 = 测试套件("更夫 Nightwatch 合成负载压测")
套件.start()

// 运行单个用例：捕获断言失败并记入套件，保证后续用例继续执行。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "断言全部通过", 错误.信息)

// ======================== 全局统计 ========================
// 消息类别：去重键 → "噪音"/"显式"，用于区分建单来源。
定义 消息类别 = {}
定义 每轮噪音误建单 = []
定义 每轮显式建单 = []
// 每条耗时毫秒：全轮次全部消息的单条处理耗时（判定 + 可能的评估）。
定义 每条耗时毫秒 = []
// 每轮基线毫秒：单会话基线，逐条串行处理同一批数据的总耗时。
定义 每轮基线毫秒 = []
// 每轮批处理毫秒：批处理，先批量判定再批量评估同一批数据的总耗时。
定义 每轮批处理毫秒 = []
定义 已构造消息总数 = 0
定义 已处理消息总数 = 0

// 构造一轮 300 条触发（280 噪音 + 20 显式），并把类别写入全局字典。
// 外部编号带轮次前缀，保证跨轮去重键唯一。
函数 构造批次(轮次)
    定义 批次 = []
    // 94 条空内容
    遍历 i 从 0 到 空内容数 - 1
        定义 键 = `N-{轮次}-空-{i}`
        定义 触 = 触发("本地噪音", 键, "T-噪音", "路人", "")
        追加(批次, 触)
        消息类别[触.去重键()] = "噪音"
    // 93 条纯符号
    遍历 i 从 0 到 纯符号数 - 1
        定义 键 = `N-{轮次}-符-{i}`
        定义 内容 = 纯符号池[i % 长度(纯符号池)]
        定义 触 = 触发("本地噪音", 键, "T-噪音", "路人", 内容)
        追加(批次, 触)
        消息类别[触.去重键()] = "噪音"
    // 93 条已知噪音短语
    遍历 i 从 0 到 噪音短语数 - 1
        定义 键 = `N-{轮次}-语-{i}`
        定义 内容 = 噪音短语池[i % 长度(噪音短语池)]
        定义 触 = 触发("本地噪音", 键, "T-噪音", "路人", 内容)
        追加(批次, 触)
        消息类别[触.去重键()] = "噪音"
    // 20 条显式请求
    遍历 i 从 0 到 显式条数 - 1
        定义 键 = `R-{轮次}-显-{i}`
        定义 触 = 触发("本地请求", 键, "T-请求", "维护者", 显式请求池[i])
        追加(批次, 触)
        消息类别[触.去重键()] = "显式"
    返回 批次

// ======================== 主负载：5 轮 × 300 条 ========================
定义 准入器 = 创建准入器(["维护者"])
// 不传语言模型：语义评估返回空，走关键词规则。
定义 评估器 = 创建评估器(规则列表)

遍历 轮次 从 1 到 轮数
    定义 批次 = 构造批次(轮次)
    已构造消息总数 = 已构造消息总数 + 长度(批次)

    定义 噪音误建 = 0
    定义 显式建成 = 0

    // —— 单会话基线：逐条串行处理，逐条计时 ——
    定义 基线开始 = 时间戳()
    遍历 触 在 批次
        定义 条开始 = 时间戳()
        定义 判定结论 = 准入器.判定(触)
        如果 判定结论 == 准入显式
            定义 决 = 评估器.评估(触, 模式审计)
            如果 决.结论 == "would_accept"
                如果 消息类别[触.去重键()] == "噪音"
                    噪音误建 = 噪音误建 + 1
                否则
                    显式建成 = 显式建成 + 1
        定义 条结束 = 时间戳()
        追加(每条耗时毫秒, (条结束 - 条开始) * 1000)
        已处理消息总数 = 已处理消息总数 + 1
    定义 基线结束 = 时间戳()
    追加(每轮基线毫秒, (基线结束 - 基线开始) * 1000)

    追加(每轮噪音误建单, 噪音误建)
    追加(每轮显式建单, 显式建成)

    // —— 批处理对照：同一批数据，先批量判定、再批量评估 ——
    定义 批处理开始 = 时间戳()
    定义 显式批次 = []
    遍历 触 在 批次
        定义 判定结论 = 准入器.判定(触)
        如果 判定结论 == 准入显式
            追加(显式批次, 触)
    遍历 触 在 显式批次
        评估器.评估(触, 模式审计)
    定义 批处理结束 = 时间戳()
    追加(每轮批处理毫秒, (批处理结束 - 批处理开始) * 1000)

// ======================== 重复投递幂等（硬指标） ========================
打开存储(":memory:")
定义 重复请求 = 触发("本地请求", "DUP-REQUEST-KEY", "T-重复投递", "维护者", "@更夫 请修复重复投递")
定义 重复成功次数 = 0
遍历 i 从 1 到 重复投递次数
    如果 保存触发(重复请求)
        重复成功次数 = 重复成功次数 + 1
定义 触发总数 = 长度(列出触发())

// ======================== 汇总统计 ========================
定义 噪音误建合计 = 0
遍历 数值 在 每轮噪音误建单
    噪音误建合计 = 噪音误建合计 + 数值
定义 显式建单合计 = 0
遍历 数值 在 每轮显式建单
    显式建单合计 = 显式建单合计 + 数值

定义 排序耗时 = 排序(每条耗时毫秒)
定义 采样数 = 长度(排序耗时)
定义 p50索引 = 向下取整(0.50 * 采样数)
定义 p95索引 = 向下取整(0.95 * 采样数)
定义 p50毫秒 = 排序耗时[p50索引]
定义 p95毫秒 = 排序耗时[p95索引]
定义 最大毫秒 = 最大值(排序耗时)

定义 基线总毫秒 = 0.0
遍历 数值 在 每轮基线毫秒
    基线总毫秒 = 基线总毫秒 + 数值
定义 批处理总毫秒 = 0.0
遍历 数值 在 每轮批处理毫秒
    批处理总毫秒 = 批处理总毫秒 + 数值

// 展示值：保留 4 位小数，便于报告中读数。
定义 p50展示 = 四舍五入(p50毫秒 * 10000) / 10000
定义 p95展示 = 四舍五入(p95毫秒 * 10000) / 10000
定义 最大展示 = 四舍五入(最大毫秒 * 10000) / 10000
定义 基线展示 = 四舍五入(基线总毫秒 * 10000) / 10000
定义 批处理展示 = 四舍五入(批处理总毫秒 * 10000) / 10000
定义 基线轮次展示 = []
遍历 数值 在 每轮基线毫秒
    追加(基线轮次展示, 四舍五入(数值 * 1000) / 1000)
定义 批处理轮次展示 = []
遍历 数值 在 每轮批处理毫秒
    追加(批处理轮次展示, 四舍五入(数值 * 1000) / 1000)

// ======================== 硬指标用例（断言受 尝试/捕获 保护） ========================
函数 测构造总量口径()
    断言等于(空内容数 + 纯符号数 + 噪音短语数, 噪音条数)
    断言等于(已构造消息总数, 轮数 * (噪音条数 + 显式条数))
    断言等于(已处理消息总数, 轮数 * (噪音条数 + 显式条数))
    断言等于(长度(每轮噪音误建单), 轮数)
    断言等于(长度(每轮显式建单), 轮数)

函数 测噪音零误建单()
    遍历 i 从 0 到 轮数 - 1
        断言等于(每轮噪音误建单[i], 0)
    断言等于(噪音误建合计, 0)

函数 测显式全建单()
    遍历 i 从 0 到 轮数 - 1
        断言等于(每轮显式建单[i], 显式条数)
    断言等于(显式建单合计, 轮数 * 显式条数)

函数 测重复投递幂等()
    断言等于(重复成功次数, 1)
    断言等于(触发总数, 1)

函数 测性能采样完整()
    // 仅校验观测数据完整性；p95 数值本身不做硬断言。
    断言等于(采样数, 轮数 * (噪音条数 + 显式条数))
    断言为真(长度(每轮基线毫秒) == 轮数)
    断言为真(长度(每轮批处理毫秒) == 轮数)

// ======================== 执行全部用例 ========================
运行用例("构造总量口径", 测构造总量口径)
运行用例("噪音零误建单", 测噪音零误建单)
运行用例("显式全建单", 测显式全建单)
运行用例("重复投递幂等", 测重复投递幂等)
运行用例("性能采样完整", 测性能采样完整)

// ======================== 中文报告 ========================
打印("")
打印("==================== 更夫 Nightwatch 合成负载压测报告 ====================")
打印(`负载规模：每轮 {噪音条数 + 显式条数} 条（噪音 {噪音条数} + 显式 {显式条数}）× {轮数} 轮，共 {已构造消息总数} 条`)
打印(`判定链路：创建准入器(["维护者"]) + 创建评估器(关键词规则，不传语言模型)，逐条判定 → 仅显式请求进入评估 → 统计建单`)
打印("")
打印("【硬指标】")
打印(`噪音误建单：{噪音误建合计} / {噪音条数 * 轮数}（每轮 {每轮噪音误建单}）`)
打印(`显式请求建单：{显式建单合计} / {显式条数 * 轮数}（每轮 {每轮显式建单}）`)
打印(`重复投递幂等：同一请求投递 {重复投递次数} 次，成功落库 {重复成功次数} 次，触发总数 {触发总数}`)
打印("")
打印("【性能观测（p50 / p95 / 最大值，毫秒；p95 仅观测不硬断言）】")
打印(`采样数：{采样数} 条单条耗时`)
打印(`p50：{p50展示} 毫秒`)
打印(`p95：{p95展示} 毫秒  ← 观测指标，不做硬断言`)
打印(`最大值：{最大展示} 毫秒`)
打印("")
打印("【单会话基线 vs 批处理（同一批数据，5 轮合计，毫秒）】")
打印(`单会话基线（逐条串行）：{基线展示} 毫秒（每轮 {基线轮次展示}）`)
打印(`批处理（先批量判定再批量评估）：{批处理展示} 毫秒（每轮 {批处理轮次展示}）`)
打印(`说明：纯 CPU 模拟、无真实并发收益，二者接近属预期；此处仅作对照，不作为性能门槛。`)
打印("")
打印(测试报告(套件))

// CI 判失败：断言被 尝试/捕获 吃掉后脚本仍会退出 0，故末尾退出(1)不可省略。
如果 套件.failed > 0
    退出(1)
退出(0)
