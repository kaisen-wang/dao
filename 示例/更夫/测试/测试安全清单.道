// 更夫 Nightwatch — PRD §10 安全清单本地验收测试（第七轮 / 推进 §12 第 5 项 DoD 的本地可验证部分）
//
// 运行方式：
//   cd 示例/更夫 && python ../../源码/main.py 测试/测试安全清单.道
//
// 诚实边界（硬性要求）：
//   1. 全程本地静态检查 + 行为检查；不接真实 GitHub、不发真实请求、不创建真实 PR、不做真实 merge。
//   2. 标注「需真实环境」的项目只作说明性打印，不计入通过，不写成已验证。
//   3. 实现与 PRD §10 不符的项如实记录为失败（record_fail），不改实现文件、不勾选任何 DoD。
//   4. 本地通过 ≠ 真实闭环达成；本文档与 安全说明.md 均不宣称 §10 全项通过。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 断言包含, 测试报告
从 文件 导入 读取, 存在
从 文本 导入 分割
从 系统 导入 退出

从 领域层.领域 导入 工单, 模式审计
从 应用层.准入 导入 创建准入器
从 应用层.授权 导入 授予, 校验, 拒绝扩权
从 应用层.观察审计 导入 创建观察审计
从 基础设施层.GitHub事件 导入 创建GitHub适配器

定义 套件 = 测试套件("更夫 Nightwatch PRD §10 安全清单本地验收")
套件.start()

// 统一用例运行器：捕获断言失败并记入套件，保证后续用例继续执行。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "断言应全部通过", 错误.信息)

// ======================== §10.1 独立账号 / 分支保护 / 无 merge 权限 ========================

// 本地可验证：Worker 执行器与 GitHub 适配器只产出载荷 / 信号，源码不出现真实 merge 调用。
函数 测无真实merge调用()
    定义 源码列表 = [
        读取("应用层/执行.道"),
        读取("基础设施层/GitHub事件.道"),
        读取("webhook服务.道")
    ]
    定义 危险模式 = ["merge(", "合并(", "git push", "网络.请求", "requests.post"]
    遍历 源码 在 源码列表
        遍历 模式 在 危险模式
            断言为假(包含(源码, 模式))

函数 测只产出载荷与信号()
    定义 适配器 = 创建GitHub适配器()
    定义 载荷 = 适配器.回复消息("owner/repo#1", "请修复登录页崩溃")
    断言等于(载荷["待发送"], 真)
    断言等于(载荷["本地模拟"], 真)
    定义 PR事件 = {
        "action": "closed",
        "pull_request": {"id": 7, "number": 7, "body": "@更夫 请修复", "user": {"login": "张三"}, "merged": 真},
        "repository": {"full_name": "owner/repo"}
    }
    定义 解析 = 适配器.解析事件(PR事件)
    断言等于(解析["已合并"], 真)

// ======================== §10.2 凭据不进模型上下文 / 日志脱敏 ========================

// 本地可验证：适配器构造消息时只用提示词参数，不引用配置 / 凭据 / 环境变量。
函数 测凭据不进提示词()
    定义 适配源码 = 读取("基础设施层/语言模型.道")
    断言为真(包含(适配源码, '消息("user", 提示词)'))
    定义 行列表 = 分割(适配源码, "\n")
    定义 凭据词 = ["令牌", "密钥", "token", "secret", "本对象.配置", "取环境变量"]
    遍历 行 在 行列表
        如果 包含(行, "消息(")
            遍历 词 在 凭据词
                断言为假(包含(行, 词))

// 本地可验证（不满足即失败）：任何受查文件都没有「脱敏」函数，记失败，不写成已通过。
函数 测日志脱敏函数()
    定义 待查文件 = [
        "基础设施层/语言模型.道",
        "基础设施层/webhook接入.道",
        "应用层/准入.道",
        "应用层/评估.道",
        "应用层/授权.道",
        "接入层/入口.道",
        "webhook服务.道"
    ]
    定义 找到脱敏 = 假
    遍历 路径 在 待查文件
        如果 存在(路径)
            如果 包含(读取(路径), "脱敏")
                找到脱敏 = 真
    定义 状态 = "存在日志脱敏函数"
    如果 不是 找到脱敏
        状态 = "未发现任何含「脱敏」的函数：日志脱敏能力缺失"
    断言等于("存在日志脱敏函数", 状态)

// ======================== §10.3 数据非指令 / 高危操作人工确认 ========================

// 本地可验证（不满足即失败）：评估器 prompt 模板未含「数据非指令」标记，记失败。
函数 测数据非指令标记()
    定义 评估源码 = 读取("应用层/评估.道")
    定义 状态 = "评估 prompt 模板含「数据非指令」标记"
    如果 不是 包含(评估源码, "数据非指令")
        状态 = "评估 prompt 模板未含「数据非指令」标记"
    断言等于("评估 prompt 模板含「数据非指令」标记", 状态)

// 本地可验证：越权请求被拒绝扩权拦下，返回 needs_reauth（通用人工复核入口存在）。
函数 测越权拒绝与复核入口()
    定义 单 = 工单("T-安全", "越权复核", "本地", "E-安全", "张三", "测试内容", 模式审计)
    定义 授 = 授予(单, "张三", "v0.1", ["修复", "测试"])
    断言为真(校验(授, ["修复"]))
    断言为假(校验(授, ["发布上线"]))
    定义 拒决 = 拒绝扩权(单, ["发布上线"], "张三")
    断言等于(拒决.结论, "needs_reauth")
    断言包含(拒决.理由, "重新授权")

// ======================== §10.4 白名单仅 AI 本人 / auto 前置门禁 ========================

// 本地可验证：准入器白名单机制可控（加白 / 移除白生效）。
函数 测白名单机制可控()
    定义 准入器 = 创建准入器(["张三"])
    断言等于(准入器.白名单(), ["张三"])
    准入器.加白("李四")
    断言等于(准入器.白名单(), ["张三", "李四"])
    准入器.移除白("张三")
    断言等于(准入器.白名单(), ["李四"])

// 本地可验证（不满足即失败）：入口默认白名单为「张三」「维护者」，非 PRD 要求的「仅 AI 本人」。
函数 测入口白名单AI本人()
    定义 入口源码 = 读取("接入层/入口.道")
    定义 状态 = "入口白名单仅含 AI 本人"
    如果 不是 包含(入口源码, "AI 本人")
        状态 = "入口白名单为「张三」「维护者」，未体现「仅 AI 本人」"
    断言等于("入口白名单仅含 AI 本人", 状态)

// 本地可验证：观察审计的误接受率公式可用于 ≤5% 门禁比较（本地可验证的构建块）。
函数 测误接受率阈值()
    定义 低误接 = 创建观察审计()
    遍历 i 从 1 到 19
        低误接.记录事件({"事件ID": `正-{i}`}, 假, 假)
    低误接.记录事件({"事件ID": "误-1"}, 真, 假)
    断言等于(0.05, 低误接.误接受率())
    断言为真(低误接.误接受率() <= 0.05)

    定义 高误接 = 创建观察审计()
    遍历 i 从 1 到 18
        高误接.记录事件({}, 假, 假)
    遍历 i 从 1 到 2
        高误接.记录事件({}, 真, 假)
    断言等于(0.1, 高误接.误接受率())
    断言为假(高误接.误接受率() <= 0.05)

// 本地可验证（不满足即失败）：未发现 combine「observe ≥2 周」与「误接受率 ≤5%」的 auto 门禁函数。
函数 测auto门禁函数()
    定义 门禁源码 = 读取("应用层/观察审计.道") + 读取("接入层/入口.道")
    定义 有门禁 = 包含(门禁源码, "两周") 或者 包含(门禁源码, "2周")
    定义 状态 = "存在 observe≥2周 且 误接受率≤5% 的 auto 门禁函数"
    如果 不是 有门禁
        状态 = "未发现 combine「≥2周」与「≤5%」的 auto 门禁函数"
    断言等于("存在 observe≥2周 且 误接受率≤5% 的 auto 门禁函数", 状态)

