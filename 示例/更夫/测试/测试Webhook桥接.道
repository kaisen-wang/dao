// 更夫 Nightwatch — 第七轮 B（webhook-bridge）自检：重放防护 + L3 桥接 + 兼容
// 运行：cd 示例/更夫 && python ../../源码/main.py /tmp/测Webhook桥接.道
// 全程本地模拟：不发真实 HTTP、不创建真实 PR、不做真实 merge；临时数据仅在内存。

从 系统 导入 设环境变量, 退出
设环境变量("更夫Webhook跳过启动", "1")

从 测试 导入 测试套件, 断言等于, 断言为真, 断言包含, 测试报告
从 编码 导入 JSON
从 密码 导入 HMACSHA256
从 基础设施层.webhook接入 导入 创建Webhook接入
从 应用层.路由 导入 创建路由
从 webhook服务 导入 创建Webhook桥接

定义 套件 = 测试套件("更夫 Webhook 桥接与重放防护测试（第七轮 B）")
套件.start()

// 运行单个用例：捕获断言失败并记入套件，保证后续用例继续执行。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "全部断言通过", 错误.信息)

// 回调探针：记录每次被触发的载荷次数。
定义 回调计数 = 0
函数 计数回调(数据)
    回调计数 = 回调计数 + 1

// 构造飞书验签请求（正文为 JSON 文本，附本地 HMAC-SHA256 签名头）；随机数决定签名键。
函数 构造飞书请求(密钥, 正文, 随机数)
    定义 时间戳 = "1700000100"
    定义 签名串 = 时间戳 + "\n" + 随机数 + "\n" + 正文 + "\n"
    定义 签名 = HMACSHA256(密钥, 签名串)
    返回 {
        "请求头": {
            "X-Lark-Request-Timestamp": 时间戳,
            "X-Lark-Request-Nonce": 随机数,
            "X-Lark-Signature": 签名
        },
        "请求体": 正文,
        "路径": "/webhook/feishu"
    }

// @机器人 的飞书事件正文，话题键为 TH-BRIDGE。
定义 事件字典 = {
    "header": {"event_id": "E-BRIDGE"},
    "event": {
        "message": {"message_id": "M-BRIDGE", "content": "@更夫 请修复崩溃"},
        "sender": {"sender_id": {"open_id": "张三"}},
        "chat_id": "TH-BRIDGE"
    }
}
定义 正文 = JSON.编码(事件字典)

// 1. 重放检测：同一签名键第二次返回 409 且不回调。
函数 测重放409且不回调()
    回调计数 = 0
    定义 接入 = 创建Webhook接入("feishu", "cli", "sec", 假, 计数回调)
    定义 请求 = 构造飞书请求("sec", 正文, "nonce-replay")
    定义 回执1 = 接入.处理(请求)
    断言等于(回执1["状态码"], 200)
    断言等于(回执1["内容"], "成功")
    定义 回执2 = 接入.处理(请求)
    断言等于(回执2["状态码"], 409)
    断言等于(回执2["内容"], "重复事件")
    断言等于(回调计数, 1)
    // .是重放 在第二投之前为假、之后为真。
    断言为真(接入.是重放(请求))

// 2. 不同签名（不同 nonce）正常 200，各自回调一次。
函数 测不同签名正常200()
    回调计数 = 0
    定义 接入 = 创建Webhook接入("feishu", "cli", "sec", 假, 计数回调)
    定义 回执甲 = 接入.处理(构造飞书请求("sec", 正文, "nonce-a"))
    定义 回执乙 = 接入.处理(构造飞书请求("sec", 正文, "nonce-b"))
    断言等于(回执甲["状态码"], 200)
    断言等于(回执乙["状态码"], 200)
    断言等于(回调计数, 2)

// 3. 桥接回调触发 Router 收消息：@机器人 事件转入 S-WH-{话题键}，会话消息数增加。
函数 测桥接触发收消息()
    定义 路由 = 创建路由()
    定义 信号 = []
    定义 回调 = 创建Webhook桥接(路由, 信号)
    定义 接入 = 创建Webhook接入("feishu", "cli", "sec", 假, 回调)
    定义 回执 = 接入.处理(构造飞书请求("sec", 正文, "nonce-bridge"))
    断言等于(回执["状态码"], 200)
    断言等于(路由.会话数(), 1)
    定义 目标会话 = 路由.会话表["S-WH-TH-BRIDGE"]
    断言为真(目标会话 != 空)
    断言等于(目标会话.消息数(), 2)

// 4. merged 信号：事件含 已合并 时只生成「工单 ended(merged)」信号，不真实 merge。
函数 测merged信号()
    定义 信号 = []
    定义 回调 = 创建Webhook桥接(空, 信号)
    回调({"事件": {"已合并": 真, "是否@机器人": 假, "文本": "PR closed", "话题键": "repo#1", "来源信道": "github", "发送人": "bot"}})
    断言包含(信号, "工单 ended(merged)")
    断言等于(长度(信号), 1)

// 5. 不传路由 / 不传回调时兼容：本地模式仍 200，桥接回调不抛异常。
函数 测不传路由兼容()
    定义 回调 = 创建Webhook桥接()
    定义 接入 = 创建Webhook接入("feishu", "", "", 真, 回调)
    定义 原始 = {
        "header": {"event_id": "E-NOROUTE"},
        "event": {
            "message": {"message_id": "M-NOROUTE", "content": "@更夫 请处理超时"},
            "sender": {"sender_id": {"open_id": "本地用户"}},
            "chat_id": "TH-NOROUTE"
        }
    }
    断言等于(接入.处理({"请求体": 原始})["状态码"], 200)
    // 第五参整段省略（第六轮五参签名不变）。
    定义 接入无回调 = 创建Webhook接入("feishu", "", "", 真)
    断言等于(接入无回调.处理({"请求体": 原始})["状态码"], 200)

运行用例("重放检测 409 且不回调", 测重放409且不回调)
运行用例("不同签名正常 200", 测不同签名正常200)
运行用例("桥接触发 Router 收消息", 测桥接触发收消息)
运行用例("merged 信号", 测merged信号)
// 6. 本地模式重放：验签仍放行，但请求体哈希签名键第二次命中去重表 → 409 且不回调。
函数 测本地模式重放()
    回调计数 = 0
    定义 接入 = 创建Webhook接入("feishu", "", "", 真, 计数回调)
    定义 原始 = {
        "header": {"event_id": "E-LOCAL"},
        "event": {
            "message": {"message_id": "M-LOCAL", "content": "@更夫 请修复"},
            "sender": {"sender_id": {"open_id": "本地用户"}},
            "chat_id": "TH-LOCAL"
        }
    }
    定义 请求 = {"请求体": 原始}
    断言等于(接入.处理(请求)["状态码"], 200)
    定义 回执2 = 接入.处理(请求)
    断言等于(回执2["状态码"], 409)
    断言等于(回执2["内容"], "重复事件")
    断言等于(回调计数, 1)

运行用例("不传路由与不传回调兼容", 测不传路由兼容)
运行用例("本地模式重放同样 409", 测本地模式重放)

打印("")
打印(测试报告(套件))
如果 套件.failed > 0
    退出(1)
退出(0)
