// 更夫 Nightwatch — 道语言回归测试套件（L1 测试层）
// 运行：cd 示例/更夫 && python ../../源码/main.py 测试/测试LLM接入.道
// 说明：全部用例用道语言内置「测试」标准库编写。断言失败记入套件而不中断后续用例；
//       末尾按失败数显式设置退出码，便于命令行与 CI 直接判定。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 断言包含, 测试报告
从 文件 导入 存在, 读取
从 系统 导入 退出, 执行命令
从 密码 导入 SHA256

从 领域层.领域 导入 工单, 触发, 决策, 建报告, 推导阶段, 可重开, 新工单编号
从 领域层.领域 导入 阶段排队, 阶段待审核, 模式审计, 模式关闭, 报告就绪, 报告进度
从 领域层.领域 导入 准入显式, 准入候选, 准入忽略, 准入机器人
从 应用层.准入 导入 创建准入器
从 应用层.授权 导入 授予, 校验, 拒绝扩权
从 应用层.调度 导入 创建调度器, 创建预算
从 应用层.评估 导入 创建评估器, 串行评估
从 应用层.执行 导入 执行工单, 生成报告序列
从 基础设施层.存储 导入 打开存储, 保存工单, 列出工单, 保存触发, 投递入队, 统计
从 基础设施层.看板 导入 创建看板, 处理暂停
从 基础设施层.语言模型 导入 本地模型配置

// ======================== 测试框架 ========================

定义 套件 = 测试套件("更夫 Nightwatch 回归测试")
套件.start()

// 运行单个用例：捕获断言失败并记入套件，保证后续用例继续执行。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "全部断言通过", 错误.信息)

// ======================== 用例：结构与契约 ========================

函数 测层级文件齐备()
    定义 路径列表 = [
        "接入层/入口.道",
        "应用层/评估.道",
        "应用层/执行.道",
        "应用层/恢复.道",
        "应用层/准入.道",
        "应用层/授权.道",
        "应用层/调度.道",
        "领域层/领域.道",
        "基础设施层/存储.道",
        "基础设施层/看板.道",
        "基础设施层/语言模型.道",
        "架构说明.md",
        "使用说明.md"
    ]
    遍历 路径 在 路径列表
        定义 存在标志 = 存在(路径)
        断言为真(存在标志)

函数 测层级目录结构()
    定义 层级列表 = ["接入层", "应用层", "领域层", "基础设施层"]
    遍历 层级 在 层级列表
        定义 是目录 = 存在(层级)
        断言为真(是目录)
    断言为假(存在("核心"))
    断言为假(存在("适配层"))

函数 测领域层不依赖LLM()
    定义 源码 = 读取("领域层/领域.道")
    定义 禁用词 = ["大模型", "ollama", "语言模型", "HTTP", "网络.请求"]
    遍历 词 在 禁用词
        定义 命中 = 包含(源码, 词)
        断言为假(命中)

函数 测领域契约与状态机()
    定义 单 = 工单("T-测试", "测试工单", "本地", "E-1", "张三", "测试内容", 模式审计)
    定义 描述 = 单.描述()
    断言包含(描述, "T-测试")
    断言等于(单.阶段, 阶段排队)
    定义 推导 = 推导阶段(单, [])
    断言等于(推导, 阶段排队)
    定义 重开结果 = 可重开(单, "人工", 真)
    断言为假(重开结果)
    定义 决 = 决策("D-1", "would_accept", "测试理由", "v0.1")
    断言包含(决.描述(), "would_accept")

// ======================== 用例：业务规则 ========================

函数 测准入矩阵()
    定义 准入器 = 创建准入器(["张三"])
    定义 显式触 = 触发("本地", "E-1", "Th-1", "张三", "@更夫 请修复缺陷")
    定义 r1 = 准入器.判定(显式触)
    断言等于(r1, 准入显式)
    定义 候选触 = 触发("本地CI", "E-2", "Th-1", "ci-bot", "构建失败：测试红灯")
    定义 r2 = 准入器.判定(候选触)
    断言等于(r2, 准入候选)
    定义 噪音触 = 触发("本地", "E-3", "Th-1", "路人", "收到")
    定义 r3 = 准入器.判定(噪音触)
    断言等于(r3, 准入忽略)
    定义 机器人触 = 触发("本地", "E-4", "Th-1", "ci-bot", "@更夫 请修复缺陷", 真)
    定义 r4 = 准入器.判定(机器人触)
    断言等于(r4, 准入机器人)

函数 测授权与越权()
    定义 单 = 工单("T-授权", "授权测试", "本地", "E-1", "张三", "内容", 模式审计)
    定义 授 = 授予(单, "张三", "v0.1", ["修复", "测试"])
    断言为真(校验(授, ["修复"]))
    断言为假(校验(授, ["发布上线"]))
    定义 拒决 = 拒绝扩权(单, ["发布上线"], "张三")
    断言等于(拒决.结论, "needs_reauth")

函数 测调度与预算()
    定义 调度器 = 创建调度器(1)
    定义 槽 = 调度器.占用()
    定义 有槽 = 槽 != 空
    断言为真(有槽)
    定义 槽二 = 调度器.占用()
    定义 无槽 = 槽二 == 空
    断言为真(无槽)
    调度器.释放(槽)
    定义 槽三 = 调度器.占用()
    定义 复用成功 = 槽三 != 空
    断言为真(复用成功)
    定义 预算 = 创建预算(2, 100, 5.0, 0.01)
    定义 首记 = 预算.记账("T-预算", 1, 10)
    断言为真(首记)
    定义 超限记 = 预算.记账("T-预算", 2, 0)
    断言为假(超限记)

函数 测评估器降级()
    定义 规则列表 = [{"名称": "CI失败修复", "关键词": ["构建失败", "红灯"], "结论": "would_accept", "范围": []}]
    定义 评估器 = 创建评估器(规则列表, "v0.1", 空)
    定义 触 = 触发("本地CI", "E-1", "Th-1", "ci-bot", "构建失败：测试红灯", 假, 真)
    定义 决 = 评估器.评估(触, 模式审计)
    断言等于(决.结论, "would_accept")
    断言为真(包含(决.理由, "关键词规则："))
    定义 关闭决 = 评估器.评估(触, 模式关闭)
    断言等于(关闭决.结论, "would_ignore")

函数 测执行工单降级()
    定义 调度器 = 创建调度器(2)
    定义 预算 = 创建预算(80, 100000, 5.0, 0.01)
    定义 报告列表 = []
    函数 收集报告(报)
        追加(报告列表, 报)
    定义 单 = 工单("T-执行", "执行测试", "本地", "E-1", "张三", "内容", 模式审计)
    定义 末报 = 执行工单(单, 调度器, 预算, 收集报告, ["步骤一"], 空)
    断言等于(末报.类型, 报告就绪)
    定义 来源 = 末报.数据["模型来源"]
    断言等于(来源, "降级")
    定义 报告条数 = 长度(报告列表)
    断言等于(报告条数, 2)
    定义 运行数 = 调度器.运行中数()
    断言等于(运行数, 0)

函数 测报告序列()
    定义 序列 = 生成报告序列("T-报告")
    断言等于(长度(序列), 6)

// ======================== 用例：基础设施 ========================

函数 测存储与幂等()
    打开存储(":memory:")
    定义 单 = 工单("T-存储", "存储测试", "本地", "E-1", "张三", "内容", 模式审计)
    断言为真(保存工单(单))
    定义 工单列表 = 列出工单()
    断言等于(长度(工单列表), 1)
    定义 触 = 触发("本地CI", "E-9", "Th-1", "ci-bot", "构建失败")
    断言为真(保存触发(触))
    断言为假(保存触发(触))
    定义 幂等键 = SHA256("投递测试键")
    定义 投递一 = 投递入队("T-存储", "通知", "内容一", 幂等键)
    定义 投递二 = 投递入队("T-存储", "通知", "内容二", 幂等键)
    断言等于(投递一, 投递二)
    定义 统计结果 = 统计()
    断言等于(统计结果["工单"], 1)

函数 测看板呈现()
    定义 工单列表 = []
    函数 取工单()
        返回 工单列表
    定义 决策列表 = []
    函数 取决策()
        返回 决策列表
    定义 状态 = {"暂停中": 假, "模式": 模式审计}
    定义 看板对象 = 创建看板(取工单, 取决策, 状态)
    定义 首页 = 看板对象.首页()
    断言为真(包含(首页, "LLM 模式"))
    定义 审计页 = 看板对象.审计页()
    断言为真(包含(审计页, "观察候选审计流"))
    定义 响应 = 处理暂停(状态, {})
    断言为真(状态["暂停中"])
    定义 提示 = 响应["内容"]
    断言为真(包含(提示, "暂停"))

函数 测降级路径端到端()
    定义 命令 = "GENGFU_NO_LLM=1 PYTHONPATH=../../源码 python3 ../../源码/main.py 接入层/入口.道"
    定义 输出 = 执行命令(命令)
    断言为真(包含(输出, "LLM：已禁用"))
    断言为真(包含(输出, "演示完成"))
    断言为真(包含(输出, "关键词规则"))

