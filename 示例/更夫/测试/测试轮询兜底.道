// 更夫 Nightwatch — 第九轮 B（poll-fallback）自检：定时轮询兜底组件
// 运行：cd 示例/更夫 && python ../../源码/main.py 测试/测试轮询兜底.道
// 全程本地模拟：事件源为注入的模拟函数，不发起任何真实外部请求。

从 系统 导入 退出
从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 测试报告
从 基础设施层.轮询兜底 导入 轮询去重键, 创建轮询兜底, 创建定时轮询

定义 套件 = 测试套件("更夫 定时轮询兜底测试（第九轮 B）")
套件.start()

// 运行单个用例：捕获断言失败并记入套件，保证后续用例继续执行。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "全部断言通过", 错误.信息)

// ======================== 共享探针 ========================

// 回调探针：记录每次被触发的次数。
定义 派发计数 = 0
函数 计数回调(事件字典)
    派发计数 = 派发计数 + 1

// 异常探针：记录收到顺序，并对 E-2 制造一次回调异常。
定义 异常收到列表 = []
函数 部分失败回调(事件字典)
    追加(异常收到列表, 事件字典["外部编号"])
    如果 事件字典["外部编号"] == "E-2"
        定义 空白表 = {}
        定义 坏值 = 空白表["必定不存在的键"]

// 三条不同事件的模拟源：统一 外部编号 / 事件类型 键。
函数 标准事件源()
    返回 [
        {"外部编号":"E-1", "事件类型":"issues", "文本":"第一条"},
        {"外部编号":"E-2", "事件类型":"pull_request", "文本":"第二条"},
        {"外部编号":"E-3", "事件类型":"issue_comment", "文本":"第三条"}
    ]

// 假调度器：实现 .周期执行 / .取消调度，并记录调用，供 创建定时轮询 注入。
类型 调度记录器
    初始化()
        本对象.调用记录 = []
        本对象.间隔 = 空
        本对象.回调 = 空
    函数 周期执行(间隔毫秒, 回调)
        本对象.间隔 = 间隔毫秒
        本对象.回调 = 回调
        追加(本对象.调用记录, 间隔毫秒)
        返回 4242
    函数 取消调度(调度ID)
        追加(本对象.调用记录, "取消:" + 文本(调度ID))
        返回 真

// ======================== 用例 ========================

// 1. 新事件全部派发：回调收到 N 次、新事件=N。
函数 测新事件全部派发()
    派发计数 = 0
    定义 轮询器 = 创建轮询兜底(标准事件源, 计数回调)
    定义 结果 = 轮询器.轮询一次()
    断言为真(结果["成功"])
    断言等于(结果["拉取"], 3)
    断言等于(结果["新事件"], 3)
    断言等于(结果["重复跳过"], 0)
    断言等于(结果["失败"], 0)
    断言为假(结果["拉取失败"])
    断言等于(派发计数, 3)
    断言等于(轮询器.已见数(), 3)

// 2. 同一批重复轮询：重复跳过=N、新事件=0、回调不再增加。
函数 测重复轮询去重()
    派发计数 = 0
    定义 轮询器 = 创建轮询兜底(标准事件源, 计数回调)
    轮询器.轮询一次()
    定义 结果 = 轮询器.轮询一次()
    断言等于(结果["拉取"], 3)
    断言等于(结果["新事件"], 0)
    断言等于(结果["重复跳过"], 3)
    断言等于(结果["失败"], 0)
    断言等于(派发计数, 3)
    断言等于(轮询器.已见数(), 3)

// 3. 回调对某条抛异常：失败计数=1，其它事件仍派发。
函数 测回调异常隔离()
    异常收到列表 = []
    定义 轮询器 = 创建轮询兜底(标准事件源, 部分失败回调)
    定义 结果 = 轮询器.轮询一次()
    断言等于(结果["拉取"], 3)
    断言等于(结果["新事件"], 2)
    断言等于(结果["重复跳过"], 0)
    断言等于(结果["失败"], 1)
    断言等于(长度(异常收到列表), 3)
    断言为真(包含(异常收到列表, "E-1"))
    断言为真(包含(异常收到列表, "E-3"))

// 4. 事件源抛异常：拉取失败=真、拉取=0，不向上传播。
函数 测事件源异常降级()
    函数 坏事件源()
        定义 空白表 = {}
        定义 坏值 = 空白表["必定不存在的键"]
        返回 []
    定义 轮询器 = 创建轮询兜底(坏事件源, 计数回调)
    定义 结果 = 轮询器.轮询一次()
    断言为真(结果["成功"])
    断言为真(结果["拉取失败"])
    断言等于(结果["拉取"], 0)
    断言等于(结果["新事件"], 0)
    断言等于(结果["失败"], 0)
    断言等于(轮询器.已见数(), 0)

// 5. 去重键稳定性：同键两次相等、不同键不同，且兼容 webhook 归一化键。
函数 测去重键稳定性()
    定义 甲 = 轮询去重键({"外部编号":"E-1", "事件类型":"issues"})
    定义 乙 = 轮询去重键({"外部编号":"E-1", "事件类型":"issues"})
    断言等于(甲, 乙)
    断言等于(长度(甲), 64)
    定义 丙 = 轮询去重键({"外部编号":"E-2", "事件类型":"issues"})
    断言为真(丙 != 甲)
    定义 丁 = 轮询去重键({"消息ID":"E-1", "事件类型":"issues", "话题键":"repo#1"})
    断言等于(丁, 甲)
    定义 戊 = 轮询去重键({})
    断言等于(长度(戊), 64)
    断言为真(戊 != 甲)

// 6. 创建定时轮询：假调度器记录周期调用，调度ID 正确。
函数 测定时轮询假调度器()
    派发计数 = 0
    定义 轮询器 = 创建轮询兜底(标准事件源, 计数回调)
    定义 调度桩 = 调度记录器()
    定义 结果 = 创建定时轮询(轮询器, 1000, 调度桩)
    断言等于(结果["调度ID"], 4242)
    断言为真(结果["调度器"] != 空)
    断言为真(结果["轮询器"] == 轮询器)
    断言等于(长度(调度桩.调用记录), 1)
    断言等于(调度桩.调用记录[0], 1000)
    // 注入的回调可用：调用一次应触发一轮完整派发。
    调度桩.回调()
    断言等于(派发计数, 3)

// 7. 已见数() 与跨调用共享已见集合（用 dict 形态验证兼容）。
函数 测共享已见集合()
    派发计数 = 0
    定义 共享集合 = {}
    定义 轮询甲 = 创建轮询兜底(标准事件源, 计数回调, 共享集合)
    定义 轮询乙 = 创建轮询兜底(标准事件源, 计数回调, 共享集合)
    定义 结果甲 = 轮询甲.轮询一次()
    定义 结果乙 = 轮询乙.轮询一次()
    断言等于(结果甲["新事件"], 3)
    断言等于(结果乙["新事件"], 0)
    断言等于(结果乙["重复跳过"], 3)
    断言等于(派发计数, 3)
    断言等于(轮询甲.已见数(), 3)
    断言等于(轮询乙.已见数(), 3)

运行用例("新事件全部派发", 测新事件全部派发)
运行用例("同一批重复轮询去重", 测重复轮询去重)
运行用例("回调异常隔离", 测回调异常隔离)
运行用例("事件源异常降级", 测事件源异常降级)
运行用例("去重键稳定性", 测去重键稳定性)
运行用例("定时轮询假调度器", 测定时轮询假调度器)
运行用例("已见数与共享集合", 测共享已见集合)

打印("")
打印(测试报告(套件))
如果 套件.failed > 0
    退出(1)
退出(0)
