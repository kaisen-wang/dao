// 更夫 Nightwatch — 常驻 Router 与 IM 第二信道接入测试（第五轮 / L4 测试层）
// 运行：cd 示例/更夫 && python ../../源码/main.py 测试/测试Router接入.道
// 说明：全部用例用道语言内置「测试」标准库编写。断言失败记入套件而不中断后续用例；
//       末尾按失败数显式设置退出码，便于命令行与 CI 直接判定。
// 边界：只验证本地模拟口径——不发起任何真实 HTTP / IM 投递，也不依赖真实 ollama。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 断言包含, 测试报告
从 系统 导入 退出

从 领域层.领域 导入 角色用户, 角色助手, 信道飞书, 信道企微, 召回片段
从 应用层.路由 导入 创建路由
从 应用层.召回 导入 创建召回器, 串联召回
从 基础设施层.即时通信 导入 创建飞书适配器, 创建企微适配器, 归一化事件

// ======================== 测试框架 ========================

定义 套件 = 测试套件("更夫 Router 与 IM 接入测试")
套件.start()

// 运行单个用例：捕获断言失败并记入套件，保证后续用例继续执行。
// 注意：尝试/捕获会吞掉断言失败，所以末尾必须按失败数显式退出(1)。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "全部断言通过", 错误.信息)

// ======================== 用例：Router 会话保持（FR-17） ========================

// 同一会话编号重复开通应幂等：不新增会话，且两次返回同一会话对象。
函数 测会话开通幂等()
    定义 路由 = 创建路由()
    定义 会话甲 = 路由.开通会话("S-幂等", 信道飞书, "话题幂等")
    断言等于(会话甲.会话编号, "S-幂等")
    断言等于(会话甲.话题键, "话题幂等")
    定义 会话乙 = 路由.开通会话("S-幂等", 信道飞书, "话题幂等")
    断言等于(会话乙.会话编号, "S-幂等")
    断言等于(路由.会话数(), 1)
    会话甲.追加消息(角色用户, "幂等探针")
    断言等于(会话乙.消息数(), 1)

// 消息追加维护计数，最近消息按时间倒序截取指定条数。
函数 测消息追加与最近消息()
    定义 路由 = 创建路由()
    定义 会话对象 = 路由.开通会话("S-消息", 信道飞书, "话题消息")
    会话对象.追加消息(角色用户, "第一条")
    会话对象.追加消息(角色助手, "第二条")
    会话对象.追加消息(角色用户, "第三条")
    断言等于(会话对象.消息数(), 3)
    定义 最近 = 会话对象.最近消息(2)
    断言等于(长度(最近), 2)
    断言等于(最近[0].内容, "第二条")
    断言等于(最近[1].内容, "第三条")
    断言等于(最近[1].角色, 角色用户)

// 命中「请修复/崩溃」等建单意图时生成工单编号，回复与计数齐备。
函数 测建单意图命中()
    定义 路由 = 创建路由()
    路由.开通会话("S-建单", 信道飞书, "话题建单")
    定义 响应 = 路由.收消息("S-建单", "请修复登录崩溃问题", 信道飞书, "张三")
    断言为真(响应["成功"])
    断言等于(响应["会话编号"], "S-建单")
    断言为真(响应["工单编号"] != "" 并且 响应["工单编号"] != 空)
    断言为真(响应["消息数"] >= 1)
    断言为真(长度(响应["回复"]) > 0)

// 非建单消息仅记录、不建单，并给出非空中文确认回复。
函数 测非建单仅记录()
    定义 路由 = 创建路由()
    路由.开通会话("S-闲聊", 信道飞书, "话题闲聊")
    定义 响应 = 路由.收消息("S-闲聊", "今天天气不错", 信道飞书, "李四")
    断言为真(响应["成功"])
    定义 工单号 = 响应["工单编号"]
    断言为真(工单号 == "" 或者 工单号 == 空)
    // 收消息会写入用户消息与助手确认回复各一条，共 2 条。
    断言等于(响应["消息数"], 2)
    断言为真(长度(响应["回复"]) > 0)

// 批处理逐条调用收消息，返回等长响应列表且不新增会话。
函数 测批处理()
    定义 路由 = 创建路由()
    路由.开通会话("S-批", 信道飞书, "话题批")
    定义 消息列表 = ["请修复缺陷", "请处理超时", "随便聊聊"]
    定义 结果 = 路由.批处理(消息列表, "S-批", 信道飞书)
    断言等于(长度(结果), 3)
    定义 成功列表 = []
    遍历 项 在 结果
        如果 项["成功"]
            追加(成功列表, 项)
    断言等于(长度(成功列表), 3)
    断言等于(路由.会话数(), 1)

// 统一回复取最近助手消息拼成中文文本；无会话返回中文提示（两者均非空）。
函数 测统一回复()
    定义 路由 = 创建路由()
    路由.开通会话("S-回复", 信道飞书, "话题回复")
    路由.收消息("S-回复", "请修复问题", 信道飞书, "张三")
    定义 文本 = 路由.统一回复("S-回复")
    断言为真(长度(文本) > 0)
    定义 提示 = 路由.统一回复("S-不存在的会话")
    断言为真(长度(提示) > 0)

// 同一话题下跨会话消息可被全局记忆汇总到。
函数 测跨会话全局记忆()
    定义 路由 = 创建路由()
    路由.开通会话("S-全1", 信道飞书, "共同话题")
    路由.开通会话("S-全2", 信道企微, "共同话题")
    路由.收消息("S-全1", "请修复甲问题", 信道飞书, "张三")
    路由.收消息("S-全2", "请处理乙问题", 信道企微, "李四")
    // 两条会话消息，且跨了飞书与企微两个信道。
    定义 记忆 = 路由.全局记忆("共同话题")
    断言为真(长度(记忆) >= 2)

// 不传语言模型时静默降级：不抛异常，回复带「关键词规则」标记。
函数 测路由无语言模型降级()
    定义 路由 = 创建路由()
    路由.开通会话("S-降级", 信道飞书, "话题降级")
    定义 响应 = 路由.收消息("S-降级", "请修复崩溃", 信道飞书, "赵六")
    断言为真(响应["成功"])
    断言包含(响应["回复"], "关键词规则")

// ======================== 用例：链式召回 ========================

// 空存储与非法参数均降级为空列表，不抛异常；三类查询入口均可用。
函数 测召回器降级路径()
    定义 召回器 = 创建召回器()
    断言等于(长度(召回器.按工单("T-不存在")), 0)
    断言等于(长度(召回器.按话题("Th-不存在")), 0)
    断言等于(长度(召回器.按关键词(["不存在"])), 0)
    // 空参数校验失败同样降级。
    断言等于(长度(召回器.按工单("")), 0)
    断言等于(长度(召回器.按关键词([])), 0)

// 串联召回以首片段为起点扩出相关片段：去重、按相关度降序、空输入返回空。
函数 测串联召回去重与跳数()
    定义 共同片段 = 召回片段("工单", "T-串联", "登录失败", 0.9)
    定义 片段列表 = [
        共同片段,
        召回片段("决策", "D-串联", "登录失败相关决策", 0.8),
        共同片段,
        召回片段("报告", "R-串联", "无关内容", 0.1)
    ]
    定义 结果 = 串联召回(片段列表, 2)
    断言为真(长度(结果) >= 1)
    // 去重：完全相同的片段（内容同为「登录失败」）只出现一次。
    定义 命中列表 = []
    遍历 片 在 结果
        如果 片.内容 == "登录失败"
            追加(命中列表, 片)
    断言等于(长度(命中列表), 1)
    // 相关度降序。
    如果 长度(结果) >= 2
        断言为真(结果[0].相关度 >= 结果[1].相关度)
    // 空输入返回空列表。
    断言等于(长度(串联召回([], 3)), 0)

// ======================== 用例：IM 事件归一化 ========================

// 飞书事件归一化为统一字典；语法糖等价；缺字段时返回中文错误而非抛异常。
函数 测飞书事件归一化()
    定义 适配器 = 创建飞书适配器()
    定义 事件 = {
        "header": {"event_id": "E-飞书-1"},
        "event": {
            "message": {"message_id": "M-飞书-1", "content": "请修复崩溃"},
            "sender": {"sender_id": {"open_id": "张三"}},
            "chat_id": "Th-飞书-1"
        }
    }
    定义 结果 = 适配器.解析消息(事件)
    断言为真(结果["成功"])
    断言等于(结果["来源信道"], 信道飞书)
    断言为真(长度(结果["文本"]) > 0)
    定义 语法糖结果 = 归一化事件(适配器, 事件)
    断言为真(语法糖结果["成功"])
    断言等于(语法糖结果["文本"], 结果["文本"])
    // 缺字段降级。
    定义 坏结果 = 适配器.解析消息({"event": {}})
    断言为假(坏结果["成功"])
    断言为真(长度(坏结果["错误"]) > 0)

// 企微事件归一化为统一字典；缺字段时返回中文错误而非抛异常。
函数 测企微事件归一化()
    定义 适配器 = 创建企微适配器()
    定义 事件 = {
        "FromUserName": "李四",
        "Content": "请处理超时",
        "ChatId": "Th-企微-1",
        "MsgId": "M-企微-1"
    }
    定义 结果 = 适配器.解析消息(事件)
    断言为真(结果["成功"])
    断言等于(结果["来源信道"], 信道企微)
    断言为真(长度(结果["文本"]) > 0)
    断言等于(结果["发送人"], "李四")
    // 缺 Content 字段时降级。
    定义 坏结果 = 适配器.解析消息({"FromUserName": "李四"})
    断言为假(坏结果["成功"])
    断言为真(长度(坏结果["错误"]) > 0)

// 本地模式恒可用；回复消息标记本地模拟；非本地凭据不全不可用；未@不生成触发。
函数 测适配器本地模式与降级()
    定义 飞书 = 创建飞书适配器("app-id", "app-secret", 真)
    定义 企微 = 创建企微适配器("corp-id", "app-secret", 真)
    断言为真(飞书.可用())
    断言为真(企微.可用())
    // 本地回复只返回待发送字典，不发真实 HTTP。
    定义 回复 = 飞书.回复消息("Th-本地", "已收到")
    断言为真(回复["成功"])
    断言等于(回复["已回复"], "已收到")
    断言为真(回复["本地模拟"])
    // 非本地模式仅当凭据齐全可用；空凭据不可用。
    定义 空凭据 = 创建飞书适配器("", "", 假)
    断言为假(空凭据.可用())
    // 未@机器人的普通消息不生成触发。
    定义 普通事件 = {"FromUserName": "王五", "Content": "普通消息", "ChatId": "Th-普通"}
    定义 触 = 企微.生成触发(普通事件)
    断言等于(触, 空)

