// 更夫 Nightwatch — observe 一周审计本地压缩模拟测试（第七轮 / PRD §12 第 6 项）
//
// 运行方式：
//   cd 示例/更夫 && python ../../源码/main.py 测试/测试观察审计.道
//
// 诚实边界：这是本地压缩模拟，不等于真实一周 observe 运行；
//           通过本测试不代表真实环境已验证，不勾选 PRD §12 任何 DoD 项。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 断言包含, 测试报告
从 系统 导入 退出
从 编码 导入 JSON
从 应用层.观察审计 导入 创建观察审计

定义 套件 = 测试套件("observe 一周审计本地压缩模拟")
套件.start()

// ======================== 构造压缩的一周模拟事件流 ========================
// 7 天 × 若干条，四类组合齐全。设计目标（累计）：
//   正确接受 9 / 误接受 3 / 正确忽略 17 / 误忽略 1，总数 30。
//   误接受率 = 3 / (17 + 3) = 0.15；误忽略率 = 1 / (9 + 1) = 0.1。
定义 每天正确接受 = [1, 1, 1, 1, 1, 2, 2]
定义 每天误接受 = [0, 1, 0, 1, 0, 1, 0]
定义 每天正确忽略 = [3, 2, 3, 2, 3, 2, 2]
定义 每天误忽略 = [0, 0, 0, 0, 1, 0, 0]

// 事件流元素：{"事件": 事件字典, "结论": 准入结论布尔, "实际": 实际是否应接受布尔}
定义 事件流 = []
遍历 天 从 1 到 7
    定义 索引 = 天 - 1
    遍历 i 从 1 到 每天正确接受[索引]
        追加(事件流, {"事件": {"事件ID": `D{天}-正接-{i}`, "时间": `第{天}天`}, "结论": 真, "实际": 真})
    遍历 i 从 1 到 每天误接受[索引]
        追加(事件流, {"事件": {"事件ID": `D{天}-误接-{i}`, "时间": `第{天}天`}, "结论": 真, "实际": 假})
    遍历 i 从 1 到 每天正确忽略[索引]
        追加(事件流, {"事件": {"事件ID": `D{天}-正忽-{i}`, "时间": `第{天}天`}, "结论": 假, "实际": 假})
    遍历 i 从 1 到 每天误忽略[索引]
        追加(事件流, {"事件": {"事件ID": `D{天}-误忽-{i}`, "时间": `第{天}天`}, "结论": 假, "实际": 真})

定义 审计 = 创建观察审计()
遍历 条目 在 事件流
    审计.记录事件(条目["事件"], 条目["结论"], 条目["实际"])

// ======================== 用例 1：事件流规模与四类计数 ========================
尝试
    断言等于(30, 长度(事件流))
    定义 报告 = 审计.生成报告()
    断言等于(30, 报告["总数"])
    断言等于(9, 报告["正确接受"])
    断言等于(3, 报告["误接受"])
    断言等于(17, 报告["正确忽略"])
    断言等于(1, 报告["误忽略"])
    套件.record_pass("压缩一周四类计数与总数")
捕获 错误
    套件.record_fail("压缩一周四类计数与总数", 文本(错误))

// ======================== 用例 2：两个比率与公式 ========================
尝试
    定义 报告二 = 审计.生成报告()
    断言等于(0.15, 报告二["误接受率"])
    断言等于(0.1, 报告二["误忽略率"])
    // 直接调用方法，验证与报告一致
    断言等于(0.15, 审计.误接受率())
    断言等于(0.1, 审计.误忽略率())
    套件.record_pass("误接受率与误忽略率公式")
捕获 错误
    套件.record_fail("误接受率与误忽略率公式", 文本(错误))

// ======================== 用例 3：报告含中文说明与压缩模拟口径 ========================
尝试
    定义 报告三 = 审计.生成报告()
    断言包含(报告三, "总数")
    断言包含(报告三, "误接受率")
    断言包含(报告三, "说明")
    断言包含(报告三["说明"], "压缩模拟 ≠ 真实一周运行")
    套件.record_pass("报告字段与压缩模拟说明")
捕获 错误
    套件.record_fail("报告字段与压缩模拟说明", 文本(错误))

// ======================== 用例 4：JSON 导出可解析且字段中文 ========================
尝试
    定义 文本结果 = 审计.导出JSON()
    定义 解析结果 = JSON.解码(文本结果)
    断言等于(30, 解析结果["总数"])
    断言等于(9, 解析结果["正确接受"])
    断言等于(3, 解析结果["误接受"])
    断言等于(17, 解析结果["正确忽略"])
    断言等于(1, 解析结果["误忽略"])
    断言等于(0.15, 解析结果["误接受率"])
    断言等于(0.1, 解析结果["误忽略率"])
    断言包含(解析结果, "说明")
    套件.record_pass("JSON导出可解析")
捕获 错误
    套件.record_fail("JSON导出可解析", 文本(错误))

// ======================== 用例 5：分母为 0 时降级返回 0.0 ========================
尝试
    定义 空审计 = 创建观察审计()
    断言等于(0.0, 空审计.误接受率())
    断言等于(0.0, 空审计.误忽略率())
    定义 空报告 = 空审计.生成报告()
    断言等于(0, 空报告["总数"])
    断言等于(0.0, 空报告["误接受率"])
    断言等于(0.0, 空报告["误忽略率"])
    套件.record_pass("全空审计分母为0降级")
捕获 错误
    套件.record_fail("全空审计分母为0降级", 文本(错误))

// ======================== 用例 6：单类事件时另一个分母为 0 仍降级 ========================
尝试
    定义 单边审计 = 创建观察审计()
    遍历 i 从 1 到 4
        单边审计.记录事件({"事件ID": `单-{i}`}, 真, 真)
    // 仅有正确接受：误忽略率分母 = 4 + 0，结果 0.0；误接受率分母 = 0 + 0，结果 0.0。
    断言等于(4, 单边审计.生成报告()["正确接受"])
    断言等于(0.0, 单边审计.误忽略率())
    断言等于(0.0, 单边审计.误接受率())
    套件.record_pass("单类事件分母为0降级")
捕获 错误
    套件.record_fail("单类事件分母为0降级", 文本(错误))

// ======================== 用例 7：缺字段事件字典降级不抛异常 ========================
尝试
    定义 降级审计 = 创建观察审计()
    // 空字典、非字典、仅含部分字段三种输入均不应抛异常，且照常计入总数。
    降级审计.记录事件({}, 真, 假)
    降级审计.记录事件(空, 假, 假)
    降级审计.记录事件({"事件ID": "仅编号"}, 假, 真)
    断言等于(3, 降级审计.生成报告()["总数"])
    断言等于(1, 降级审计.生成报告()["误接受"])
    断言等于(1, 降级审计.生成报告()["正确忽略"])
    断言等于(1, 降级审计.生成报告()["误忽略"])
    套件.record_pass("缺字段降级不抛异常")
捕获 错误
    套件.record_fail("缺字段降级不抛异常", 文本(错误))

定义 结果 = 测试报告(套件)
打印(结果)
如果 套件.failed > 0
    退出(1)
