// 更夫 Nightwatch — 混沌测试脚手架（第四轮「可靠性工程」子代理 A）
// 运行：cd 示例/更夫 && python ../../源码/main.py 测试/测试混沌.道
// 职责：以道语言「测试」标准库的函数式 API 模拟重复投递、进程崩溃后的悬挂绑定、
//       断网降级、预算超额熔断、Outbox 重复入队、全局暂停切换等故障场景，
//       验证「恢复率 100%、外部消息 0 丢失 0 重复」的可靠性目标。
// 对应：PRD《常驻研发协作 Agent》§12 DoD「混沌测试」；
//       迭代规约-可靠性.md §3（已具备能力）/§4（子代理 A）/§9（编码与验收规范）。
// 注意：断言被「尝试/捕获」吃掉后脚本仍退出 0，故末尾必须按失败数显式退出(1)。

从 测试 导入 测试套件, 断言等于, 断言不等于, 断言为真, 断言为假, 断言包含, 测试报告
从 系统 导入 取环境变量, 设环境变量, 退出

从 领域层.领域 导入 工单, 触发, 执行绑定, 建报告, 推导阶段, 可重开
从 领域层.领域 导入 阶段排队, 阶段执行中, 阶段待审核, 阶段结束
从 领域层.领域 导入 报告就绪, 模式审计, 模式关闭
从 领域层.领域 导入 准入显式, 准入忽略, 准入机器人

从 应用层.准入 导入 创建准入器, 是噪音
从 应用层.授权 导入 授予, 校验, 拒绝扩权
从 应用层.评估 导入 创建评估器
从 应用层.调度 导入 创建预算
从 应用层.恢复 导入 恢复检查点

从 基础设施层.存储 导入 打开存储, 保存工单, 保存触发, 列出触发, 列出工单, 投递入队, 待投递列表
从 基础设施层.看板 导入 处理暂停
从 基础设施层.语言模型 导入 创建语言模型

// ======================== 测试框架 ========================

定义 套件 = 测试套件("更夫 Nightwatch 混沌测试")
套件.start()

// 运行单个用例：捕获断言失败并记入套件，保证后续用例继续执行。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "用例内全部断言应通过", 错误.信息)

// ======================== 1. 重复投递幂等 ========================

函数 测重复投递幂等()
    // 同一触发连续保存 10 次：仅第一次为真，且库中该去重键只留一条。
    打开存储(":memory:")
    定义 触 = 触发("本地CI", "E-混沌-幂等", "Th-混沌-幂等", "张三", "@更夫 请修复缺陷")
    定义 去重键 = 触.去重键()
    定义 首次结果 = 假
    遍历 i 从 1 到 10
        定义 本次 = 保存触发(触)
        如果 i == 1
            首次结果 = 本次
        否则
            断言为假(本次)
    断言为真(首次结果)
    定义 触列表 = 列出触发()
    断言等于(长度(触列表), 1)
    断言等于(触列表[0].去重键(), 去重键)

// ======================== 2. 崩溃恢复 ========================

函数 测崩溃恢复()
    // 构造含未结束绑定与未交付输入的工单落库，模拟进程崩溃后重启检查点。
    打开存储(":memory:")
    定义 单 = 工单("T-混沌-恢复", "崩溃恢复工单", "本地CI", "E-混沌-恢复", "张三", "构建失败：测试红灯", 模式审计)
    定义 绑定对象 = 执行绑定(单.编号, "张三", 1)
    绑定对象.开始()
    单.绑定 = 绑定对象
    单.加入输入("崩溃前未交付的输入")
    断言为真(保存工单(单))
    定义 工单数 = 长度(列出工单())
    断言等于(工单数, 1)

    定义 结果 = 恢复检查点()
    断言为真(结果["结束绑定数"] >= 1)
    断言为真(结果["补投数"] >= 工单数)
    断言包含(结果["说明"], "恢复完成")

    // 回读持久化状态：绑定须已 ended，未交付输入须包含恢复补投。
    定义 恢复后工单 = 列出工单()
    遍历 单二 在 恢复后工单
        断言不等于(单二.绑定, 空)
        断言等于(单二.绑定.状态, "ended")
        断言为真(单二.待交付数() >= 2)

// ======================== 3. 断网降级 ========================

函数 测断网降级()
    // 把 OLLAMA_HOST 指向不可达地址，验证 .对话()/.判断() 返回字典且不抛异常。
    定义 原主机 = 取环境变量("OLLAMA_HOST", "")
    设环境变量("OLLAMA_HOST", "http://127.0.0.1:1")
    定义 模型 = 创建语言模型()
    定义 对话结果 = 模型.对话("混沌断网测试：请回复一句话")
    定义 判断结果 = 模型.判断("混沌断网测试：只输出 JSON", "只输出 JSON 对象")
    设环境变量("OLLAMA_HOST", 原主机)

    断言等于("字典", 取类型(对话结果))
    断言为假(对话结果["成功"])
    断言等于("字典", 取类型(判断结果))
    断言为假(判断结果["成功"])

// ======================== 4. 预算熔断 ========================

函数 测预算熔断()
    // 单票调用上限 2：第三次记账被拒，用量仍为 2。
    定义 预算器 = 创建预算(2, 100, 5.0, 0.01)
    断言为真(预算器.记账("T-混沌-熔断", 1, 0))
    断言为真(预算器.记账("T-混沌-熔断", 1, 0))
    断言为假(预算器.记账("T-混沌-熔断", 1, 0))
    定义 用量字典 = 预算器.用量("T-混沌-熔断")
    断言等于(用量字典["调用次数"], 2)
    断言等于(用量字典["token数"], 0)

// ======================== 5. Outbox 幂等 ========================

函数 测Outbox幂等()
    // 同一幂等键两次入队只产生一条待投递消息。
    打开存储(":memory:")
    定义 幂等键 = "混沌-outbox-idem-key"
    定义 投递一 = 投递入队("T-混沌-投递", "通知", "第一次投递", 幂等键)
    定义 投递二 = 投递入队("T-混沌-投递", "通知", "重复投递内容不同", 幂等键)
    断言等于(投递一, 投递二)
    断言等于(长度(待投递列表()), 1)

// ======================== 6. 暂停切换 ========================

函数 测暂停切换()
    // 全局暂停开关切换须改写状态字典并返回带中文提示的响应。
    定义 状态 = {"暂停中": 假, "模式": 模式审计}
    定义 暂停响应 = 处理暂停(状态, {})
    断言等于(暂停响应["状态码"], 200)
    断言为真(状态["暂停中"])
    断言包含(暂停响应["内容"], "暂停")

    定义 恢复响应 = 处理暂停(状态, {})
    断言等于(恢复响应["状态码"], 200)
    断言为假(状态["暂停中"])
    断言包含(恢复响应["内容"], "恢复")

// ======================== 7. 噪音不建单 ========================

函数 测噪音不建单()
    // 空内容、纯符号、已知噪音短语一律忽略，不会进入建单流程。
    断言为真(是噪音(""))
    断言为真(是噪音("   "))
    断言为真(是噪音("！！！"))
    断言为真(是噪音("收到"))
    断言为假(是噪音("@更夫 请修复缺陷"))

    定义 准入器 = 创建准入器(["维护者"])
    定义 噪音触 = 触发("本地", "E-混沌-噪音", "Th-混沌-噪音", "路人", "收到")
    断言等于(准入器.判定(噪音触), 准入忽略)
    定义 显式触 = 触发("本地", "E-混沌-显式", "Th-混沌-显式", "维护者", "请修复登录缺陷")
    断言等于(准入器.判定(显式触), 准入显式)

// ======================== 8. 越权不扩权 ========================

函数 测越权不扩权()
    // 授权不可变：越权请求被拒，须重新授权，既有范围不被扩大。
    定义 单 = 工单("T-混沌-授权", "越权测试", "本地", "E-混沌-授权", "张三", "测试内容", 模式审计)
    定义 授 = 授予(单, "张三", "v0.1", ["修复", "测试"])
    断言为真(校验(授, ["修复"]))
    断言为假(校验(授, ["发布上线"]))
    定义 拒决 = 拒绝扩权(单, ["发布上线"], "路人")
    断言等于(拒决.结论, "needs_reauth")
    断言包含(拒决.理由, "越权不自动扩权")
    断言等于(长度(授.范围), 2)

// ======================== 9. 重开规则拒绝 bot ========================

函数 测重开规则拒绝bot()
    // 仅人工且授权内的消息可重开 ended 工单；机器人/CI 一律拒绝。
    定义 单 = 工单("T-混沌-重开", "重开规则测试", "本地", "E-混沌-重开", "张三", "测试内容", 模式审计)
    断言为假(可重开(单, "人工", 真))
    单.阶段 = 阶段结束
    断言为假(可重开(单, "机器人", 真))
    断言为假(可重开(单, "CI", 真))
    断言为假(可重开(单, "人工", 假))
    断言为真(可重开(单, "人工", 真))

// ======================== 10. 阶段推导优先级 ========================

函数 测阶段推导优先级()
    // 未交付输入 > 报告结论 > 绑定运行中 > 排队。
    定义 未交付单 = 工单("T-阶段-未交付", "未交付优先", "本地", "E-阶段-1", "张三", "内容", 模式审计)
    未交付单.加入输入("尚未交付")
    定义 就绪报 = 建报告("T-阶段-未交付", 报告就绪, "执行完成")
    断言等于(推导阶段(未交付单, [就绪报]), 阶段排队)

    定义 待审核单 = 工单("T-阶段-审核", "报告优先", "本地", "E-阶段-2", "张三", "内容", 模式审计)
    断言等于(推导阶段(待审核单, [就绪报]), 阶段待审核)

    定义 执行单 = 工单("T-阶段-执行", "绑定优先", "本地", "E-阶段-3", "张三", "内容", 模式审计)
    定义 绑定对象 = 执行绑定(执行单.编号, "张三", 1)
    绑定对象.开始()
    执行单.绑定 = 绑定对象
    断言等于(推导阶段(执行单, []), 阶段执行中)

    定义 排队单 = 工单("T-阶段-排队", "默认排队", "本地", "E-阶段-4", "张三", "内容", 模式审计)
    断言等于(推导阶段(排队单, []), 阶段排队)

// ======================== 11. 评估器关键词降级 ========================

函数 测评估器关键词降级()
    // 不传语言模型时走关键词规则；模式关闭时只记录不建单。
    定义 规则列表 = [{"名称": "CI失败修复", "关键词": ["构建失败", "红灯"], "结论": "would_accept", "范围": []}]
    定义 评估器 = 创建评估器(规则列表, "v0.1", 空)
    定义 触 = 触发("本地CI", "E-混沌-评估", "Th-混沌-评估", "ci-bot", "构建失败：测试红灯", 假, 真)
    定义 决 = 评估器.评估(触, 模式审计)
    断言等于(决.结论, "would_accept")
    断言包含(决.理由, "关键词规则：")
    定义 关闭决 = 评估器.评估(触, 模式关闭)
    断言等于(关闭决.结论, "would_ignore")

