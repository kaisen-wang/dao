// 更夫 Nightwatch — 第七轮 GitHub 事件源适配器自检（临时脚本，放 /tmp，不污染项目目录）
// 运行：cd 示例/更夫 && python ../../源码/main.py /tmp/测GitHub事件.道
// 边界：全部本地模拟，不发起任何真实请求、不做真实 merge。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 测试报告
从 系统 导入 退出
从 密码 导入 HMACSHA256
从 基础设施层.GitHub事件 导入 创建GitHub适配器, 验签GitHub请求

定义 套件 = 测试套件("更夫 GitHub 事件源适配器自检")
套件.start()

函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "全部断言通过", 错误.信息)

// ======================== 三类事件归一化 ========================

函数 测issues打开()
    定义 载荷 = {
        "action": "opened",
        "issue": {"id": 1001, "number": 12, "title": "修复崩溃", "body": "这里会崩", "user": {"login": "alice"}},
        "repository": {"full_name": "owner/repo"}
    }
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言等于("github", 结果["来源信道"])
    断言等于("issues.opened", 结果["事件类型"])
    断言等于("1001", 结果["消息ID"])
    断言等于("这里会崩", 结果["文本"])
    断言等于("alice", 结果["发送人"])
    断言等于("owner/repo#12", 结果["话题键"])
    断言为假(结果["是否@机器人"])
    断言为假(结果["已合并"])

函数 测issues编辑()
    定义 载荷 = {
        "action": "edited",
        "issue": {"number": 13, "body": "补充描述", "user": {"login": "bob"}},
        "repository": {"full_name": "org/proj"}
    }
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言等于("issues.edited", 结果["事件类型"])
    断言等于("补充描述", 结果["文本"])

函数 测PR打开()
    定义 载荷 = {
        "action": "opened",
        "pull_request": {"id": 2001, "number": 7, "body": "新增特性", "merged": 假, "user": {"login": "carol"}},
        "repository": {"full_name": "org/proj"}
    }
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言等于("pull_request.opened", 结果["事件类型"])
    断言等于("新增特性", 结果["文本"])
    断言等于("carol", 结果["发送人"])
    断言为假(结果["已合并"])

函数 测PR同步()
    定义 载荷 = {
        "action": "synchronize",
        "pull_request": {"number": 8, "title": "同步标题", "user": {"login": "dave"}},
        "repository": {"full_name": "org/proj"}
    }
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言等于("pull_request.synchronize", 结果["事件类型"])
    断言等于("同步标题", 结果["文本"])

函数 测评论归一化与艾特()
    定义 载荷 = {
        "action": "created",
        "issue": {"number": 9, "title": "讨论"},
        "comment": {"id": 3001, "body": "@更夫 请修复这个问题", "user": {"login": "eve"}},
        "repository": {"full_name": "org/proj"}
    }
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言等于("issue_comment.created", 结果["事件类型"])
    断言为真(结果["是否@机器人"])
    断言等于("@更夫 请修复这个问题", 结果["文本"])
    断言等于("eve", 结果["发送人"])
    断言等于("org/proj#9", 结果["话题键"])

// ======================== merged 信号 ========================

函数 测PR合并信号()
    定义 载荷 = {
        "action": "closed",
        "pull_request": {"number": 10, "title": "合并请求", "body": "done", "merged": 真, "user": {"login": "frank"}},
        "repository": {"full_name": "org/proj"}
    }
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言等于("pull_request.closed", 结果["事件类型"])
    断言为真(结果["已合并"])

函数 测PR关闭未合并()
    定义 载荷 = {"action": "closed", "pull_request": {"number": 11, "merged": 假}, "repository": {"full_name": "org/proj"}}
    定义 结果 = 创建GitHub适配器().解析事件(载荷)
    断言为真(结果["成功"])
    断言为假(结果["已合并"])

// ======================== 验签 ========================

函数 测验签正确()
    定义 体 = "{\"action\":\"opened\"}"
    定义 签 = HMACSHA256("密钥", 体)
    定义 请求 = {"请求头": {"X-Hub-Signature-256": "sha256=" + 签}, "请求体": 体}
    断言为真(验签GitHub请求(请求, "密钥"))

函数 测验签错误()
    定义 体 = "{\"action\":\"opened\"}"
    定义 请求 = {"请求头": {"X-Hub-Signature-256": "sha256=" + HMACSHA256("别的密钥", 体)}, "请求体": 体}
    断言为假(验签GitHub请求(请求, "密钥"))
    定义 无头 = {"请求头": {}, "请求体": 体}
    断言为假(验签GitHub请求(无头, "密钥"))
    断言为假(验签GitHub请求(请求, ""))

函数 测验签头大小写与前缀()
    定义 体 = "{}"
    定义 签 = HMACSHA256("密钥", 体)
    // 头名小写、前缀大写均应兼容
    定义 请求 = {"请求头": {"x-hub-signature-256": "SHA256=" + 签}, "请求体": 体}
    断言为真(验签GitHub请求(请求, "密钥"))

函数 测本地模式验签放行()
    定义 适配器 = 创建GitHub适配器()
    定义 垃圾请求 = {"请求头": {}, "请求体": "随便"}
    断言为真(适配器.验证签名(垃圾请求, "任意密钥"))
    // 同一请求在非本地模式下不放行
    断言为假(验签GitHub请求(垃圾请求, "任意密钥"))
    定义 真实适配器 = 创建GitHub适配器("owner/repo", "令牌", 假)
    断言为假(真实适配器.验证签名(垃圾请求, "任意密钥"))

// ======================== 可用性与触发 ========================

函数 测可用性()
    断言为真(创建GitHub适配器().可用())
    断言为假(创建GitHub适配器("", "", 假).可用())
    断言为假(创建GitHub适配器("", "令牌", 假).可用())
    断言为假(创建GitHub适配器("owner/repo", "", 假).可用())
    断言为真(创建GitHub适配器("owner/repo", "令牌", 假).可用())

函数 测艾特触发()
    定义 载荷 = {
        "action": "created",
        "issue": {"number": 9},
        "comment": {"id": 3001, "body": "@更夫 请修复", "user": {"login": "eve"}},
        "repository": {"full_name": "org/proj"}
    }
    定义 触 = 创建GitHub适配器().生成触发(载荷)
    断言为假(触 == 空)
    断言等于("github", 触.来源)
    断言等于("3001", 触.外部编号)
    断言等于("org/proj#9", 触.话题编号)
    断言等于("eve", 触.发起人)
    断言等于("@更夫 请修复", 触.内容)
    断言为真(触.是否机器人)
    断言为假(触.是否CI)

函数 测非艾特不触发()
    定义 载荷 = {"action": "opened", "issue": {"number": 1, "body": "普通反馈", "user": {"login": "x"}}, "repository": {"full_name": "o/r"}}
    断言为真(创建GitHub适配器().生成触发(载荷) == 空)

函数 测显式请求触发()
    定义 载荷 = {
        "action": "opened",
        "issue": {"number": 2, "body": "无艾特但显式请求", "user": {"login": "y"}},
        "repository": {"full_name": "o/r"},
        "显式请求": 真
    }
    断言为假(创建GitHub适配器().生成触发(载荷) == 空)

// ======================== 缺字段降级 ========================

函数 测缺字段降级()
    定义 空载荷结果 = 创建GitHub适配器().解析事件({})
    断言为假(空载荷结果["成功"])
    断言等于("github", 空载荷结果["来源信道"])
    断言等于("", 空载荷结果["文本"])
    断言为假(空载荷结果["是否@机器人"])
    // issue 结构在但内部字段全缺：不应抛异常，仍返回统一键
    定义 缺字段结果 = 创建GitHub适配器().解析事件({"action": "opened", "issue": {}})
    断言为真(缺字段结果["成功"])
    断言等于("issues.opened", 缺字段结果["事件类型"])
    断言等于("", 缺字段结果["文本"])
    断言等于("", 缺字段结果["发送人"])
    断言等于("", 缺字段结果["话题键"])
    // 非字典输入降级
    断言为假(创建GitHub适配器().解析事件("不是字典")["成功"])

函数 测缺字段生成触发不抛异常()
    // 缺字段但非艾特应安全返回空，不抛异常
    断言为真(创建GitHub适配器().生成触发({}) == 空)

// ======================== 回复载荷 ========================

函数 测回复载荷不发请求()
    定义 载荷 = 创建GitHub适配器().回复消息("org/proj#9", "已收到")
    断言为真(载荷["成功"])
    断言为真(载荷["待发送"])
    断言等于("github", 载荷["来源信道"])
    断言等于("org/proj#9", 载荷["话题键"])
    断言等于("已收到", 载荷["内容"])
    断言为真(载荷["本地模拟"])
    // 只返回字典载荷，不含真实请求动作字段
    断言为真(载荷["待发送"])

