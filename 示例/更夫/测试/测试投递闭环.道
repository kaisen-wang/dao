// 更夫 Nightwatch — 第十二轮 A：Outbox 投递闭环同进程单测（共享契约 §2 A）。
// 运行：cd 示例/更夫 && GENGFU_NO_LLM=1 python ../../源码/main.py 测试/测试投递闭环.道
// 用注入的假请求函数（签名与 网络.请求 一致，返回带 .状态码 的对象）验证投递成功标记、
// 断网异常保留 pending、恢复补发、幂等键重复只标一次、非 2xx 失败明细中文等 ≥8 用例。
//
// 诚实边界：本文件是同进程注入假请求的单测，不经真实 HTTP；真实回环见
//          源码/tests/test_outbox_http_delivery.py。本机回环 sink ≠ 真实平台 webhook，
//          验证的 0 丢失 0 重复是本机口径，不勾选 PRD §12 任何 DoD 项。

从 测试 导入 测试套件, 断言等于, 断言为真, 断言为假, 测试报告
从 系统 导入 退出
从 文件 导入 存在, 删除
从 编码 导入 JSON
从 基础设施层.存储 导入 打开存储, 投递入队, 待投递列表
从 基础设施层.投递执行器 导入 创建投递器

定义 套件 = 测试套件("更夫 Outbox 投递闭环同进程测试（第十二轮 A）")
套件.start()

// 每个用例独立库路径，放系统临时目录，项目目录不产生 .db。
定义 库前缀 = "/tmp/更夫投递闭环_"

函数 新建库(路径)
    如果 存在(路径)
        删除(路径)
    如果 存在(路径 + "-wal")
        删除(路径 + "-wal")
    如果 存在(路径 + "-shm")
        删除(路径 + "-shm")
    返回 打开存储(路径)

函数 清理库(路径)
    如果 存在(路径)
        删除(路径)
    如果 存在(路径 + "-wal")
        删除(路径 + "-wal")
    如果 存在(路径 + "-shm")
        删除(路径 + "-shm")

// 假响应：只需暴露 .状态码，与 网络.请求 的响应对象同口径。
类型 假响应
    初始化(状态码=200)
        本对象.状态码 = 状态码

// 假 sink：在线=假时抛异常模拟断网；在线=真时按状态码返回并记录载荷。
// 状态挂在实例上，每个用例新建实例即可隔离，无需修改模块级变量。
类型 假sink
    初始化(在线=真, 状态码覆盖=200)
        本对象.在线 = 在线
        本对象.状态码覆盖 = 状态码覆盖
        本对象.收到的键 = []
        本对象.收到的载荷 = []

    函数 请求(URL, 选项)
        如果 本对象.在线 == 假
            抛出 运行时错误("模拟断网：连接被拒绝")
        定义 载荷 = JSON.解码(选项["数据"])
        追加(本对象.收到的键, 载荷["幂等键"])
        追加(本对象.收到的载荷, 载荷)
        返回 假响应(本对象.状态码覆盖)

// 运行单个用例：任一断言失败都记入套件并继续后续用例。
函数 运行用例(名称, 用例函数)
    尝试
        用例函数()
        套件.record_pass(名称)
    捕获 错误
        套件.record_fail(名称, "全部断言通过", 文本(错误))

// 用例 1：成功投递后标记，pending 清零，sink 收到该幂等键。
函数 用例成功标记()
    定义 路径 = 库前缀 + "1.db"
    新建库(路径)
    定义 键 = "闭环-成功-1"
    投递入队("T-闭环-1", "通知", "载荷1", 键)
    定义 sink = 假sink(真, 200)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(sink.请求)
    断言等于(1, 结果["成功"])
    断言等于(0, 结果["失败"])
    断言等于(0, 结果["剩余待投递"])
    断言等于(0, 长度(待投递列表()))
    断言等于(1, 长度(sink.收到的键))
    断言等于(键, sink.收到的键[0])
    清理库(路径)

// 用例 2：断网（假请求抛异常）计为失败且保留 pending，明细状态码 0、结果含中文「失败」。
函数 用例断网保留()
    定义 路径 = 库前缀 + "2.db"
    新建库(路径)
    定义 键 = "闭环-断网-2"
    投递入队("T-闭环-2", "通知", "载荷2", 键)
    定义 sink = 假sink(假, 200)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(sink.请求)
    断言等于(0, 结果["成功"])
    断言等于(1, 结果["失败"])
    断言等于(1, 结果["剩余待投递"])
    断言等于(1, 长度(待投递列表()))
    断言等于(0, 长度(sink.收到的键))
    断言等于(0, 结果["明细"][0]["状态码"])
    断言为真("失败" 在 结果["明细"][0]["结果"])
    断言为真("保留待投递" 在 结果["明细"][0]["结果"])
    清理库(路径)

// 用例 3：恢复后补发——同一 pending 在下一轮在线刷新中被投递并清零。
函数 用例恢复补发()
    定义 路径 = 库前缀 + "3.db"
    新建库(路径)
    定义 键 = "闭环-补发-3"
    投递入队("T-闭环-3", "通知", "载荷3", 键)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 首次 = 投递器.刷新(假sink(假, 200).请求)
    断言等于(1, 首次["失败"])
    断言等于(1, 长度(待投递列表()))
    定义 在线sink = 假sink(真, 200)
    定义 补发 = 投递器.刷新(在线sink.请求)
    断言等于(1, 补发["成功"])
    断言等于(0, 补发["剩余待投递"])
    断言等于(0, 长度(待投递列表()))
    断言等于(1, 长度(在线sink.收到的键))
    断言等于(键, 在线sink.收到的键[0])
    清理库(路径)

// 用例 4：同一幂等键重复入队只产生 1 条 pending，刷新只投递 1 次。
函数 用例幂等键重复()
    定义 路径 = 库前缀 + "4.db"
    新建库(路径)
    定义 键 = "闭环-重复-4"
    定义 ID1 = 投递入队("T-闭环-4", "通知", "载荷4", 键)
    定义 ID2 = 投递入队("T-闭环-4", "通知", "载荷4重复", 键)
    断言等于(ID1, ID2)
    断言等于(1, 长度(待投递列表()))
    定义 sink = 假sink(真, 200)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(sink.请求)
    断言等于(1, 结果["成功"])
    断言等于(0, 结果["剩余待投递"])
    断言等于(1, 长度(sink.收到的键))
    断言等于(键, sink.收到的键[0])
    清理库(路径)

// 用例 5：非 2xx（500）计失败、保留 pending，明细状态码与中文结果正确。
函数 用例非2xx明细()
    定义 路径 = 库前缀 + "5.db"
    新建库(路径)
    投递入队("T-闭环-5", "通知", "载荷5", "闭环-非2xx-5")
    定义 sink = 假sink(真, 500)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(sink.请求)
    断言等于(0, 结果["成功"])
    断言等于(1, 结果["失败"])
    断言等于(1, 结果["剩余待投递"])
    断言等于(1, 长度(待投递列表()))
    断言等于(500, 结果["明细"][0]["状态码"])
    断言为真("失败" 在 结果["明细"][0]["结果"])
    断言为真("保留待投递" 在 结果["明细"][0]["结果"])
    清理库(路径)

// 用例 6：待投递为空时刷新返回零值且明细为空列表，无异常。
函数 用例空待投递()
    定义 路径 = 库前缀 + "6.db"
    新建库(路径)
    定义 sink = 假sink(真, 200)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(sink.请求)
    断言等于(0, 结果["成功"])
    断言等于(0, 结果["失败"])
    断言等于(0, 结果["剩余待投递"])
    断言等于("列表", 取类型(结果["明细"]))
    断言等于(0, 长度(结果["明细"]))
    断言等于(0, 长度(sink.收到的键))
    清理库(路径)

// 用例 7：累计成功/失败跨轮次累加，最近明细数只反映最近一轮。
函数 用例统计累计()
    定义 路径 = 库前缀 + "7.db"
    新建库(路径)
    投递入队("T-闭环-7", "通知", "载荷7A", "闭环-统计-7A")
    投递入队("T-闭环-7", "通知", "载荷7B", "闭环-统计-7B")
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 失败轮 = 投递器.刷新(假sink(假, 200).请求)
    断言等于(2, 失败轮["失败"])
    定义 在线sink = 假sink(真, 200)
    定义 成功轮 = 投递器.刷新(在线sink.请求)
    断言等于(2, 成功轮["成功"])
    定义 空轮 = 投递器.刷新(在线sink.请求)
    断言等于(0, 空轮["成功"])
    断言等于(0, 空轮["失败"])
    定义 统计 = 投递器.投递统计()
    断言等于(2, 统计["累计成功"])
    断言等于(2, 统计["累计失败"])
    断言等于(0, 统计["最近明细数"])
    断言等于(2, 长度(成功轮["明细"]))
    清理库(路径)

// 用例 8：刷新返回中文字典含五个约定键，说明含回环口径边界。
函数 用例返回中文字典()
    定义 路径 = 库前缀 + "8.db"
    新建库(路径)
    投递入队("T-闭环-8", "通知", "载荷8", "闭环-字典-8")
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(假sink(真, 200).请求)
    断言等于("字典", 取类型(结果))
    断言为真("成功" 在 结果)
    断言为真("失败" 在 结果)
    断言为真("剩余待投递" 在 结果)
    断言为真("明细" 在 结果)
    断言为真("说明" 在 结果)
    断言为真("回环" 在 结果["说明"])
    断言为真("DoD" 在 结果["说明"])
    清理库(路径)

// 用例 9：明细含幂等键/状态码/结果，POST 载荷四字段完整。
函数 用例明细与载荷字段()
    定义 路径 = 库前缀 + "9.db"
    新建库(路径)
    定义 键 = "闭环-载荷-9"
    投递入队("T-闭环-9", "通知", "载荷9", 键)
    定义 sink = 假sink(真, 201)
    定义 投递器 = 创建投递器("http://127.0.0.1:9/outbox", 1)
    定义 结果 = 投递器.刷新(sink.请求)
    断言等于(1, 结果["成功"])
    定义 明细项 = 结果["明细"][0]
    断言为真("幂等键" 在 明细项)
    断言为真("状态码" 在 明细项)
    断言为真("结果" 在 明细项)
    断言等于(键, 明细项["幂等键"])
    断言等于(201, 明细项["状态码"])
    断言为真("投递成功" 在 明细项["结果"])
    定义 载荷 = sink.收到的载荷[0]
    断言等于(键, 载荷["幂等键"])
    断言等于("T-闭环-9", 载荷["工单编号"])
    断言等于("通知", 载荷["类型"])
    断言等于("载荷9", 载荷["内容"])
    清理库(路径)

// 用例 10：工厂字段与无参 投递统计() 初始口径正确。
函数 用例工厂字段()
    定义 投递器 = 创建投递器("http://127.0.0.1:12345/outbox", 7)
    断言等于("http://127.0.0.1:12345/outbox", 投递器.接收URL)
    断言等于(7, 投递器.请求超时)
    断言等于(0, 投递器.累计成功)
    断言等于(0, 投递器.累计失败)
    断言等于("列表", 取类型(投递器.最近投递明细))
    断言等于(0, 长度(投递器.最近投递明细))
    定义 统计 = 投递器.投递统计()
    断言等于(0, 统计["累计成功"])
    断言等于(0, 统计["累计失败"])
    断言等于(0, 统计["最近明细数"])

