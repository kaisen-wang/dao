// 更夫 Nightwatch — 语义评估（Eval）
// 分层归属：L3 应用层。业务规则与流程层，可调用 L2 领域层（决策/模式关闭）与 L1 基础设施层传入的语言模型对象。
// 对应 PRD《常驻研发协作 Agent》FR-03（触发评估）/ FR-04（三级执行模式：模式关闭只记不执行）。
// 职责：对触发逐条评估并产出 领域.道 的决策对象；优先请 LLM 做语义判断，失败时静默降级到关键词规则。
// 本模块不直接依赖大模型标准库，也不修改共享契约 领域.道。

从 领域层.领域 导入 决策, 模式关闭

// 评估器：按规则列表与策略版本对触发逐条评估；可选携带语言模型对象用于语义判断。
类型 评估器
    初始化(规则列表, 策略版本="v0.1", 语言模型=空)
        本对象.规则表 = []
        遍历 条规则 在 规则列表
            追加(本对象.规则表, 条规则)
        本对象.策略版本 = 策略版本
        本对象.语言模型 = 语言模型

    // 关键词规则评估（沿用上一轮逻辑）：命中给 would_accept，未命中给 would_ignore。
    // 理由文本统一以「关键词规则：」开头，便于看板与审计区分来源。
    函数 规则评估(编号, 触)
        定义 命中名称 = ""
        定义 命中结论 = ""
        遍历 条规则 在 本对象.规则表
            如果 命中名称 == ""
                定义 词命中 = 假
                遍历 词 在 条规则["关键词"]
                    如果 包含(触.内容, 词)
                        词命中 = 真

                定义 范围列表 = []
                如果 包含(条规则, "范围")
                    范围列表 = 条规则["范围"]
                定义 范围命中 = 假
                如果 长度(范围列表) == 0
                    范围命中 = 真
                否则 如果 触.来源 在 范围列表
                    范围命中 = 真

                如果 词命中 并且 范围命中
                    命中名称 = 条规则["名称"]
                    命中结论 = "would_accept"
                    如果 包含(条规则, "结论")
                        定义 候选结论 = 条规则["结论"]
                        如果 候选结论 != 空 并且 候选结论 != ""
                            命中结论 = 候选结论

        如果 命中名称 != ""
            定义 命中理由 = `命中规则「{命中名称}」，来源 {触.来源}，采纳结论 {命中结论}。`
            返回 决策(编号, 命中结论, "关键词规则：" + 命中理由, 本对象.策略版本)

        定义 忽略理由 = `来源 {触.来源} 未命中任何规则，仅做记录，不进入执行。`
        返回 决策(编号, "would_ignore", "关键词规则：" + 忽略理由, 本对象.策略版本)

    // 语义评估：语言模型非空且可用时，构造中文提示词请模型判断。
    // 成功且结论合法返回决策（理由以「LLM语义判断：」开头）；任何失败返回空，触发降级。
    // 全程静默：不打印任何信息，不让演示中断。
    函数 语义评估(编号, 触)
        如果 本对象.语言模型 == 空
            返回 空
        尝试
            如果 不是 本对象.语言模型.可用()
                返回 空

            定义 内容文本 = 触.内容
            定义 来源文本 = 触.来源
            定义 发起人文本 = 触.发起人
            定义 提示词 = `你是更夫 Nightwatch 的研发协作审计助手。请判断以下事件是否值得接受并进入执行。只输出 JSON：\{"结论":"would_accept或would_ignore","理由":"中文简由"\}，不要输出任何其它文字或代码块。事件内容：{内容文本}；来源：{来源文本}；发起人：{发起人文本}。`
            定义 系统提示 = "你是研发协作审计助手，只输出一个 JSON 对象，不要输出解释文字或 Markdown 代码块。"
            定义 应答 = 本对象.语言模型.判断(提示词, 系统提示)
            如果 应答["成功"]
                定义 结论 = 应答["结论"]
                如果 结论 == "would_accept" 或者 结论 == "would_ignore"
                    定义 模型理由 = 应答["理由"]
                    如果 模型理由 == 空 或者 模型理由 == ""
                        模型理由 = "模型未给出理由"
                    返回 决策(编号, 结论, "LLM语义判断：" + 模型理由, 本对象.策略版本)
            返回 空
        捕获 错误
            返回 空

    // 评估入口：模式关闭直接忽略（绝不调用 LLM）；其余先试语义评估，失败降级关键词规则。
    函数 评估(触, 模式)
        定义 编号 = 触.去重键()
        如果 模式 == 模式关闭
            返回 决策(编号, "would_ignore", "关键词规则：执行模式关闭", 本对象.策略版本)

        定义 语义决策 = 本对象.语义评估(编号, 触)
        如果 语义决策 != 空
            返回 语义决策
        返回 本对象.规则评估(编号, 触)

    函数 版本()
        返回 本对象.策略版本

// 工厂：由规则列表、策略版本与可选语言模型构造评估器（后两参数向后兼容）。
导出 函数 创建评估器(规则列表, 策略版本="v0.1", 语言模型=空)
    返回 评估器(规则列表, 策略版本, 语言模型)

// 按触发列表顺序逐条评估（同 Thread 串行），返回决策列表。
导出 函数 串行评估(评估器, 触发列表, 模式)
    定义 结果 = []
    遍历 触 在 触发列表
        追加(结果, 评估器.评估(触, 模式))
    返回 结果
