// 更夫 Nightwatch — observe 一周审计的本地压缩模拟（第七轮 / PRD §12 第 6 项）
// 分层归属：L3 应用层。仅用内存列表累计，不依赖数据库，不导入 LLM / 网络标准库。
// 诚实边界：本模块只做本地压缩模拟，压缩模拟 ≠ 真实一周 observe 运行；
//           测试通过不代表真实环境已验证，不勾选 PRD §12 任何 DoD 项。

从 编码 导入 JSON

// 观察审计器：在内存中逐条记录模拟事件，并给出四类计数与误判率。
// 四类判定由「准入结论（系统是否接受）」与「实际是否应接受（事实口径）」组成的 2×2 矩阵决定：
//   结论真 / 实际真 → 正确接受；结论真 / 实际假 → 误接受；
//   结论假 / 实际假 → 正确忽略；结论假 / 实际真 → 误忽略。
类型 观察审计器
    初始化()
        // 明细列表：每条记录含事件标识、时间与判定类别，是全部统计的唯一来源。
        本对象.明细列表 = []

    // 记录一条模拟事件；事件字典只取 事件ID / 时间 等字段，缺字段一律降级为空串，不抛异常。
    函数 记录事件(事件字典, 准入结论, 实际是否应接受)
        定义 事件标识 = ""
        定义 事件时间 = ""
        尝试
            如果 事件字典 != 空 并且 "事件ID" 在 事件字典
                事件标识 = 文本(事件字典["事件ID"])
        捕获 错误
            定义 忽略标识 = 错误
        尝试
            如果 事件字典 != 空 并且 "时间" 在 事件字典
                事件时间 = 文本(事件字典["时间"])
        捕获 错误
            定义 忽略时间 = 错误

        定义 类别 = ""
        如果 准入结论 == 真 并且 实际是否应接受 == 真
            类别 = "正确接受"
        否则 如果 准入结论 == 真 并且 实际是否应接受 == 假
            类别 = "误接受"
        否则 如果 准入结论 == 假 并且 实际是否应接受 == 假
            类别 = "正确忽略"
        否则
            类别 = "误忽略"

        追加(本对象.明细列表, {"事件ID": 事件标识, "时间": 事件时间, "类别": 类别})
        返回 类别

    // 统计某一类别在当前明细列表中的条数。
    函数 计数(类别名)
        定义 数量 = 0
        遍历 条目 在 本对象.明细列表
            如果 条目["类别"] == 类别名
                数量 = 数量 + 1
        返回 数量

    // 误接受率 = 误接受 / (正确忽略 + 误接受)；分母为 0 时降级返回 0.0。
    函数 误接受率()
        定义 分母 = 本对象.计数("正确忽略") + 本对象.计数("误接受")
        如果 分母 == 0
            返回 0.0
        返回 本对象.计数("误接受") / 分母

    // 误忽略率 = 误忽略 / (正确接受 + 误忽略)；分母为 0 时降级返回 0.0。
    函数 误忽略率()
        定义 分母 = 本对象.计数("正确接受") + 本对象.计数("误忽略")
        如果 分母 == 0
            返回 0.0
        返回 本对象.计数("误忽略") / 分母

    // 生成中文报告字典，字段：总数/正确接受/误接受/正确忽略/误忽略/误接受率/误忽略率。
    函数 生成报告()
        定义 正接 = 本对象.计数("正确接受")
        定义 误接 = 本对象.计数("误接受")
        定义 正忽 = 本对象.计数("正确忽略")
        定义 误忽 = 本对象.计数("误忽略")
        返回 {
            "总数": 正接 + 误接 + 正忽 + 误忽,
            "正确接受": 正接,
            "误接受": 误接,
            "正确忽略": 正忽,
            "误忽略": 误忽,
            "误接受率": 本对象.误接受率(),
            "误忽略率": 本对象.误忽略率(),
            "说明": "压缩模拟 ≠ 真实一周运行；本地验证不代表真实 observe 已验证，不勾选 PRD §12 DoD。"
        }

    // 导出 JSON 字符串，字段名保持中文；编码模块失败时降级返回空对象文本。
    函数 导出JSON()
        尝试
            返回 JSON.编码(本对象.生成报告())
        捕获 错误
            定义 忽略导出 = 错误
        返回 "{}"

// PRD §10.4：auto 模式开启门禁——observe 审计须满两周（14 天）且误接受率 ≤5%。
// 这是纯函数门禁，不开启任何自动执行；真实运行天数由调用方传入，本地压缩模拟不算达标。
导出 函数 可开启自动模式(观察天数, 误接受率)
    如果 观察天数 < 14
        返回 假
    如果 误接受率 > 0.05
        返回 假
    返回 真

// 工厂：创建一个全新的观察审计器（每次调用返回独立实例）。
导出 函数 创建观察审计()
    返回 观察审计器()
