// 更夫 Nightwatch — observe 一周审计的本地压缩模拟（第七轮 / PRD §12 第 6 项）
// 分层归属：L3 应用层。默认内存累计（创建观察审计）；可选复用 L1 存储做 SQLite 落盘与跨进程恢复（创建持久观察审计）。
// 持久化只依赖 L1 存储入口，不依赖 L4 接入层。
// 诚实边界：本模块只做本地压缩模拟，压缩模拟 ≠ 真实一周 observe 运行；
//           测试通过不代表真实环境已验证，不勾选 PRD §12 任何 DoD 项。

从 编码 导入 JSON
从 基础设施层.存储 导入 打开存储, 取连接

// 观察审计器：在内存中逐条记录模拟事件，并给出四类计数与误判率。
// 四类判定由「准入结论（系统是否接受）」与「实际是否应接受（事实口径）」组成的 2×2 矩阵决定：
//   结论真 / 实际真 → 正确接受；结论真 / 实际假 → 误接受；
//   结论假 / 实际假 → 正确忽略；结论假 / 实际真 → 误忽略。
// 持久化扩展：连接字段为空时完全退化为原有纯内存模式；非空时每次记录事件同步落库。
类型 观察审计器
    初始化()
        // 明细列表：每条记录含事件标识、时间与判定类别，是全部统计的唯一来源。
        本对象.明细列表 = []
        // 连接为空 = 纯内存模式（向后兼容）；非空 = 持久化模式。
        本对象.连接 = 空
        本对象.事件源 = ""

    // 记录一条模拟事件；事件字典只取 事件ID / 时间 / 事件日 等字段，缺字段一律降级为空串，不抛异常。
    函数 记录事件(事件字典, 准入结论, 实际是否应接受)
        定义 事件标识 = ""
        定义 事件时间 = ""
        定义 事件日 = ""
        尝试
            如果 事件字典 != 空 并且 "事件ID" 在 事件字典
                事件标识 = 文本(事件字典["事件ID"])
        捕获 错误
            定义 忽略标识 = 错误
        尝试
            如果 事件字典 != 空 并且 "时间" 在 事件字典
                事件时间 = 文本(事件字典["时间"])
        捕获 错误
            定义 忽略时间 = 错误
        尝试
            如果 事件字典 != 空 并且 "事件日" 在 事件字典
                事件日 = 文本(事件字典["事件日"])
        捕获 错误
            定义 忽略事件日 = 错误

        定义 类别 = ""
        如果 准入结论 == 真 并且 实际是否应接受 == 真
            类别 = "正确接受"
        否则 如果 准入结论 == 真 并且 实际是否应接受 == 假
            类别 = "误接受"
        否则 如果 准入结论 == 假 并且 实际是否应接受 == 假
            类别 = "正确忽略"
        否则
            类别 = "误忽略"

        追加(本对象.明细列表, {"事件ID": 事件标识, "时间": 事件时间, "类别": 类别, "事件日": 事件日})

        // 持久化模式：连接非空时同步落库；失败降级，不改变既有返回语义。
        如果 本对象.连接 != 空
            尝试
                本对象.连接.执行("INSERT INTO 观察审计明细 (事件ID, 时间, 类别, 事件日) VALUES (?, ?, ?, ?)", [事件标识, 事件时间, 类别, 事件日])
                本对象.连接.提交()
            捕获 错误
                定义 忽略落库 = 错误
        返回 类别

    // 统计某一类别在当前明细列表中的条数。
    函数 计数(类别名)
        定义 数量 = 0
        遍历 条目 在 本对象.明细列表
            如果 条目["类别"] == 类别名
                数量 = 数量 + 1
        返回 数量

    // 误接受率 = 误接受 / (正确忽略 + 误接受)；分母为 0 时降级返回 0.0。
    函数 误接受率()
        定义 分母 = 本对象.计数("正确忽略") + 本对象.计数("误接受")
        如果 分母 == 0
            返回 0.0
        返回 本对象.计数("误接受") / 分母

    // 误忽略率 = 误忽略 / (正确接受 + 误忽略)；分母为 0 时降级返回 0.0。
    函数 误忽略率()
        定义 分母 = 本对象.计数("正确接受") + 本对象.计数("误忽略")
        如果 分母 == 0
            返回 0.0
        返回 本对象.计数("误忽略") / 分母

    // 生成中文报告字典，字段：总数/正确接受/误接受/正确忽略/误忽略/误接受率/误忽略率。
    函数 生成报告()
        定义 正接 = 本对象.计数("正确接受")
        定义 误接 = 本对象.计数("误接受")
        定义 正忽 = 本对象.计数("正确忽略")
        定义 误忽 = 本对象.计数("误忽略")
        返回 {
            "总数": 正接 + 误接 + 正忽 + 误忽,
            "正确接受": 正接,
            "误接受": 误接,
            "正确忽略": 正忽,
            "误忽略": 误忽,
            "误接受率": 本对象.误接受率(),
            "误忽略率": 本对象.误忽略率(),
            "说明": "压缩模拟 ≠ 真实一周运行；本地验证不代表真实 observe 已验证，不勾选 PRD §12 DoD。"
        }

    // 导出 JSON 字符串，字段名保持中文；编码模块失败时降级返回空对象文本。
    函数 导出JSON()
        尝试
            返回 JSON.编码(本对象.生成报告())
        捕获 错误
            定义 忽略导出 = 错误
        返回 "{}"

    // 从 SQLite 重新统计落库明细：返回 {"落库条数": N, "各类别": {类别: 条数}}。
    // 纯内存模式（连接为空）返回零值；任何查询失败一律降级，不抛异常。
    函数 持久化统计()
        定义 结果 = {"落库条数": 0, "各类别": {}}
        如果 本对象.连接 == 空
            返回 结果
        尝试
            定义 计数行 = 本对象.连接.查询一个("SELECT COUNT(*) AS 数量 FROM 观察审计明细", [])
            如果 计数行 != 空
                结果["落库条数"] = 计数行["数量"]
            定义 类别行列表 = 本对象.连接.查询("SELECT 类别, COUNT(*) AS 数量 FROM 观察审计明细 GROUP BY 类别", [])
            定义 各类别 = {}
            遍历 类别行 在 类别行列表
                各类别[类别行["类别"]] = 类别行["数量"]
            结果["各类别"] = 各类别
        捕获 错误
            定义 忽略统计 = 错误
        返回 结果

    // 从 SQLite 重建内存明细列表（按插入顺序），返回恢复条数（跨进程恢复）。
    // 纯内存模式返回 0；任何查询失败一律降级为 0，不抛异常。
    函数 恢复审计()
        如果 本对象.连接 == 空
            返回 0
        尝试
            定义 行列表 = 本对象.连接.查询("SELECT 事件ID, 时间, 类别, 事件日 FROM 观察审计明细 ORDER BY id", [])
            定义 明细 = []
            遍历 行 在 行列表
                追加(明细, {"事件ID": 行["事件ID"], "时间": 行["时间"], "类别": 行["类别"], "事件日": 行["事件日"]})
            本对象.明细列表 = 明细
            返回 长度(明细)
        捕获 错误
            定义 忽略恢复 = 错误
            返回 0

// PRD §10.4：auto 模式开启门禁——observe 审计须满两周（14 天）且误接受率 ≤5%。
// 这是纯函数门禁，不开启任何自动执行；真实运行天数由调用方传入，本地压缩模拟不算达标。
导出 函数 可开启自动模式(观察天数, 误接受率)
    如果 观察天数 < 14
        返回 假
    如果 误接受率 > 0.05
        返回 假
    返回 真

// 工厂：创建一个全新的观察审计器（每次调用返回独立实例，纯内存模式）。
导出 函数 创建观察审计()
    返回 观察审计器()

// 工厂：创建持久化观察审计器。复用 L1 存储入口打开/新建数据库并建 观察审计明细 表，
// 返回的对象保留全部既有方法，且每次 记录事件() 同步落库。建表失败时连接为空，各持久化方法自动降级。
导出 函数 创建持久观察审计(数据库路径, 事件源=空)
    定义 审计 = 观察审计器()
    定义 新连接 = 空
    尝试
        打开存储(数据库路径)
        新连接 = 取连接()
        新连接.执行("CREATE TABLE IF NOT EXISTS 观察审计明细 (id INTEGER PRIMARY KEY AUTOINCREMENT, 事件ID TEXT, 时间 TEXT, 类别 TEXT, 事件日 TEXT)")
        新连接.提交()
    捕获 错误
        定义 忽略建表 = 错误
        新连接 = 空
    审计.连接 = 新连接
    审计.事件源 = 事件源
    返回 审计

// 把 7 天 × 四类计数展开成明细事件写入审计器（事件日 = 第 N 天），返回写入总数。
// 事件字典带 事件日 字段；对内存审计器与持久审计器同样适用。
导出 函数 审计一周模拟流(审计器, 每天正确接受, 每天误接受, 每天正确忽略, 每天误忽略)
    定义 写入总数 = 0
    遍历 天 从 1 到 7
        定义 索引 = 天 - 1
        遍历 i 从 1 到 每天正确接受[索引]
            审计器.记录事件({"事件ID": `D{天}-正接-{i}`, "时间": `第{天}天`, "事件日": 天}, 真, 真)
            写入总数 = 写入总数 + 1
        遍历 i 从 1 到 每天误接受[索引]
            审计器.记录事件({"事件ID": `D{天}-误接-{i}`, "时间": `第{天}天`, "事件日": 天}, 真, 假)
            写入总数 = 写入总数 + 1
        遍历 i 从 1 到 每天正确忽略[索引]
            审计器.记录事件({"事件ID": `D{天}-正忽-{i}`, "时间": `第{天}天`, "事件日": 天}, 假, 假)
            写入总数 = 写入总数 + 1
        遍历 i 从 1 到 每天误忽略[索引]
            审计器.记录事件({"事件ID": `D{天}-误忽-{i}`, "时间": `第{天}天`, "事件日": 天}, 假, 真)
            写入总数 = 写入总数 + 1
    返回 写入总数
