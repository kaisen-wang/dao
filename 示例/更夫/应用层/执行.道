// 更夫 Nightwatch — Worker、六类报告与异步工具模拟（第二轮：LLM 驱动执行结论）
// 分层归属：L3 应用层。业务规则与流程编排；可调用 L1 基础设施层与 L2 领域层，不得直接依赖大模型标准库。
// 对应 PRD《常驻研发协作 Agent》FR-08（Worker 与六类报告）与 FR-09（异步工具）。
// 报告统一由 领域.道 的 建报告 构造；本模块不修改共享契约。
// 语言模型由入口经可选参数注入（L1 基础设施层的语言模型适配器对象），本模块只调用其 .可用()/.对话()，失败静默降级。

从 领域层.领域 导入 建报告, 报告进度, 报告等待, 报告就绪, 报告受阻, 报告失败, 报告丢弃
从 调度 导入 延迟执行

// 默认执行步骤：调用方未给步骤列表时使用。
定义 默认步骤 = ["解析工单内容", "检索相关上下文", "生成执行结论"]

// 处理无可用槽位或预算受阻：产出一条受阻报告并回调。
函数 受阻并返回(单, 原因)
    定义 受阻报告 = 建报告(单.编号, 报告受阻, 原因)
    返回 受阻报告

// 执行单个工单：占用槽位 → 预算记账 → 模拟步骤并逐条回调进度报告 → 生成末报告 → 释放槽位。
// 成功时末报告为 报告就绪；无空槽或预算超限时末报告为 报告受阻。
// 单有未交付输入时，先取走一条再执行。
// 增加了可选参数 语言模型：非空且可用时，步骤结束后调用一次 .对话() 生成一句中文执行结论，
// 写入末报告消息并在数据中标注来源与生成 token；任何失败均静默降级为模板文本，不影响槽位释放。
导出 函数 执行工单(单, 调度器, 预算, 报告回调, 步骤列表=空, 语言模型=空)
    定义 槽位号 = 调度器.占用()
    如果 槽位号 == 空
        定义 无槽报告 = 受阻并返回(单, `工单 {单.编号} 无空闲槽位，执行受阻`)
        报告回调(无槽报告)
        返回 无槽报告

    如果 单.待交付数() > 0
        定义 一条输入 = 单.取输入()

    如果 不是 预算.记账(单.编号, 1, 0)
        调度器.释放(槽位号)
        定义 超预报告 = 受阻并返回(单, `工单 {单.编号} 预算超限，执行受阻`)
        报告回调(超预报告)
        返回 超预报告

    定义 步骤 = 步骤列表
    如果 步骤列表 == 空 或者 长度(步骤列表) == 0
        步骤 = 默认步骤

    定义 步号 = 0
    遍历 步 在 步骤
        步号 = 步号 + 1
        定义 进度消息 = `工单 {单.编号} 第 {步号} 步「{步}」完成`
        定义 进度报告 = 建报告(单.编号, 报告进度, 进度消息, {"步骤":步号, "槽位":槽位号})
        报告回调(进度报告)

    // 末报告默认使用原模板文本，来源标注为降级；仅当模型调用成功时覆盖。
    定义 末报告消息 = `工单 {单.编号} 执行完成，占用槽位 {槽位号}`
    定义 末报告数据 = {"模型来源":"降级"}

    // 每个工单至多调用一次 LLM，且只在步骤循环结束后调用，避免演示过慢。
    // 整段包裹在 尝试/捕获 中：模型不可用、调用异常或数据缺失一律降级，绝不中断工单或泄漏槽位。
    如果 语言模型 != 空
        尝试
            如果 语言模型.可用()
                定义 步骤文本 = ""
                遍历 步 在 步骤
                    如果 长度(步骤文本) > 0
                        步骤文本 = 步骤文本 + "、"
                    步骤文本 = 步骤文本 + 步
                定义 提示词 = `工单标题：{单.标题}。执行步骤：{步骤文本}。请据此生成一句中文执行结论，60字以内，只输出结论文本，不要输出JSON、引号或解释。`
                定义 应答 = 语言模型.对话(提示词, "只输出一句60字以内的中文结论文本，不要JSON格式。")
                如果 应答["成功"]
                    定义 模型结论 = 应答["内容"]
                    如果 模型结论 != 空 并且 长度(模型结论) > 0
                        定义 用量字典 = 应答["用量"]
                        定义 生成token数 = 用量字典["生成token"]
                        末报告消息 = `工单 {单.编号}：{模型结论}`
                        末报告数据 = {"模型来源":"ollama", "生成token":生成token数}
                        // 调用数前面已记过 1，这里只加生成 token，不重复记调用数。
                        预算.记账(单.编号, 0, 生成token数)
        捕获 错误
            末报告消息 = `工单 {单.编号} 执行完成，占用槽位 {槽位号}`
            末报告数据 = {"模型来源":"降级"}

    定义 末报告 = 建报告(单.编号, 报告就绪, 末报告消息, 末报告数据)
    报告回调(末报告)
    调度器.释放(槽位号)
    返回 末报告

// 生成演示用六类报告序列：进度/等待/就绪/受阻/失败/丢弃各一条。
导出 函数 生成报告序列(工单编号)
    定义 序列 = []
    追加(序列, 建报告(工单编号, 报告进度, "工单开始执行，正在处理第一步"))
    追加(序列, 建报告(工单编号, 报告等待, "工单等待外部事件后继续"))
    追加(序列, 建报告(工单编号, 报告就绪, "工单执行完成，等待人工审核"))
    追加(序列, 建报告(工单编号, 报告受阻, "预算超出上限，工单执行受阻"))
    追加(序列, 建报告(工单编号, 报告失败, "工单执行失败，已记录失败原因"))
    追加(序列, 建报告(工单编号, 报告丢弃, "重复事件已被丢弃，不再执行"))
    返回 序列

// 工具完成回调的实际处理：先尝试把结果字典交给完成回调，若其不接收参数则按无参方式调用。
函数 工具完成处理(命令名, 完成回调)
    定义 结果 = {"命令":命令名, "状态":"完成", "输出":"本地模拟输出"}
    尝试
        完成回调(结果)
    捕获 错误
        完成回调()

// 模拟异步工具启动：延迟指定秒数后触发完成回调，返回调度 ID。
// 延迟执行的回调必须无参，故用无参匿名函数作闭包捕获命令名与完成回调。
导出 函数 运行异步工具(命令名, 秒数, 完成回调)
    定义 毫秒 = 整数(秒数 * 1000)
    定义 完成函数 = 函数() => 工具完成处理(命令名, 完成回调)
    定义 调度ID = 延迟执行(毫秒, 完成函数)
    返回 调度ID
