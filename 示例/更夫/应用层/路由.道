// 更夫 Nightwatch — 常驻 Router 会话核心（第五轮 / v1.1 M4，FR-17）
// 分层归属：L3 应用层。只依赖 L2 领域层的常量与类型，所有状态保存在内存集合。
// 对外只导出 创建路由 工厂；返回的路由对象提供会话保持、批处理、全局记忆与统一回复。
// 不实现任何真实网络 IO / fork / 线程；语言模型为可选增强项，失败一律静默降级为关键词规则。

从 领域层.领域 导入 消息, 会话, 信道GitHub, 信道飞书, 信道企微, 角色用户, 角色助手, 新工单编号

// 建单意图关键词列表：命中任一即视为需要创建工单。
// 「规则」是关键字，故变量名一律用「建单关键词列表」。
定义 建单关键词列表 = ["请修复", "请处理", "帮我处理", "开工单", "请帮忙", "崩溃", "失败", "报错", "异常", "缺陷"]

// 路由器：会话表以会话编号为键保存 会话 对象；工单表保存本地工单记录。
类型 路由器
    初始化(会话集合=空, 语言模型=空)
        如果 会话集合 == 空
            本对象.会话表 = {}
        否则
            本对象.会话表 = 会话集合
        本对象.语言模型 = 语言模型
        本对象.工单表 = {}
        本对象.工单序号 = 0

    // 同一编号重复开通返回既有会话（幂等）。
    函数 开通会话(会话编号, 来源信道, 话题键)
        如果 会话编号 在 本对象.会话表
            返回 本对象.会话表[会话编号]
        定义 新会话 = 会话(会话编号, 来源信道, 话题键)
        本对象.会话表[会话编号] = 新会话
        返回 新会话

    // 判断文本是否命中建单意图。
    函数 是否建单意图(文本)
        遍历 关键词 在 建单关键词列表
            如果 包含(文本, 关键词)
                返回 真
        返回 假

    // 尝试调用语言模型生成一句中文文本；未注入、调用失败或缺字段一律返回空串（降级）。
    // 任何异常都被捕获，绝不向调用方抛出。
    函数 尝试生成(文本)
        如果 本对象.语言模型 == 空
            返回 ""
        尝试
            定义 提示词 = `会话消息：{文本}。请据此生成一句60字以内的中文回复，只输出回复文本。`
            定义 系统提示 = "只输出一句60字以内的中文回复文本，不要JSON、引号或解释。"
            定义 应答 = 本对象.语言模型.对话(提示词, 系统提示)
            如果 应答 != 空 并且 应答["成功"]
                定义 内容 = 应答["内容"]
                如果 内容 != 空 并且 长度(内容) > 0
                    返回 内容
        捕获 错误
            定义 忽略 = 错误
        返回 ""

    // 接收一条消息：写入用户消息，判定建单意图，生成助手回复并写入会话，返回响应字典。
    // 来源信道 / 来源用户 仅作为元数据保存到本地工单记录，不触发外部请求。
    函数 收消息(会话编号, 文本, 来源信道=信道飞书, 来源用户="")
        定义 目标会话 = 空
        如果 会话编号 在 本对象.会话表
            目标会话 = 本对象.会话表[会话编号]
        否则
            目标会话 = 本对象.开通会话(会话编号, 来源信道, "默认话题")

        目标会话.追加消息(角色用户, 文本, "")

        定义 命中建单 = 本对象.是否建单意图(文本)
        定义 工单编号 = ""
        定义 回复 = ""

        如果 命中建单
            本对象.工单序号 = 本对象.工单序号 + 1
            工单编号 = `{新工单编号()}-{本对象.工单序号}`
            本对象.工单表[工单编号] = {
                "工单编号": 工单编号,
                "会话编号": 会话编号,
                "文本": 文本,
                "来源用户": 来源用户,
                "来源信道": 来源信道
            }
            定义 模型文本 = 本对象.尝试生成(文本)
            如果 长度(模型文本) > 0
                回复 = `已收到您的请求，已创建工单 {工单编号}。{模型文本}`
            否则
                回复 = `关键词规则：已收到您的请求，已创建工单 {工单编号}，我们会尽快处理。`
            目标会话.追加消息(角色助手, 回复, 工单编号)
        否则
            定义 模型文本 = 本对象.尝试生成(文本)
            如果 长度(模型文本) > 0
                回复 = `已收到您的消息。{模型文本}`
            否则
                回复 = "关键词规则：已收到您的消息，我会持续关注此话题。"
            目标会话.追加消息(角色助手, 回复, "")

        返回 {
            "成功": 真,
            "会话编号": 会话编号,
            "回复": 回复,
            "工单编号": 工单编号,
            "消息数": 目标会话.消息数()
        }

    // 逐条调用 收消息，返回每个响应字典组成的列表。
    函数 批处理(消息列表, 会话编号, 来源信道=信道飞书)
        定义 结果 = []
        遍历 文本 在 消息列表
            追加(结果, 本对象.收消息(会话编号, 文本, 来源信道, ""))
        返回 结果

    // 取该会话最近的助手消息，拼成一段中文文本；无会话或无助手消息返回中文提示。
    函数 统一回复(会话编号)
        如果 会话编号 不在 本对象.会话表
            返回 "当前没有该会话，无法生成统一回复。"
        定义 目标会话 = 本对象.会话表[会话编号]
        定义 最近列表 = 目标会话.最近消息(5)
        定义 片段列表 = []
        遍历 消息对象 在 最近列表
            如果 消息对象.角色 == 角色助手
                追加(片段列表, 消息对象.内容)
        如果 长度(片段列表) == 0
            返回 "该会话暂无助手回复，无法生成统一回复。"
        定义 文本 = "统一回复："
        遍历 i 从 0 到 长度(片段列表) - 1
            如果 i > 0
                文本 = 文本 + "；"
            文本 = 文本 + 片段列表[i]
        返回 文本

    // 跨会话记忆：返回该话题下所有会话的最近消息列表（消息对象）。
    函数 全局记忆(话题键)
        定义 结果 = []
        遍历 编号, 目标会话 在 本对象.会话表
            如果 目标会话.话题键 == 话题键
                遍历 消息对象 在 目标会话.最近消息(5)
                    追加(结果, 消息对象)
        返回 结果

    // 当前会话总数。
    函数 会话数()
        返回 长度(本对象.会话表)

// 工厂：创建并返回常驻路由对象。
导出 函数 创建路由(会话集合=空, 语言模型=空)
    返回 路由器(会话集合, 语言模型)
