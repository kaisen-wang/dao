// 更夫 Nightwatch — 链式召回工具（第五轮 / FR-17 配套）
// 分层归属：L3 应用层。只依赖领域对象与存储层数据，不导入 LLM / 网络标准库。
// 对外接口：创建召回器(存储)；串联召回(片段列表, 最大跳数)。
// 约定：任何异常路径（存储为空、参数非法、取数失败、字段缺失）均返回空列表或安全降级，不向上抛异常。

从 领域层.领域 导入 召回片段, 话题
从 文本 导入 小写, 截取, 分割, 替换
从 基础设施层.存储 导入 列出工单, 列出决策, 列出报告, 列出触发

// ======================== 内部辅助：文本与键 ========================

// 统一文本比较口径：空值归一为空串，其余转小写文本（中文不受影响）。
函数 规范文本(值)
    如果 值 == 空
        返回 ""
    返回 小写(文本(值))

// 片段去重键：来源类型、来源编号、内容三者拼接。
函数 片段键(片)
    尝试
        返回 规范文本(片.来源类型) + "|" + 规范文本(片.来源编号) + "|" + 规范文本(片.内容)
    捕获 错误
        定义 忽略 = 错误
    返回 文本(片)

// 安全读取相关度：非数值字段按 0.0 处理。
函数 相关度值(片)
    尝试
        定义 值 = 片.相关度
        如果 取类型(值) == "数值"
            返回 值
        返回 0.0
    捕获 错误
        定义 忽略 = 错误
    返回 0.0

// ======================== 内部辅助：安全取数 ========================

// 取工单列表：优先用注入存储，失败或未注入时回退到存储模块，再失败返回空列表。
函数 取工单数据(存储)
    如果 存储 != 空
        尝试
            定义 注入结果 = 存储.列出工单()
            如果 注入结果 != 空
                返回 注入结果
        捕获 错误
            定义 忽略 = 错误
    尝试
        定义 模块结果 = 列出工单()
        如果 模块结果 != 空
            返回 模块结果
    捕获 错误
        定义 忽略2 = 错误
    返回 []

// 取决策列表：给出话题编号时按话题过滤，否则取全部。
函数 取决策数据(存储, 话题编号)
    如果 存储 != 空
        尝试
            定义 注入结果 = 空
            如果 话题编号 == 空
                注入结果 = 存储.列出决策()
            否则
                注入结果 = 存储.列出决策(话题编号)
            如果 注入结果 != 空
                返回 注入结果
        捕获 错误
            定义 忽略 = 错误
    尝试
        定义 模块结果 = 空
        如果 话题编号 == 空
            模块结果 = 列出决策()
        否则
            模块结果 = 列出决策(话题编号)
        如果 模块结果 != 空
            返回 模块结果
    捕获 错误
        定义 忽略2 = 错误
    返回 []

// 取某工单的报告列表。
函数 取报告数据(存储, 工单编号)
    如果 存储 != 空
        尝试
            定义 注入结果 = 存储.列出报告(工单编号)
            如果 注入结果 != 空
                返回 注入结果
        捕获 错误
            定义 忽略 = 错误
    尝试
        定义 模块结果 = 列出报告(工单编号)
        如果 模块结果 != 空
            返回 模块结果
    捕获 错误
        定义 忽略2 = 错误
    返回 []

// 取触发列表。
函数 取触发数据(存储)
    如果 存储 != 空
        尝试
            定义 注入结果 = 存储.列出触发()
            如果 注入结果 != 空
                返回 注入结果
        捕获 错误
            定义 忽略 = 错误
    尝试
        定义 模块结果 = 列出触发()
        如果 模块结果 != 空
            返回 模块结果
    捕获 错误
        定义 忽略2 = 错误
    返回 []

// ======================== 内部辅助：领域对象转片段 ========================

// 工单转片段：来源类型 工单，相关度 1.0；缺字段时返回空由调用方跳过。
函数 工单转片段(单)
    尝试
        返回 召回片段("工单", 单.编号, 单.描述(), 1.0)
    捕获 错误
        定义 忽略 = 错误
    返回 空

// 决策转片段：来源类型 决策，相关度 0.8。
函数 决策转片段(决)
    尝试
        返回 召回片段("决策", 决.触发编号, 决.描述(), 0.8)
    捕获 错误
        定义 忽略 = 错误
    返回 空

// 报告转片段：来源类型 报告，相关度 0.6。
函数 报告转片段(报)
    尝试
        返回 召回片段("报告", 报.工单编号, 报.消息, 0.6)
    捕获 错误
        定义 忽略 = 错误
    返回 空

// 汇总存储中的全部片段并按片段键去重。
函数 取全部片段(存储)
    定义 结果 = []
    定义 键列表 = []
    尝试
        定义 单列表 = 取工单数据(存储)
        遍历 单 在 单列表
            定义 片 = 工单转片段(单)
            如果 片 != 空
                定义 键 = 片段键(片)
                如果 键 不在 键列表
                    追加(键列表, 键)
                    追加(结果, 片)
        定义 决列表 = 取决策数据(存储, 空)
        遍历 决 在 决列表
            定义 决策片 = 决策转片段(决)
            如果 决策片 != 空
                定义 决策键 = 片段键(决策片)
                如果 决策键 不在 键列表
                    追加(键列表, 决策键)
                    追加(结果, 决策片)
        // 报告无「列出全部」接口，须按工单编号逐单取；工单取数失败时静默跳过。
        遍历 单 在 单列表
            尝试
                定义 工单号 = 单.编号
                定义 报列表 = 取报告数据(存储, 工单号)
                遍历 报 在 报列表
                    定义 报告片 = 报告转片段(报)
                    如果 报告片 != 空
                        定义 报告键 = 片段键(报告片)
                        如果 报告键 不在 键列表
                            追加(键列表, 报告键)
                            追加(结果, 报告片)
            捕获 错误
                定义 忽略报 = 错误
    捕获 错误
        定义 忽略 = 错误
    返回 结果

// ======================== 内部辅助：关联判定与排序 ========================

// 提取关键词：去标点后按空白切分，保留长度≥3 的词元，并补充三字滑窗以捕捉部分重叠。
// 长度阈值有意滤掉「工单」「排队」等模板词，避免仅因描述模板相同而误判关联。
函数 取关键词集(内容)
    定义 结果 = []
    定义 清洗 = 规范文本(内容)
    定义 分隔符列表 = [" ", "|", "[", "]", "（", "）", "(", ")", "，", ",", "。", ".", "：", ":", "、", "/", "-", "_", "【", "】", "{", "}"]
    遍历 分隔符 在 分隔符列表
        清洗 = 替换(清洗, 分隔符, " ")
    定义 段列表 = 分割(清洗, " ")
    遍历 段 在 段列表
        如果 长度(段) >= 3
            如果 段 不在 结果
                追加(结果, 段)
    遍历 段 在 段列表
        定义 段长 = 长度(段)
        如果 段长 >= 4
            遍历 i 从 0 到 段长 - 3
                定义 三元 = 截取(段, i, i + 3)
                如果 三元 不在 结果
                    追加(结果, 三元)
    返回 结果

// 两个片段是否相关：来源编号相同且非空，或内容关键词存在重叠。
函数 片段相关(甲, 乙)
    尝试
        定义 甲编号 = 规范文本(甲.来源编号)
        定义 乙编号 = 规范文本(乙.来源编号)
        如果 甲编号 != "" 并且 甲编号 == 乙编号
            返回 真
    捕获 错误
        定义 忽略 = 错误
    尝试
        定义 甲词 = 取关键词集(甲.内容)
        定义 乙词 = 取关键词集(乙.内容)
        遍历 词 在 甲词
            如果 词 在 乙词
                返回 真
    捕获 错误
        定义 忽略2 = 错误
    返回 假

// 选择排序：按相关度降序，相关度相同保持原有先后顺序。
函数 按相关度排序(片段列表)
    定义 结果 = []
    遍历 片 在 片段列表
        追加(结果, 片)
    定义 总数 = 长度(结果)
    如果 总数 > 1
        遍历 i 从 0 到 总数 - 2
            定义 最大位置 = i
            遍历 j 从 i + 1 到 总数 - 1
                如果 相关度值(结果[j]) > 相关度值(结果[最大位置])
                    最大位置 = j
            如果 最大位置 != i
                定义 临时 = 结果[i]
                结果[i] = 结果[最大位置]
                结果[最大位置] = 临时
    返回 结果

// ======================== 召回器对象 ========================

类型 召回器
    初始化(存储=空)
        本对象.存储 = 存储

    // 按工单编号召回：工单自身片段 + 该工单的报告片段。
    函数 按工单(工单编号)
        定义 结果 = []
        如果 工单编号 == 空
            返回 结果
        如果 规范文本(工单编号) == ""
            返回 结果
        尝试
            定义 单列表 = 取工单数据(本对象.存储)
            遍历 单 在 单列表
                尝试
                    如果 规范文本(单.编号) == 规范文本(工单编号)
                        定义 片 = 工单转片段(单)
                        如果 片 != 空
                            追加(结果, 片)
                捕获 错误
                    定义 忽略 = 错误
            定义 报列表 = 取报告数据(本对象.存储, 工单编号)
            遍历 报 在 报列表
                定义 报告片 = 报告转片段(报)
                如果 报告片 != 空
                    追加(结果, 报告片)
        捕获 错误
            定义 忽略2 = 错误
        返回 结果

    // 按话题召回：话题下决策片段 + 该话题触发关联到的工单片段。
    函数 按话题(话题编号)
        定义 结果 = []
        如果 话题编号 == 空
            返回 结果
        如果 规范文本(话题编号) == ""
            返回 结果
        尝试
            定义 决列表 = 取决策数据(本对象.存储, 话题编号)
            遍历 决 在 决列表
                定义 决策片 = 决策转片段(决)
                如果 决策片 != 空
                    追加(结果, 决策片)
            定义 触列表 = 取触发数据(本对象.存储)
            定义 外部编号集 = []
            遍历 触 在 触列表
                尝试
                    如果 规范文本(触.话题编号) == 规范文本(话题编号)
                        定义 外部编号 = 规范文本(触.外部编号)
                        如果 外部编号 != ""
                            如果 外部编号 不在 外部编号集
                                追加(外部编号集, 外部编号)
                捕获 错误
                    定义 忽略 = 错误
            如果 长度(外部编号集) > 0
                定义 单列表 = 取工单数据(本对象.存储)
                遍历 单 在 单列表
                    尝试
                        如果 规范文本(单.外部编号) 在 外部编号集
                            定义 工单片 = 工单转片段(单)
                            如果 工单片 != 空
                                追加(结果, 工单片)
                    捕获 错误
                        定义 忽略2 = 错误
        捕获 错误
            定义 忽略3 = 错误
        返回 结果

    // 按关键词召回：内容包含任一关键词（大小写不敏感）的片段，按片段键去重。
    函数 按关键词(关键词列表)
        定义 结果 = []
        如果 关键词列表 == 空
            返回 结果
        如果 取类型(关键词列表) != "列表"
            返回 结果
        如果 长度(关键词列表) == 0
            返回 结果
        定义 词列表 = []
        遍历 词 在 关键词列表
            尝试
                定义 词文本 = 规范文本(词)
                如果 词文本 != ""
                    如果 词文本 不在 词列表
                        追加(词列表, 词文本)
            捕获 错误
                定义 忽略 = 错误
        如果 长度(词列表) == 0
            返回 结果
        定义 键列表 = []
        尝试
            定义 候选片段 = 取全部片段(本对象.存储)
            遍历 片 在 候选片段
                尝试
                    定义 内容 = 规范文本(片.内容)
                    遍历 词 在 词列表
                        如果 包含(内容, 词)
                            定义 键 = 片段键(片)
                            如果 键 不在 键列表
                                追加(键列表, 键)
                                追加(结果, 片)
                            跳出
                捕获 错误
                    定义 忽略2 = 错误
        捕获 错误
            定义 忽略3 = 错误
        返回 结果

// 创建召回器：存储为空时仍返回对象，取数会安全降级为空列表。
导出 函数 创建召回器(存储=空)
    返回 召回器(存储)

// ======================== 串联召回 ========================

// 串联召回：以首片段为起点，按「来源编号相同 / 内容关键词重叠」逐跳扩展，
// 最多 最大跳数 跳；已访问片段不重复，结果按相关度降序。
// 输入为空、参数非法或最大跳数非法时返回空列表或按默认 3 跳处理，不抛异常。
导出 函数 串联召回(片段列表, 最大跳数=3)
    定义 结果 = []
    如果 片段列表 == 空
        返回 结果
    如果 取类型(片段列表) != "列表"
        返回 结果
    如果 长度(片段列表) == 0
        返回 结果
    定义 跳数 = 3
    如果 取类型(最大跳数) == "数值"
        如果 最大跳数 >= 1
            跳数 = 最大跳数
    定义 首片 = 片段列表[0]
    如果 首片 == 空
        返回 结果
    追加(结果, 首片)
    定义 键列表 = []
    追加(键列表, 片段键(首片))
    定义 当前边界 = []
    追加(当前边界, 首片)
    定义 跳 = 0
    当 跳 < 跳数
        定义 下一边界 = []
        遍历 边界片 在 当前边界
            遍历 候选 在 片段列表
                尝试
                    定义 候选键 = 片段键(候选)
                    如果 候选键 不在 键列表
                        如果 片段相关(边界片, 候选)
                            追加(键列表, 候选键)
                            追加(结果, 候选)
                            追加(下一边界, 候选)
                捕获 错误
                    定义 忽略 = 错误
        如果 长度(下一边界) == 0
            跳出
        当前边界 = 下一边界
        跳 = 跳 + 1
    返回 按相关度排序(结果)
