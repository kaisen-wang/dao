// 更夫 Nightwatch — FR-16 真 Watchdog：时间阈值停滞发现 + nudge / 告警决策（第十一轮）
// 分层归属：L3 应用层。只依赖 L2 领域层/领域.道（常量、工单、决策、建报告）与内置 时间戳()。
// 不依赖 L4 接入层，也不修改共享契约 领域.道。
//
// 诚实边界：本模块的时间阈值用「注入历史时间戳」模拟停滞 30 分钟，不是真等 30 分钟；
//           FR-16 真实定时巡检仍需生产长驻环境（长驻守护 + 真实时钟轮询）。
//           本地测试通过不代表真实环境已验收，不勾选 PRD §12 任何 DoD 项。
// 失败口径：任何输入异常一律中文字典或空降级，不向上抛未捕获异常。

从 领域层.领域 导入 阶段执行中, 阶段结束, 报告受阻, 报告失败, 建报告
从 领域层.领域 导入 工单, 决策

// ======================== 看门狗对象 ========================
// 字段：停滞阈值分钟 / 告警阈值分钟（单位：分钟），巡检时乘以 60 换算为秒。
// 最近巡检明细、巡检次数在每次 巡检() 调用后覆盖 / 累加，便于看板与测试读取。
类型 看门狗
    初始化(停滞阈值分钟=30, 告警阈值分钟=60)
        本对象.停滞阈值分钟 = 停滞阈值分钟
        本对象.告警阈值分钟 = 告警阈值分钟
        本对象.最近巡检明细 = []
        本对象.巡检次数 = 0

    // 巡检一轮：当前时间为空时取内置 时间戳()（单位：秒），允许注入整数便于测试。
    // 停滞 = 阶段执行中 且 无运行中绑定 且 停滞秒数 >= 停滞阈值分钟*60。
    // 告警 = 停滞秒数 >= 告警阈值分钟*60，或该工单报告映射含 报告受阻 / 报告失败；
    //        其余停滞为 nudge，非停滞为 正常。
    // 返回中文字典 {"巡检次数","停滞数","nudge数","告警数","明细","说明"}。
    函数 巡检(工单列表, 报告映射=空, 当前时间=空)
        本对象.巡检次数 = 本对象.巡检次数 + 1

        // 输入降级：无效列表 / 映射 / 时间一律替换为空或当前时间，不抛异常。
        定义 列表 = 工单列表
        如果 列表 == 空 或者 取类型(列表) != "列表"
            列表 = []
        定义 映射 = 报告映射
        如果 映射 == 空 或者 取类型(映射) != "字典"
            映射 = 空
        定义 现在 = 当前时间
        如果 现在 == 空 或者 取类型(现在) != "数值"
            现在 = 时间戳()

        定义 停滞阈值秒 = 本对象.停滞阈值分钟 * 60
        定义 告警阈值秒 = 本对象.告警阈值分钟 * 60
        定义 明细 = []
        定义 停滞数 = 0
        定义 nudge数 = 0
        定义 告警数 = 0

        遍历 单 在 列表
            尝试
                定义 编号 = 文本(单.编号)
                定义 秒差 = 现在 - 单.创建时间
                如果 秒差 < 0
                    秒差 = 0
                定义 停滞分钟 = 整数(秒差 / 60)
                定义 是否已停滞 = 假

                // 逐层判断绑定，避免依赖 或者 的短路行为。
                如果 单.阶段 == 阶段执行中
                    定义 绑定运行中 = 假
                    如果 单.绑定 != 空
                        如果 单.绑定.状态 == "running"
                            绑定运行中 = 真
                    如果 绑定运行中 == 假
                        如果 秒差 >= 停滞阈值秒
                            是否已停滞 = 真

                定义 级别 = "正常"
                定义 建议 = "状态正常，无需打扰。"

                如果 是否已停滞
                    级别 = "nudge"
                    建议 = `工单 {编号} 已停滞 {停滞分钟} 分钟，建议提醒执行者尽快推进。`
                    如果 秒差 >= 告警阈值秒
                        级别 = "告警"
                        建议 = `工单 {编号} 已停滞 {停滞分钟} 分钟，超过告警阈值，建议人工介入。`

                    // 报告映射：受阻 / 失败报告把 nudge 升级为告警。
                    // 逐层判断，避免依赖 并且 的短路行为。
                    如果 映射 != 空
                        如果 包含(映射, 编号)
                            定义 报告列表 = 映射[编号]
                            遍历 报告对象 在 报告列表
                                如果 报告对象.类型 == 报告受阻 或者 报告对象.类型 == 报告失败
                                    级别 = "告警"
                                    建议 = `工单 {编号} 收到受阻或失败报告且已停滞 {停滞分钟} 分钟，升级告警，建议人工介入。`

                    停滞数 = 停滞数 + 1
                    如果 级别 == "告警"
                        告警数 = 告警数 + 1
                    否则
                        nudge数 = nudge数 + 1

                追加(明细, {"工单编号": 编号, "停滞分钟": 停滞分钟, "级别": 级别, "建议": 建议})
            捕获 错误
                定义 忽略异常工单 = 错误

        本对象.最近巡检明细 = 明细

        定义 说明 = "注入历史时间戳模拟 30 分钟，不是真等 30 分钟；FR-16 真实定时巡检仍需生产长驻环境。"
        返回 {
            "巡检次数": 本对象.巡检次数,
            "停滞数": 停滞数,
            "nudge数": nudge数,
            "告警数": 告警数,
            "明细": 明细,
            "说明": 说明
        }

    // 注入一条历史工单：阶段执行中、绑定为空、创建时间回拨到 当前时间 - 停滞分钟*60。
    // 这是「注入历史时间戳模拟 30 分钟，不是真等 30 分钟」的关键入口。
    函数 注入停滞任务(工单编号, 标题, 停滞分钟, 当前时间=空)
        定义 现在 = 当前时间
        如果 现在 == 空 或者 取类型(现在) != "数值"
            现在 = 时间戳()
        定义 回拨秒 = 停滞分钟 * 60
        定义 工 = 工单(工单编号, 标题, "本地", 工单编号, "测试", 标题)
        工.阶段 = 阶段执行中
        工.绑定 = 空
        工.创建时间 = 现在 - 回拨秒
        返回 工

    // 生成 L2 决策：nudge 为温和提醒，alert 为人工介入告警，策略版本固定 v0.1。
    函数 生成nudge决策(工单编号, 停滞分钟)
        定义 理由 = `工单 {工单编号} 已停滞 {停滞分钟} 分钟，达到提醒阈值，建议执行者尽快推进。`
        返回 决策(工单编号, "nudge", 理由, "v0.1")

    // 生成 L2 决策：告警结论为 alert。
    函数 生成告警决策(工单编号, 停滞分钟)
        定义 理由 = `工单 {工单编号} 已停滞 {停滞分钟} 分钟，达到告警阈值，建议人工介入处理。`
        返回 决策(工单编号, "alert", 理由, "v0.1")

// 工厂：创建一个全新的看门狗（每次调用返回独立实例）。
导出 函数 创建看门狗(停滞阈值分钟=30, 告警阈值分钟=60)
    返回 看门狗(停滞阈值分钟, 告警阈值分钟)
