// 更夫 Nightwatch — 第七轮迭代 · L1 基础设施层 · GitHub 事件源适配器（PRD §13 开放问题 #1 默认首源）
// 职责：把 GitHub webhook 的 issues / pull_request / issue_comment 事件归一化成统一中文键字典，
//       并提供验签、生成领域触发、生成待投递回复载荷的封装。
// 分层归属：L1 基础设施层。只依赖领域层常量/类型与标准库 密码；不依赖 L3 / L4，供上层单向调用。
// 约束（契约 §0）：本地模拟，不发起任何真实网络请求、不创建真实 PR / 评论、不做真实 merge；
//                 PR closed 且 merged=true 仅生成「已合并」信号，交由 L4 编排工单信号。
// 所有失败都以 {"成功":假,"错误":中文提示} 返回或返回 空，绝不向上抛未捕获异常。

从 领域层.领域 导入 触发, 信道GitHub
从 密码 导入 HMACSHA256, 验证HMAC
从 文本 导入 小写, 分割

// ======================== 通用容错辅助（与 即时通信.道 风格保持一致） ========================

// 容错取字段：字典缺键或索引失败时返回默认值，绝不抛异常。
函数 安全取(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

// 把任意值安全地转成文本；空值走默认值。
函数 取文本(值, 默认值="")
    如果 值 == 空
        返回 默认值
    尝试
        返回 文本(值)
    捕获 错误
        返回 默认值

// 宽松布尔判定：兼容 真/假、字符串 "true"/"1"/"yes"、数字 1/0，避免 JSON 布尔值差异导致漏判。
函数 是真值(值)
    如果 值 == 真
        返回 真
    如果 值 == 假
        返回 假
    定义 文 = 小写(取文本(值, ""))
    如果 文 == "true" 或者 文 == "1" 或者 文 == "yes"
        返回 真
    返回 假

// 取请求头：先精确匹配，再忽略大小写兜底；兼容 DaoHttpRequest 原始键与离线自测字典。
函数 取头(请求对象, 键)
    定义 头 = 安全取(请求对象, "请求头", {})
    如果 取类型(头) != "字典"
        返回 ""
    定义 值 = 安全取(头, 键, 空)
    如果 值 != 空
        返回 取文本(值, "")
    遍历 头键 在 头
        如果 小写(取文本(头键, "")) == 小写(键)
            返回 取文本(头[头键], "")
    返回 ""

// 取请求体文本：真实 webhook 为原始 JSON 文本，离线自测可能直接给字典，统一转成文本供 HMAC 计算。
函数 取请求体文本(请求对象)
    定义 体 = 安全取(请求对象, "请求体", 空)
    如果 体 == 空
        返回 ""
    返回 取文本(体, "")

// GitHub 头形如 "sha256=<64位十六进制>"；去前缀时按等号切分并忽略大小写，格式不符则原样返回。
函数 去签名前缀(头值)
    定义 原文 = 取文本(头值, "")
    定义 片段 = 分割(原文, "=")
    如果 长度(片段) >= 2 并且 小写(片段[0]) == "sha256"
        返回 片段[1]
    返回 原文

// ======================== 验签（模块级，供适配器与 B 模块复用） ========================

// 验签 GitHub 请求：从 X-Hub-Signature-256 取 sha256= 后的十六进制签名，
// 与 HMACSHA256(密钥, 请求体) 比对（用常量时间的 验证HMAC，避免时序侧信道）。
// 缺密钥、缺头、格式非法、任何异常一律返回 假。
导出 函数 验签GitHub请求(请求对象, 签名密钥)
    尝试
        如果 长度(签名密钥) == 0
            返回 假
        定义 头值 = 取头(请求对象, "X-Hub-Signature-256")
        如果 长度(头值) == 0
            返回 假
        定义 签名 = 去签名前缀(头值)
        如果 长度(签名) == 0
            返回 假
        定义 请求体 = 取请求体文本(请求对象)
        // 显式算出期望摘要，确保与契约「HMACSHA256(密钥, 请求体)」口径一致；
        // 实际比对用 验证HMAC 以获得常量时间与大小写不敏感能力。
        定义 期望签名 = HMACSHA256(签名密钥, 请求体)
        如果 长度(期望签名) == 0
            返回 假
        返回 验证HMAC(签名密钥, 请求体, 签名)
    捕获 错误
        返回 假

// ======================== 事件解析辅助 ========================

// 判定正文或文本里是否点名机器人；GitHub 提及直接写在正文里（如 "@更夫 请修复"）。
函数 含机器人提及(正文)
    定义 文 = 小写(取文本(正文, ""))
    如果 包含(文, "@更夫") 或者 包含(文, "@机器人") 或者 包含(文, "@nightwatch") 或者 包含(文, "@bot")
        返回 真
    返回 假

// 判定事件字典是否显式请求触发：显式标志位或文本命令前缀，均视为无需 @机器人即可生成触发。
函数 是显式请求(事件字典)
    尝试
        如果 事件字典 == 空 或者 取类型(事件字典) != "字典"
            返回 假
        如果 是真值(安全取(事件字典, "显式请求", 假))
            返回 真
        如果 是真值(安全取(事件字典, "请求触发", 假))
            返回 真
        如果 是真值(安全取(事件字典, "强制触发", 假))
            返回 真
        定义 命令 = 小写(取文本(安全取(事件字典, "命令", ""), ""))
        如果 包含(命令, "/更夫") 或者 包含(命令, "/nightwatch")
            返回 真
        定义 文本 = 小写(取文本(安全取(事件字典, "文本", ""), ""))
        如果 包含(文本, "/更夫") 或者 包含(文本, "/nightwatch")
            返回 真
    捕获 错误
        返回 假
    返回 假

// 按载荷结构判定事件大类；优先评论、其次 PR、最后 issue。
// 若上层把 X-GitHub-Event 头合并进载荷，也接受显式的类别字段作为兜底。
函数 取事件类别(载荷)
    如果 安全取(载荷, "comment", 空) != 空
        返回 "issue_comment"
    如果 安全取(载荷, "pull_request", 空) != 空
        返回 "pull_request"
    如果 安全取(载荷, "issue", 空) != 空
        返回 "issues"
    定义 显式类别 = 取文本(安全取(载荷, "X-GitHub-Event", ""), "")
    如果 长度(显式类别) == 0
        显式类别 = 取文本(安全取(载荷, "event", ""), "")
    返回 显式类别

// 缺字段/非法载荷的降级结果：保证所有中文键齐全，调用方取键不会落空。
函数 降级结果(错误提示)
    返回 {"成功":假, "错误":错误提示, "来源信道":信道GitHub, "消息ID":"", "文本":"", "发送人":"", "话题键":"", "是否@机器人":假, "事件类型":"", "已合并":假}

// 核心归一化：从 payload 取主体对象，逐字段容错降级，返回统一中文键字典。
函数 解析GitHub事件(事件字典)
    尝试
        如果 事件字典 == 空 或者 取类型(事件字典) != "字典"
            返回 降级结果("GitHub 事件载荷为空或格式非法")
        定义 类别 = 取事件类别(事件字典)
        定义 动作 = 小写(取文本(安全取(事件字典, "action", ""), ""))
        如果 长度(类别) == 0
            定义 显式类型 = 取文本(安全取(事件字典, "事件类型", ""), "")
            如果 长度(显式类型) > 0
                类别 = 显式类型
        如果 长度(类别) == 0
            返回 降级结果("GitHub 事件缺少可识别的事件类别")
        定义 事件类型 = 类别
        如果 长度(动作) > 0
            事件类型 = 类别 + "." + 动作

        // 主体对象：issues 取 issue，pull_request 取 pull_request，issue_comment 取 comment。
        定义 主体 = 安全取(事件字典, "issue", {})
        如果 类别 == "pull_request"
            主体 = 安全取(事件字典, "pull_request", {})
        如果 类别 == "issue_comment"
            主体 = 安全取(事件字典, "comment", {})

        // 正文：优先 body，缺失时退回 title；评论事件再退回所属 issue 的 title。
        定义 正文 = 取文本(安全取(主体, "body", ""), "")
        如果 长度(正文) == 0
            正文 = 取文本(安全取(主体, "title", ""), "")
        如果 长度(正文) == 0
            正文 = 取文本(安全取(安全取(事件字典, "issue", {}), "title", ""), "")

        // 消息编号：优先对象 id，再退回 number / 所属 issue 的 number。
        定义 消息编号 = 取文本(安全取(主体, "id", ""), "")
        如果 长度(消息编号) == 0
            消息编号 = 取文本(安全取(主体, "number", ""), "")
        如果 长度(消息编号) == 0
            消息编号 = 取文本(安全取(安全取(事件字典, "issue", {}), "number", ""), "")

        // 发送人：优先主体 user.login，再退回顶层 sender.login。
        定义 发送人 = 取文本(安全取(安全取(主体, "user", {}), "login", ""), "")
        如果 长度(发送人) == 0
            发送人 = 取文本(安全取(安全取(事件字典, "sender", {}), "login", ""), "")

        // 话题键：仓库全名 + #编号，缺失时逐级降级为空串。
        定义 仓库全名 = 取文本(安全取(安全取(事件字典, "repository", {}), "full_name", ""), "")
        定义 编号 = 取文本(安全取(主体, "number", ""), "")
        如果 长度(编号) == 0
            编号 = 取文本(安全取(安全取(事件字典, "issue", {}), "number", ""), "")
        定义 话题键 = 仓库全名
        如果 长度(话题键) == 0
            话题键 = 编号
        如果 长度(仓库全名) > 0 并且 长度(编号) > 0
            话题键 = 仓库全名 + "#" + 编号

        // merged 信号：仅 pull_request.closed 且 merged=true 置真；只生成信号，不执行真实合并。
        定义 已合并 = 假
        如果 类别 == "pull_request" 并且 动作 == "closed"
            如果 是真值(安全取(主体, "merged", 假)) 或者 是真值(安全取(事件字典, "merged", 假))
                已合并 = 真

        返回 {"成功":真, "来源信道":信道GitHub, "消息ID":消息编号, "文本":正文, "发送人":发送人, "话题键":话题键, "是否@机器人":含机器人提及(正文), "事件类型":事件类型, "已合并":已合并}
    捕获 错误
        返回 降级结果(`GitHub 事件解析异常：{错误}`)

// ======================== 适配器对象 ========================

// GitHub 适配器：全部方法只做本地计算与载荷封装，不发起任何真实外部请求。
导出 类型 GitHub适配器
    初始化(仓库, 令牌, 本地模式)
        本对象.仓库 = 仓库
        本对象.令牌 = 令牌
        本对象.本地模式 = 本地模式

    // 本地模式恒真；非本地模式仅在仓库与令牌都非空时为真。全程不发起真实请求。
    函数 可用()
        如果 本对象.本地模式 == 真
            返回 真
        如果 长度(本对象.仓库) > 0 并且 长度(本对象.令牌) > 0
            返回 真
        返回 假

    // 本地模式默认放行——仅用于离线自测；真实环境须关闭本地模式并配置签名密钥。
    函数 验证签名(请求对象, 签名密钥="")
        如果 本对象.本地模式 == 真
            返回 真
        返回 验签GitHub请求(请求对象, 签名密钥)

    // 解析事件：委托模块级函数，已覆盖全部缺字段降级。
    函数 解析事件(事件字典)
        返回 解析GitHub事件(事件字典)

    // 仅归一化成功且命中 @机器人 或显式请求时生成触发，否则返回 空。
    // 触发参数：来源=github、外部编号、话题编号、发起人、内容、是否机器人=真、是否CI=假。
    函数 生成触发(事件字典)
        定义 结果 = 本对象.解析事件(事件字典)
        如果 安全取(结果, "成功", 假) != 真
            返回 空
        如果 安全取(结果, "是否@机器人", 假) != 真 并且 是显式请求(事件字典) != 真
            返回 空
        定义 外部编号 = 取文本(安全取(结果, "消息ID", ""), "")
        定义 话题编号 = 取文本(安全取(结果, "话题键", ""), "")
        定义 发起人 = 取文本(安全取(结果, "发送人", ""), "")
        定义 内容 = 取文本(安全取(结果, "文本", ""), "")
        返回 触发(信道GitHub, 外部编号, 话题编号, 发起人, 内容, 真, 假)

    // 只返回待投递载荷字典，不调用任何真实请求；键名与 即时通信.道 保持一致。
    函数 回复消息(话题键, 文本)
        返回 {"成功":真, "待发送":真, "来源信道":信道GitHub, "话题键":取文本(话题键, ""), "内容":取文本(文本, ""), "本地模拟":本对象.本地模式}

// ======================== 公开工厂函数 ========================

// 创建 GitHub 适配器：仓库为 "owner/repo"，令牌仅用于非本地模式的可用性判定，默认本地模拟。
导出 函数 创建GitHub适配器(仓库="", 令牌="", 本地模式=真)
    返回 GitHub适配器(仓库, 令牌, 本地模式)
