// 更夫 Nightwatch — 第九轮迭代 · L1 基础设施层 · 定时轮询兜底组件
// 职责：事件源拉取 + SHA256 幂等去重 + 回调派发；事件源与回调都由参数注入，
//       不依赖上层模块，供上层单向调用（L1 禁止反向依赖 L4）。
// 运行：由上层 import 使用；本文件只定义导出接口，不启动任何真实调度。
// 边界：事件源为本地注入的模拟源；所有失败以中文字典返回，绝不向上抛未捕获异常。
// 说明：本组件只做本地计算与回调派发，不发起任何真实外部请求。

从 密码 导入 SHA256
从 调度 导入 周期执行

// ======================== 通用容错辅助 ========================

// 容错取字段：字典缺键或索引失败时返回默认值，绝不抛异常。
函数 安全取(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

// 把任意值安全地转成文本；空值走默认值。
函数 取文本(值, 默认值="")
    如果 值 == 空
        返回 默认值
    尝试
        返回 文本(值)
    捕获 错误
        返回 默认值

// ======================== 去重键与去重集合辅助 ========================

// 取事件编号：优先 外部编号，兼容 webhook 归一化结果的 消息ID / 话题键；
// 全部缺失时降级为空串，保证拼接结果稳定。
函数 取事件编号(事件字典)
    定义 值 = 取文本(安全取(事件字典, "外部编号", ""), "")
    如果 长度(值) > 0
        返回 值
    值 = 取文本(安全取(事件字典, "消息ID", ""), "")
    如果 长度(值) > 0
        返回 值
    返回 取文本(安全取(事件字典, "话题键", ""), "")

// 导出：轮询去重键 = SHA256(编号 + "|" + 事件类型)，缺字段按空串拼接。
导出 函数 轮询去重键(事件字典)
    尝试
        定义 编号 = 取事件编号(事件字典)
        定义 类型文本 = 取文本(安全取(事件字典, "事件类型", ""), "")
        返回 SHA256(编号 + "|" + 类型文本)
    捕获 错误
        返回 SHA256("|")

// 判断已见集合是否已含某键；兼容外部传入的 list / dict。
函数 已见含键(集合, 键)
    如果 取类型(集合) == "字典"
        如果 安全取(集合, 键, 空) != 空
            返回 真
        返回 假
    遍历 项 在 集合
        如果 项 == 键
            返回 真
    返回 假

// 把新键记入已见集合；兼容外部传入的 list / dict。
函数 标记已见(集合, 键)
    如果 取类型(集合) == "字典"
        集合[键] = 真
        返回
    追加(集合, 键)

// ======================== 轮询兜底器 ========================

导出 类型 轮询兜底器
    初始化(事件源, 回调, 已见集合=空)
        本对象.事件源 = 事件源
        本对象.回调 = 回调
        如果 已见集合 == 空
            本对象.已见集合 = []
        否则
            本对象.已见集合 = 已见集合

    // 轮询一次：拉取事件源列表，逐条判重并派发；所有异常都降级为计数，不向上传播。
    函数 轮询一次()
        定义 拉取 = 0
        定义 新事件 = 0
        定义 重复跳过 = 0
        定义 失败 = 0
        定义 事件列表 = 空

        尝试
            事件列表 = 本对象.事件源()
        捕获 错误
            返回 {"成功":真, "拉取":0, "新事件":0, "重复跳过":0, "失败":0, "拉取失败":真}

        如果 事件列表 == 空 或者 取类型(事件列表) != "列表"
            返回 {"成功":真, "拉取":0, "新事件":0, "重复跳过":0, "失败":0, "拉取失败":假}

        遍历 事件项 在 事件列表
            拉取 = 拉取 + 1
            尝试
                定义 键 = 轮询去重键(事件项)
                如果 已见含键(本对象.已见集合, 键) == 真
                    重复跳过 = 重复跳过 + 1
                否则
                    标记已见(本对象.已见集合, 键)
                    尝试
                        本对象.回调(事件项)
                        新事件 = 新事件 + 1
                    捕获 错误
                        失败 = 失败 + 1
            捕获 错误
                失败 = 失败 + 1

        返回 {"成功":真, "拉取":拉取, "新事件":新事件, "重复跳过":重复跳过, "失败":失败, "拉取失败":假}

    // 返回已见去重键数量；兼容 list / dict 两种已见集合。
    函数 已见数()
        返回 长度(本对象.已见集合)

// ======================== 公开工厂函数 ========================

// 创建轮询兜底器：事件源为无参函数，回调为单参函数，已见集合可外部传入并跨调用共享。
导出 函数 创建轮询兜底(事件源, 回调, 已见集合=空)
    返回 轮询兜底器(事件源, 回调, 已见集合)

// 创建定时轮询：用周期执行启动轮询器的 .轮询一次；调度注入便于测试传假调度器。
// 返回 {"调度器":对象/空,"调度ID":整数/空,"轮询器":轮询器}；异常时调度ID 降级为空。
导出 函数 创建定时轮询(轮询器, 间隔毫秒=60000, 调度注入=空)
    定义 调度器 = 调度注入
    定义 调度ID = 空

    函数 定时回调()
        轮询器.轮询一次()

    尝试
        如果 调度器 == 空
            调度ID = 周期执行(间隔毫秒, 定时回调)
        否则
            调度ID = 调度器.周期执行(间隔毫秒, 定时回调)
    捕获 错误
        调度ID = 空

    返回 {"调度器":调度器, "调度ID":调度ID, "轮询器":轮询器}
