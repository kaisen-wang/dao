// 更夫 Nightwatch — Web 看板骨架与审计流（L1 基础设施层 / 呈现）
// 对应 PRD《常驻研发协作 Agent》FR-14（Web 面板）与 FR-16（Watchdog 巡检展示）。
// 本模块手写一个轻量 HTTP 看板：工单按阶段分组、决策审计流、全局暂停开关。
// 只产出简单 UTF-8 文本 HTML，不引入模板引擎，不依赖 GitHub 相关部分。
// 分层归属：L1 基础设施层，只负责把领域数据渲染为 HTML，不持有业务规则；
// 输入来自上层传入的取数回调与状态字典，因此不反向依赖 L3/L4。
// 第二轮迭代增强：首页标注 LLM 运行模式；审计页原样转义输出决策理由，
// 理由文本已由评估层标注「LLM语义判断：」或「关键词规则：」前缀，据此可区分来源。
// 第四轮迭代增强（可靠性工程）：新增「预算」成本仪表页与「审计导出」JSON 导出，
// 对应 PRD §12 可运维性要求；既有导出签名保持不变，仅新增方法。
// 导出签名保持不变：创建看板 / 处理暂停 / .首页() / .审计页() / .注册()。

从 领域层.领域 导入 阶段排队, 阶段执行中, 阶段等事件, 阶段待审核, 阶段受阻, 阶段失败, 阶段结束
从 文本 导入 替换
从 编码 导入 JSON

// ======================== 渲染辅助（具名函数，避开匿名函数单行限制） ========================

// 把文本中的 HTML 特殊字符转义为实体，避免领域描述内容破坏页面结构。
// 先替换「&」再替换「<」「>」，防止对已生成的实体二次转义。
// 决策理由中的「LLM语义判断：」「关键词规则：」前缀会被原样保留，供审计流区分来源。
函数 转义HTML(文本)
    定义 结果 = 替换(文本, "&", "&amp;")
    结果 = 替换(结果, "<", "&lt;")
    结果 = 替换(结果, ">", "&gt;")
    返回 结果

// 过滤出指定阶段的工单列表。
函数 分组工单(工单列表, 阶段值)
    定义 结果 = []
    遍历 单 在 工单列表
        如果 单.阶段 == 阶段值
            追加(结果, 单)
    返回 结果

// 把一个阶段渲染成一段 HTML：中文标题、数量、工单描述列表。
函数 渲染阶段(工单列表, 阶段值, 标题)
    定义 组内 = 分组工单(工单列表, 阶段值)
    定义 数量 = 长度(组内)
    定义 片段 = `<h2>{标题}（{数量}）</h2>`
    如果 数量 > 0
        定义 列表HTML = ""
        遍历 单 在 组内
            定义 一行 = 转义HTML(单.描述())
            定义 条目 = `<li>{一行}</li>`
            列表HTML = 列表HTML + 条目
        片段 = 片段 + `<ul>` + 列表HTML + `</ul>`
    返回 片段

// 首页：展示当前模式、暂停状态，以及七个阶段的工单分组。
函数 渲染首页(工单列表, 状态字典)
    定义 模式 = 状态字典["模式"]
    定义 暂停中 = 状态字典["暂停中"]
    定义 暂停文本 = "运行中"
    如果 暂停中
        暂停文本 = "已暂停"
    定义 头部 = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>更夫看板</title></head><body>`
    定义 标题段 = `<h1>更夫 Nightwatch 看板</h1><p>当前模式：{模式}　暂停状态：{暂停文本}</p>`
    // 第二轮新增：静态标注 LLM 运行模式与降级规则，便于使用者一眼看清当前能力来源。
    定义 说明段 = `<p>LLM 模式：本地 ollama gemma4:e4b（不可用时自动降级为关键词规则）</p>`
    定义 正文 = ""
    正文 = 正文 + 渲染阶段(工单列表, 阶段排队, "排队")
    正文 = 正文 + 渲染阶段(工单列表, 阶段执行中, "执行中")
    正文 = 正文 + 渲染阶段(工单列表, 阶段等事件, "等事件")
    正文 = 正文 + 渲染阶段(工单列表, 阶段待审核, "待审核")
    正文 = 正文 + 渲染阶段(工单列表, 阶段受阻, "受阻")
    正文 = 正文 + 渲染阶段(工单列表, 阶段失败, "失败")
    正文 = 正文 + 渲染阶段(工单列表, 阶段结束, "结束")
    定义 尾部 = `<hr><a href="/审计">查看审计流</a></body></html>`
    返回 头部 + 标题段 + 说明段 + 正文 + 尾部

// 审计页：逐条显示决策描述，提供中文表头。
// 决策理由已由评估层标注来源前缀（「LLM语义判断：」或「关键词规则：」），
// 这里仅做 HTML 转义后原样输出，不改写领域对象，审计流据此区分来源。
函数 渲染审计页(决策列表)
    定义 头部 = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>观察审计流</title></head><body>`
    定义 表头 = `<h1>观察候选审计流</h1><table border="1"><tr><th>序号</th><th>决策描述（含来源标记）</th></tr>`
    定义 行集 = ""
    定义 序号 = 0
    遍历 决 在 决策列表
        序号 = 序号 + 1
        定义 描述 = 转义HTML(决.描述())
        定义 单元 = `<tr><td>{序号}</td><td>{描述}</td></tr>`
        行集 = 行集 + 单元
    定义 尾部 = `</table><hr><a href="/">返回看板</a></body></html>`
    返回 头部 + 表头 + 行集 + 尾部

// ======================== 第四轮：预算仪表与审计导出辅助 ========================

// 容错读取字典键：键不存在或读取异常时返回默认值，避免单个字段缺失破坏整页渲染。
函数 安全取值(字典, 键, 默认值)
    尝试
        如果 键 在 字典
            返回 字典[键]
    捕获 错误
        返回 默认值
    返回 默认值

// 按候选键列表依次读取用量值，返回第一个存在键的值；都不存在则返回默认值。
// 兼容上层以不同键名（如「已用调用次数」或「调用次数」）组装预算子字典。
函数 取用量值(字典, 候选键列表, 默认值)
    遍历 键 在 候选键列表
        定义 值 = 安全取值(字典, 键, 空)
        如果 值 != 空
            返回 值
    返回 默认值

// 把预算子字典渲染为中文成本仪表页：三项上限与当前用量以表格呈现。
// 预算子字典缺失时由调用方改渲染「未提供预算数据」占位页。
函数 渲染预算页(预算字典)
    定义 头部 = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>成本仪表</title></head><body>`
    定义 标题段 = `<h1>成本仪表</h1><p>预算上限与当前用量一览</p>`
    定义 表头 = `<table border="1"><tr><th>指标</th><th>上限</th><th>当前用量</th></tr>`
    定义 单票调用上限 = 安全取值(预算字典, "单票调用", "未提供")
    定义 单票token上限 = 安全取值(预算字典, "单票token", "未提供")
    定义 全局日上限 = 安全取值(预算字典, "全局日上限", "未提供")
    定义 已用调用 = 取用量值(预算字典, ["已用调用次数", "调用次数", "已用单票调用"], 0)
    定义 已用token = 取用量值(预算字典, ["已用token数", "token数", "已用单票token"], 0)
    定义 已用成本 = 取用量值(预算字典, ["累计成本", "已用成本", "当前成本"], 0)
    定义 行集 = ""
    行集 = 行集 + `<tr><td>单票调用</td><td>{单票调用上限}</td><td>{已用调用}</td></tr>`
    行集 = 行集 + `<tr><td>单票token</td><td>{单票token上限}</td><td>{已用token}</td></tr>`
    行集 = 行集 + `<tr><td>全局日上限</td><td>{全局日上限}</td><td>{已用成本}</td></tr>`
    定义 尾部 = `</table><hr><a href="/">返回看板</a>　<a href="/审计导出">导出审计 JSON</a></body></html>`
    返回 头部 + 标题段 + 表头 + 行集 + 尾部

// 未提供预算数据时的占位页，保持页面结构完整。
函数 渲染预算缺失页()
    定义 头部 = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>成本仪表</title></head><body>`
    定义 标题段 = `<h1>成本仪表</h1>`
    定义 尾部 = `<hr><a href="/">返回看板</a></body></html>`
    返回 头部 + 标题段 + `<p>未提供预算数据</p>` + 尾部

// 把领域决策对象转为审计导出用的中文键字典，字段与 PRD 审计要求一致。
函数 决策转字典(决)
    返回 {"触发编号": 决.触发编号, "结论": 决.结论, "理由": 决.理由, "策略版本": 决.策略版本}

// ======================== 看板对象 ========================

类型 看板
    初始化(取工单函数, 取决策函数, 状态字典)
        本对象.取工单函数 = 取工单函数
        本对象.取决策函数 = 取决策函数
        本对象.状态字典 = 状态字典

    函数 首页()
        定义 工单列表 = 本对象.取工单函数()
        返回 渲染首页(工单列表, 本对象.状态字典)

    函数 审计页()
        定义 决策列表 = 本对象.取决策函数()
        返回 渲染审计页(决策列表)

    // 第四轮新增：成本仪表页。状态字典无「预算」子字典时给出中文占位提示。
    函数 预算页()
        定义 预算字典 = 空
        尝试
            预算字典 = 本对象.状态字典["预算"]
        捕获 错误
            预算字典 = 空
        如果 预算字典 == 空
            返回 渲染预算缺失页()
        返回 渲染预算页(预算字典)

    // 第四轮新增：把审计决策导出为 JSON 文本，字段统一转成中文键。
    函数 审计导出()
        定义 决策列表 = 本对象.取决策函数()
        定义 中文列表 = []
        遍历 决 在 决策列表
            追加(中文列表, 决策转字典(决))
        返回 JSON.编码(中文列表, 2)

    // 具名响应函数：在内部构造返回字典，供单行匿名路由回调调用。
    // HTML 页面须显式声明「内容类型」，否则标准库默认按 application/json 发送。
    函数 首页响应(请求)
        返回 {"状态码": 200, "内容": 本对象.首页(), "内容类型": "text/html; charset=utf-8"}

    函数 审计响应(请求)
        返回 {"状态码": 200, "内容": 本对象.审计页(), "内容类型": "text/html; charset=utf-8"}

    函数 预算响应(请求)
        返回 {"状态码": 200, "内容": 本对象.预算页(), "内容类型": "text/html; charset=utf-8"}

    函数 审计导出响应(请求)
        // JSON 导出走标准库默认的 application/json 响应头。
        返回 {"状态码": 200, "内容": 本对象.审计导出()}

    // 注册路由：处理函数一律写成单行 函数(请求) => 表达式，复杂逻辑留在具名函数里。
    函数 注册(服务器)
        定义 自我 = 本对象
        服务器.路由("GET", "/", 函数(请求) => 自我.首页响应(请求))
        服务器.路由("GET", "/审计", 函数(请求) => 自我.审计响应(请求))
        服务器.路由("POST", "/暂停", 函数(请求) => 处理暂停(自我.状态字典, 请求))
        服务器.路由("GET", "/预算", 函数(请求) => 自我.预算响应(请求))
        服务器.路由("GET", "/审计导出", 函数(请求) => 自我.审计导出响应(请求))

// ======================== 导出接口 ========================

// 切换全局暂停布尔值，返回带中文提示的响应字典。
导出 函数 处理暂停(状态字典, 请求)
    定义 提示 = ""
    如果 状态字典["暂停中"]
        状态字典["暂停中"] = 假
        提示 = "已恢复运行，工单继续处理"
    否则
        状态字典["暂停中"] = 真
        提示 = "已全局暂停，工单暂停处理"
    返回 {"状态码": 200, "内容": 提示}

// 工厂：由取工单函数、取决策函数与状态字典构造看板对象。
导出 函数 创建看板(取工单函数, 取决策函数, 状态字典)
    返回 看板(取工单函数, 取决策函数, 状态字典)
