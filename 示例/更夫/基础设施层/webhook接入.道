// 更夫 Nightwatch — 第六轮迭代 · L1 基础设施层 · IM Webhook HTTP 接入端点（契约 §2 B）
// 职责：对飞书 / 企微回调请求做验签、事件归一化、触发生成与回执，供 L4 webhook服务.道 注册路由。
// 分层归属：L1 基础设施层。只依赖领域层常量与标准库 密码、编码、即时通信；
//           不依赖 L3 应用层、L4 接入层，不发起任何真实外部 HTTP 请求（契约 §0）。
// 诚实边界：本文件只提供「可被真实平台回调」的接入能力，未做真实平台闭环验证。
// 所有失败都以中文字典返回，绝不向上抛异常。

从 基础设施层.即时通信 导入 创建飞书适配器, 创建企微适配器, 归一化事件
从 领域层.领域 导入 信道飞书, 信道企微
从 密码 导入 HMACSHA256, 验证HMAC, SHA256
从 编码 导入 JSON
从 文本 导入 小写, 分割

// ======================== 内部辅助函数 ========================

// 容错取字段：字典缺键、键值为空或对象不可索引时返回默认值，绝不抛异常。
函数 安全取(对象, 键, 默认值)
    尝试
        定义 值 = 对象[键]
        如果 值 == 空
            返回 默认值
        返回 值
    捕获 错误
        返回 默认值

// 把任意值安全地转成文本；空值走默认值。
函数 取文本(值, 默认值="")
    如果 值 == 空
        返回 默认值
    尝试
        返回 文本(值)
    捕获 错误
        返回 默认值

// 取请求头：先按原始大小写精确匹配，再按忽略大小写兜底（DaoHttpRequest 的「请求头」保留原始键）。
函数 取头(请求对象, 键)
    定义 头 = 安全取(请求对象, "请求头", {})
    如果 取类型(头) != "字典"
        返回 ""
    定义 值 = 安全取(头, 键, 空)
    如果 值 != 空
        返回 取文本(值, "")
    遍历 头键 在 头
        如果 小写(取文本(头键, "")) == 小写(键)
            返回 取文本(头[头键], "")
    返回 ""

// 从路径的查询串中取参数；ts / nonce / 签名可能放在 query 而非请求头。
函数 取查询参数(路径, 键)
    定义 片段 = 分割(取文本(路径, ""), "?")
    如果 长度(片段) < 2
        返回 ""
    遍历 对 在 分割(片段[1], "&")
        定义 键值 = 分割(对, "=")
        如果 长度(键值) >= 2 并且 键值[0] == 键
            返回 键值[1]
    返回 ""

// 取事件字典：请求体既可能是 JSON 文本（DaoHttpRequest），也可能直接是字典（离线自测）。
// 解码失败、非字典一律降级为空字典，由后续归一化给出中文错误，不抛异常。
// 直接给字典时做一次 JSON 往返深拷贝：事件归一化会原地补写 message / header 字段，
// 若不隔离，本地模式下基于请求体哈希的签名键会在解析前后漂移，导致重放防护漏判。
函数 取请求体字典(请求对象)
    定义 体 = 安全取(请求对象, "请求体", "")
    如果 取类型(体) == "字典"
        尝试
            定义 副本 = JSON.解码(JSON.编码(体))
            如果 取类型(副本) == "字典"
                返回 副本
        捕获 错误
            返回 体
        返回 体
    如果 取类型(体) == "文本"
        尝试
            定义 结果 = JSON.解码(体)
            如果 取类型(结果) == "字典"
                返回 结果
        捕获 错误
            返回 {}
    返回 {}

// 计算去重签名键：优先用「时间戳+nonce」拼接；两者都缺失时用请求体 SHA256（字典先编码成文本）。
// 本地模式下请求头通常为空，因此走请求体哈希分支，同样能识别同一请求的重复投递。
// 任何异常都降级为请求体哈希或空串，绝不抛异常。
函数 取签名键(请求对象)
    定义 时间戳 = 取头(请求对象, "X-Lark-Request-Timestamp")
    如果 长度(时间戳) == 0
        时间戳 = 取头(请求对象, "timestamp")
    定义 nonce = 取头(请求对象, "X-Lark-Request-Nonce")
    如果 长度(nonce) == 0
        nonce = 取头(请求对象, "nonce")
    如果 长度(时间戳) > 0 或者 长度(nonce) > 0
        返回 "TS:" + 时间戳 + "|N:" + nonce
    定义 体 = 安全取(请求对象, "请求体", "")
    定义 体文本 = ""
    如果 取类型(体) == "字典"
        尝试
            体文本 = JSON.编码(体)
        捕获 错误
            体文本 = ""
    否则
        体文本 = 取文本(体, "")
    返回 "HASH:" + SHA256(体文本)

// 飞书真实验签：HMAC-SHA256(时间戳\n随机数\n请求体\n)，用应用密钥作签名密钥。
// 仅在本地模式关闭后调用；本地模式不放行到此函数。
函数 验证飞书签名(请求对象, 密钥)
    如果 长度(密钥) == 0
        返回 假
    定义 时间戳 = 取头(请求对象, "X-Lark-Request-Timestamp")
    定义 随机数 = 取头(请求对象, "X-Lark-Request-Nonce")
    定义 签名 = 取头(请求对象, "X-Lark-Signature")
    定义 请求体 = 取文本(安全取(请求对象, "请求体", ""), "")
    如果 长度(签名) == 0
        返回 假
    定义 签名串 = 时间戳 + "\n" + 随机数 + "\n" + 请求体 + "\n"
    返回 验证HMAC(密钥, 签名串, 签名)

// 企微真实验签：token 比对。先取请求头，缺失时回退 query；
// 支持「签名 == token」字符串相等，也支持 SHA256(token+timestamp+nonce) 摘要比对。
函数 验证企微签名(请求对象, token)
    如果 长度(token) == 0
        返回 假
    定义 签名 = 取头(请求对象, "msg_signature")
    定义 时间戳 = 取头(请求对象, "timestamp")
    定义 随机数 = 取头(请求对象, "nonce")
    定义 路径 = 取文本(安全取(请求对象, "路径", ""), "")
    如果 长度(签名) == 0
        签名 = 取查询参数(路径, "msg_signature")
    如果 长度(时间戳) == 0
        时间戳 = 取查询参数(路径, "timestamp")
    如果 长度(随机数) == 0
        随机数 = 取查询参数(路径, "nonce")
    如果 长度(签名) == 0
        返回 假
    如果 签名 == token
        返回 真
    如果 签名 == SHA256(token + 时间戳 + 随机数)
        返回 真
    如果 签名 == SHA256(token)
        返回 真
    返回 假

// 飞书事件兼容预处理：真实 webhook 把 sender 放在顶层，而即时通信解析器读 event.sender。
// 这里把顶层 sender / event_id / chat_id 归一成解析器认识的结构；缺字段用空串兜底。
函数 兼容飞书事件(原始)
    定义 事件体 = 安全取(原始, "event", {})
    如果 取类型(事件体) != "字典"
        事件体 = {}
    定义 消息体 = 安全取(事件体, "message", {})
    如果 取类型(消息体) != "字典"
        消息体 = {}
    定义 头 = 安全取(原始, "header", {})
    如果 取类型(头) != "字典"
        头 = {}
    定义 发送体 = 安全取(事件体, "sender", 安全取(原始, "sender", {}))
    如果 取类型(发送体) != "字典"
        发送体 = {}
    // 正文可能直接在 event.content，搬进 message.content 供解析器读取。
    如果 长度(取文本(安全取(消息体, "content", ""), "")) == 0
        定义 直接正文 = 取文本(安全取(事件体, "content", ""), "")
        如果 长度(直接正文) > 0
            消息体["content"] = 直接正文
    // chat_id 可能在 event 上，补进 message。
    定义 话题 = 取文本(安全取(消息体, "chat_id", 安全取(事件体, "chat_id", "")), "")
    如果 长度(话题) > 0
        消息体["chat_id"] = 话题
    // event_id 可能在顶层，补进 header。
    如果 长度(取文本(安全取(头, "event_id", ""), "")) == 0
        定义 事件编号 = 取文本(安全取(原始, "event_id", ""), "")
        如果 长度(事件编号) > 0
            头["event_id"] = 事件编号
    返回 {"header": 头, "event": {"message": 消息体, "sender": 发送体, "chat_id": 话题}}

// 企微事件兼容预处理：真实 webhook 把正文放 Text.Content、发送人放 From.Id，
// 而即时通信解析器读顶层 Content / FromUserName / MsgId。这里做字段搬移，缺字段降级为空。
函数 兼容企微事件(原始)
    定义 文本体 = 安全取(原始, "Text", {})
    如果 取类型(文本体) != "字典"
        文本体 = {}
    定义 来源体 = 安全取(原始, "From", {})
    如果 取类型(来源体) != "字典"
        来源体 = {}
    定义 正文候选 = 安全取(文本体, "Content", "")
    定义 正文 = 取文本(安全取(原始, "Content", 正文候选), "")
    定义 发送人候选 = 安全取(来源体, "Id", 安全取(来源体, "UserId", ""))
    定义 发送人 = 取文本(安全取(原始, "FromUserName", 发送人候选), "")
    定义 编号候选 = 安全取(原始, "MsgID", 安全取(原始, "Msgid", ""))
    定义 消息编号 = 取文本(安全取(原始, "MsgId", 编号候选), "")
    定义 话题 = 取文本(安全取(原始, "ChatId", ""), "")
    定义 提及 = 安全取(原始, "MentionedList", 安全取(原始, "mentions", []))
    返回 {"Content": 正文, "FromUserName": 发送人, "MsgId": 消息编号, "ChatId": 话题, "MentionedList": 提及}

// ======================== Webhook 接入对象 ========================

导出 类型 Webhook接入
    初始化(平台, 应用ID, 应用密钥, 本地模式, 回调)
        本对象.平台 = 平台
        本对象.应用ID = 应用ID
        本对象.应用密钥 = 应用密钥
        本对象.本地模式 = 本地模式
        本对象.回调 = 回调
        // 第七轮新增：最近 N 条签名键去重表（只保留唯一键，超出上限淘汰最旧一条）。
        本对象.已见签名 = []
        本对象.去重上限 = 64

    函数 是企微()
        返回 本对象.平台 == 信道企微

    // 验签密钥：飞书用应用密钥签名；企微把应用密钥当 token，为空时回退用应用ID。
    函数 验签密钥()
        如果 本对象.是企微()
            如果 长度(本对象.应用密钥) > 0
                返回 本对象.应用密钥
            返回 本对象.应用ID
        返回 本对象.应用密钥

    // 去重表是否含某签名键；含则返回真。
    函数 含签名键(键)
        遍历 已见 在 本对象.已见签名
            如果 已见 == 键
                返回 真
        返回 假

    // 验签成功时记录签名键：已存在则不重复追加，超出上限淘汰最旧一条。
    // 本地模式放行的验签同样会记录，因此重放防护在本地模式也生效。
    函数 记录签名键(请求对象)
        定义 键 = 取签名键(请求对象)
        如果 长度(键) == 0
            返回
        如果 本对象.含签名键(键)
            返回
        追加(本对象.已见签名, 键)
        如果 长度(本对象.已见签名) > 本对象.去重上限
            定义 新表 = []
            遍历 i 从 1 到 长度(本对象.已见签名) - 1
                追加(新表, 本对象.已见签名[i])
            本对象.已见签名 = 新表

    // 第七轮新增：判断请求是否为重放——签名键已在去重表中即返回真。
    // 注意：本方法只查表、不改状态；记录由 验证签名 成功后完成。
    函数 是重放(请求对象)
        定义 键 = 取签名键(请求对象)
        如果 长度(键) == 0
            返回 假
        返回 本对象.含签名键(键)

    // 验签：本地模式默认放行以便离线自测。
    // 注意：本地模式的放行只为离线自测，真实平台必须关闭本地模式（本地模式=假）并正确验签。
    // 验签成功即记录签名键（供 是重放 / 处理 判重），不改变验签本身的返回值。
    函数 验证签名(请求对象)
        定义 通过 = 假
        如果 本对象.本地模式 == 真
            通过 = 真
        否则如果 本对象.是企微()
            通过 = 验证企微签名(请求对象, 本对象.验签密钥())
        否则
            通过 = 验证飞书签名(请求对象, 本对象.验签密钥())
        如果 通过 == 真
            本对象.记录签名键(请求对象)
        返回 通过

    // 事件归一化：底层统一调用 即时通信.归一化事件，按平台选择适配器。
    函数 解析事件(请求对象)
        定义 原始 = 取请求体字典(请求对象)
        如果 本对象.是企微()
            定义 企微适配器 = 创建企微适配器(本对象.应用ID, 本对象.应用密钥, 本对象.本地模式)
            返回 归一化事件(企微适配器, 兼容企微事件(原始))
        定义 飞书适配器 = 创建飞书适配器(本对象.应用ID, 本对象.应用密钥, 本对象.本地模式)
        返回 归一化事件(飞书适配器, 兼容飞书事件(原始))

    // 生成领域触发：复用适配器 .生成触发()，仅在正文艾特机器人时返回触发对象，否则为空。
    函数 生成触发对象(请求对象, 事件字典)
        定义 原始 = 取请求体字典(请求对象)
        如果 本对象.是企微()
            定义 企微适配器 = 创建企微适配器(本对象.应用ID, 本对象.应用密钥, 本对象.本地模式)
            返回 企微适配器.生成触发(兼容企微事件(原始))
        定义 飞书适配器 = 创建飞书适配器(本对象.应用ID, 本对象.应用密钥, 本对象.本地模式)
        返回 飞书适配器.生成触发(兼容飞书事件(原始))

    // 端到端处理：重放预检 → 验签 → 归一化 → 生成触发 → 调用回调 → 回执。
    // 验签失败 401；重放 409（不调用回调）；归一化失败或解析异常 400；成功 200。
    // 全程不发起真实外部请求。
    函数 处理(请求对象)
        // 在验签写去重表之前先读快照：同一签名键第二次出现即为重放。
        // 顺序不可颠倒，否则首次处理会被自己刚记录的签名键误判为重放。
        定义 请求已是重放 = 本对象.是重放(请求对象)
        如果 本对象.验证签名(请求对象) != 真
            返回 {"状态码": 401, "内容": "签名验证失败"}
        如果 请求已是重放 == 真
            返回 {"状态码": 409, "内容": "重复事件"}
        尝试
            定义 事件 = 本对象.解析事件(请求对象)
            如果 取类型(事件) != "字典"
                返回 {"状态码": 400, "内容": "事件解析失败"}
            如果 安全取(事件, "成功", 假) != 真
                返回 {"状态码": 400, "内容": "事件解析失败"}
            // 底层解析器把空串正文当作成功，这里补一道正文非空校验，缺失即 400。
            如果 长度(取文本(安全取(事件, "文本", ""), "")) == 0
                返回 {"状态码": 400, "内容": "事件正文缺失"}
            定义 触 = 本对象.生成触发对象(请求对象, 事件)
            如果 本对象.回调 != 空
                尝试
                    本对象.回调({"事件": 事件, "触发": 触})
                捕获 回调错误
                    // 回调自身异常不阻断 webhook 主流程回执。
                    定义 忽略 = 回调错误
            返回 {"状态码": 200, "内容": "成功"}
        捕获 错误
            返回 {"状态码": 400, "内容": "事件解析异常"}

// ======================== 公开工厂函数 ========================

// 创建 Webhook 接入对象。平台取值 "feishu" / "wecom"；
// 本地模式默认真（放行验签仅用于离线自测，真实平台必须置假）。
导出 函数 创建Webhook接入(平台="feishu", 应用ID="", 应用密钥="", 本地模式=真, 回调=空)
    返回 Webhook接入(平台, 应用ID, 应用密钥, 本地模式, 回调)
