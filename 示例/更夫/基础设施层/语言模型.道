// 更夫 Nightwatch — 第二轮迭代 · L1 基础设施层（Infrastructure）
// 职责：封装「大模型」标准库，提供本地 ollama 语言模型的创建、惰性可用性探测、
//       对话、结构化 JSON 判断与多轮工具对话；所有失败都以字典返回，绝不向上抛异常。
// 分层归属：L1 基础设施层。只依赖标准库（大模型 / 系统 / 编码 / 文本），
//           不依赖 L2 领域层、L3 应用层、L4 接入层，供 L3 单向调用。
// 对应需求：FR-11（LLM 语义判断）、FR-12（LLM 驱动 Worker）及其降级路径。
// 约束：导入本模块时只做定义，不发起任何网络请求。

从 大模型 导入 消息, 创建客户端, 对话, 列出模型, 工具对话
从 系统 导入 取环境变量
从 编码 导入 JSON
从 文本 导入 截取

// L1 桥接的多轮工具对话函数：绑定到解释器上下文。赋给模块变量以避免与同名方法歧义；
// 此处只做函数引用赋值，不发起任何网络请求。
定义 工具对话桥接 = 工具对话

// ======================== 内部辅助函数 ========================

// 容错取字段：响应字典在失败时可能缺少某些键，取不到则返回默认值。
函数 安全取(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

// 找首个左花括号的位置；找不到返回 -1。
// 注：全局内置「查找」是高阶函数（找满足谓词的元素），故此处用遍历实现。
函数 找首括号(文本)
    遍历 i 从 0 到 长度(文本) - 1
        如果 文本[i] == "{"
            返回 i
    返回 -1

// 找最后一个右花括号的位置；找不到返回 -1。
函数 找末括号(文本)
    定义 结果 = -1
    遍历 i 从 0 到 长度(文本) - 1
        如果 文本[i] == "}"
            结果 = i
    返回 结果

// ======================== 公开工厂函数 ========================

// 本地模型配置：读取环境变量，返回创建客户端所需的英文键配置字典。
// OLLAMA_HOST 默认 http://localhost:11434，OLLAMA_MODEL 默认 gemma4:e4b。
导出 函数 本地模型配置()
    定义 主机 = 取环境变量("OLLAMA_HOST", "http://localhost:11434")
    定义 模型 = 取环境变量("OLLAMA_MODEL", "gemma4:e4b")
    返回 {"host": 主机, "model": 模型, "timeout": 120}

// 创建语言模型：配置为空时用本地模型配置；创建客户端失败则降级为「不可用」对象。
// 无论如何都不抛异常，调用方拿到对象后可用 .可用() 判断真实可用性。
导出 函数 创建语言模型(提供者="ollama", 配置=空)
    定义 实际配置 = 配置
    如果 实际配置 == 空
        实际配置 = 本地模型配置()
    定义 客户端 = 空
    定义 可用标志 = 真
    定义 错误信息 = ""
    尝试
        客户端 = 创建客户端(提供者, 实际配置)
    捕获 错误
        可用标志 = 假
        错误信息 = `创建客户端失败：{错误}`
    返回 语言模型(客户端, 可用标志, 错误信息, 实际配置)

// ======================== 语言模型对象 ========================

导出 类型 语言模型
    初始化(客户端, 可用标志, 错误信息, 配置)
        本对象.客户端 = 客户端
        本对象.可用标志 = 可用标志
        本对象.错误信息 = 错误信息
        本对象.配置 = 配置
        本对象.已探测 = 假
        本对象.探测结果 = 假

    // 惰性探测：首次调用时列出模型，成功且列表非空为真；结果缓存，避免重复探测。
    // 创建客户端已失败的对象直接返回假，不再发起任何请求。
    函数 可用()
        如果 本对象.可用标志 == 假
            返回 假
        如果 本对象.已探测
            返回 本对象.探测结果
        本对象.已探测 = 真
        本对象.探测结果 = 假
        尝试
            定义 模型表 = 列出模型(本对象.客户端)
            // 成功时为模型名列表（取字符串键会抛异常）；失败时为 {"成功":假,"错误":...} 字典。
            定义 失败 = 真
            尝试
                如果 模型表["成功"] == 假
                    失败 = 真
                否则
                    失败 = 假
            捕获 错误
                失败 = 假
            如果 失败 == 假 并且 长度(模型表) > 0
                本对象.探测结果 = 真
        捕获 错误
            本对象.探测结果 = 假
        返回 本对象.探测结果

    // 对话：返回 {"成功","内容","错误","用量"}。失败不抛异常；
    // 系统提示非空时，在用户消息前插入一条 system 消息。
    函数 对话(提示词, 系统提示="")
        如果 本对象.可用标志 == 假
            返回 {"成功":假, "内容":"", "错误":本对象.错误信息, "用量":{}}
        定义 消息列表 = []
        如果 长度(系统提示) > 0
            追加(消息列表, 消息("system", 系统提示))
        追加(消息列表, 消息("user", 提示词))
        尝试
            定义 应答 = 对话(本对象.客户端, 消息列表, {"温度": 0.1})
            如果 安全取(应答, "成功", 假) == 真
                返回 {"成功":真, "内容":安全取(应答, "内容", ""), "错误":"", "用量":安全取(应答, "用量", {})}
            返回 {"成功":假, "内容":"", "错误":安全取(应答, "错误", "语言模型对话失败"), "用量":{}}
        捕获 错误
            返回 {"成功":假, "内容":"", "错误":`语言模型对话异常：{错误}`, "用量":{}}

    // 支持工具：判断客户端是否具备工具调用能力（chat_with_tools）。
    // 客户端创建失败或为空时返回假；只做能力检测，不发起网络请求。
    // 假语言模型对象可直接覆写此方法以模拟任意能力，供测试与降级演示使用。
    函数 支持工具()
        尝试
            如果 本对象.可用标志 == 假
                返回 假
            如果 本对象.客户端 == 空
                返回 假
            定义 能力 = 本对象.客户端.chat_with_tools
            如果 能力 == 空
                返回 假
            返回 真
        捕获 错误
            返回 假

    // 工具对话：把提示词（可带系统提示）包成消息，调用 L1 桥接的多轮工具对话。
    // 回调须接受 2 个参数（名称、参数字典）并返回结果文本；返回中文键字典
    // {"成功","内容","工具调用记录","用量","轮次","错误"}；任何失败都返回成功=假，绝不抛异常。
    函数 工具对话(提示词, 工具列表, 回调, 系统提示="")
        如果 本对象.可用标志 == 假
            返回 {"成功":假, "内容":"", "工具调用记录":[], "用量":{}, "轮次":0, "错误":本对象.错误信息}
        定义 消息列表 = []
        如果 长度(系统提示) > 0
            追加(消息列表, 消息("system", 系统提示))
        追加(消息列表, 消息("user", 提示词))
        尝试
            定义 应答 = 工具对话桥接(本对象.客户端, 消息列表, 工具列表, 回调, {"温度":0.1, "最大轮次":5})
            定义 成功标志 = 安全取(应答, "成功", 假)
            定义 内容 = 安全取(应答, "内容", "")
            定义 调用记录 = 安全取(应答, "工具调用记录", [])
            定义 用量 = 安全取(应答, "用量", {})
            定义 轮次 = 安全取(应答, "轮次", 0)
            定义 错误文本 = 安全取(应答, "错误", "")
            返回 {"成功":成功标志, "内容":内容, "工具调用记录":调用记录, "用量":用量, "轮次":轮次, "错误":错误文本}
        捕获 错误
            返回 {"成功":假, "内容":"", "工具调用记录":[], "用量":{}, "轮次":0, "错误":`工具对话异常：{错误}`}

    // 判断：调 .对话()，从内容中提取 JSON，校验结论必须为 would_accept / would_ignore。
    // JSON 容错：先整体解码，失败则截取首个 { 到最后一个 } 再解码，仍失败则成功=假。
    函数 判断(提示词, 系统提示="")
        定义 应答 = 本对象.对话(提示词, 系统提示)
        定义 用量 = 安全取(应答, "用量", {})
        如果 安全取(应答, "成功", 假) != 真
            返回 {"成功":假, "结论":"", "理由":"", "用量":用量, "错误":安全取(应答, "错误", "对话失败")}
        定义 内容 = 安全取(应答, "内容", "")
        定义 对象 = 空
        尝试
            对象 = JSON.解码(内容)
        捕获 错误
            定义 起 = 找首括号(内容)
            定义 终 = 找末括号(内容)
            如果 起 < 0 或者 终 <= 起
                返回 {"成功":假, "结论":"", "理由":"", "用量":用量, "错误":"无法从模型输出中提取JSON对象"}
            定义 片段 = 截取(内容, 起, 终 + 1)
            尝试
                对象 = JSON.解码(片段)
            捕获 解码错误
                返回 {"成功":假, "结论":"", "理由":"", "用量":用量, "错误":`JSON解析失败：{解码错误}`}
        定义 结论 = 安全取(对象, "结论", "")
        如果 结论 != "would_accept" 并且 结论 != "would_ignore"
            返回 {"成功":假, "结论":"", "理由":"", "用量":用量, "错误":`结论非法：{结论}`}
        返回 {"成功":真, "结论":结论, "理由":安全取(对象, "理由", ""), "用量":用量, "错误":""}
