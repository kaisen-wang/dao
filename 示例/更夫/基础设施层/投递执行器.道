/// 更夫 Nightwatch — L1 Outbox 投递执行器（第十二轮 / 共享契约 §2 A）
/// 职责：把 基础设施层/存储.道 中状态为 pending 的消息真正 POST 到 HTTP sink，
///       以幂等键为口径验证「外部消息 0 丢失 0 重复」，弥补第十一轮「外部消息计数
///       仍是本地 SQLite 行数口径」的诚实缺口（FR-11 / FR-15）。
/// 分层：只依赖 L1 存储.道 的 待投递列表 / 标记投递、网络.请求、编码.JSON；不依赖 L2/L3/L4。
/// 失败口径：任何请求异常或 HTTP 失败一律计入累计失败并保留 pending，不抛未捕获异常。
///
/// 诚实边界：本机 HTTP 回环 sink ≠ 真实 GitHub / 飞书 / 企微 webhook。
///           本模块验证的「0 丢失 0 重复」是本机回环口径，不代表真实外部消息计数，
///           不勾选 PRD §12 任何 DoD 项。

从 网络 导入 请求
从 编码 导入 JSON
从 基础设施层.存储 导入 待投递列表, 标记投递, 投递入队

// ======================== 投递器对象 ========================
// 字段：接收URL / 请求超时 / 最近投递明细 / 累计成功 / 累计失败。
// 最近投递明细每次 刷新() 覆盖；累计成功 / 累计失败跨多次 刷新() 累加。
类型 投递器
    初始化(接收URL, 请求超时=2)
        本对象.接收URL = 接收URL
        本对象.请求超时 = 请求超时
        本对象.最近投递明细 = []
        本对象.累计成功 = 0
        本对象.累计失败 = 0

    // 刷新一轮：遍历 pending 消息逐条 POST。
    // 可选参数 请求函数 用于同进程注入假请求（签名与 网络.请求 一致，返回带 .状态码 的对象）；
    // 无参调用 .刷新() 时回退到真实 网络.请求，保证契约接口无参可用。
    // 状态码 2xx → 标记投递(id) + 成功+1；其余 → 失败+1 且保留 pending。
    // 请求异常（连接拒绝、超时等）捕获为失败，不向上抛异常。
    // 返回中文字典 {"成功","失败","剩余待投递","明细","说明"}。
    函数 刷新(请求函数=空)
        定义 发起请求 = 请求函数
        如果 发起请求 == 空
            发起请求 = 请求

        定义 待投递 = 待投递列表()
        如果 待投递 == 空
            待投递 = []

        定义 明细 = []
        定义 成功数 = 0
        定义 失败数 = 0

        遍历 行 在 待投递
            定义 幂等键 = 文本(行["幂等键"])
            定义 载荷 = {
                "幂等键": 幂等键,
                "工单编号": 文本(行["工单编号"]),
                "类型": 文本(行["类型"]),
                "内容": 文本(行["内容"])
            }
            定义 状态码 = 0
            定义 结果 = ""

            尝试
                定义 响应 = 发起请求(本对象.接收URL, {
                    "方法": "POST",
                    "数据": JSON.编码(载荷),
                    "请求头": {"Content-Type": "application/json"},
                    "超时": 本对象.请求超时
                })
                状态码 = 响应.状态码
                // 逐层判断，不依赖 并且 / 或者 的短路行为（与 巡检.道 一致）。
                如果 状态码 >= 200
                    如果 状态码 < 300
                        标记投递(行["id"])
                        成功数 = 成功数 + 1
                        本对象.累计成功 = 本对象.累计成功 + 1
                        结果 = `投递成功：幂等键 {幂等键} 已被接收端确认（HTTP {状态码}）。`
                    否则
                        失败数 = 失败数 + 1
                        本对象.累计失败 = 本对象.累计失败 + 1
                        结果 = `投递失败：接收端返回 HTTP {状态码}，保留待投递等待补发。`
                否则
                    失败数 = 失败数 + 1
                    本对象.累计失败 = 本对象.累计失败 + 1
                    结果 = `投递失败：接收端返回 HTTP {状态码}，保留待投递等待补发。`
            捕获 错误
                // 连接拒绝 / 超时等异常：计为失败并保留 pending，异常不外泄。
                失败数 = 失败数 + 1
                本对象.累计失败 = 本对象.累计失败 + 1
                状态码 = 0
                结果 = `投递失败：请求异常（{文本(错误)}），保留待投递等待补发。`

            追加(明细, {"幂等键": 幂等键, "状态码": 状态码, "结果": 结果})

        本对象.最近投递明细 = 明细

        定义 剩余 = 待投递列表()
        如果 剩余 == 空
            剩余 = []

        定义 说明 = "本机 HTTP 回环 sink 口径的 0 丢失 0 重复；非真实平台 webhook，不勾选 PRD §12 DoD。"
        返回 {
            "成功": 成功数,
            "失败": 失败数,
            "剩余待投递": 长度(剩余),
            "明细": 明细,
            "说明": 说明
        }

    // 累计口径：跨刷新轮次的成功/失败次数，以及最近一轮明细条数。
    函数 投递统计()
        返回 {
            "累计成功": 本对象.累计成功,
            "累计失败": 本对象.累计失败,
            "最近明细数": 长度(本对象.最近投递明细)
        }

// 工厂：创建一个全新的投递器实例（每次调用返回独立实例）。
导出 函数 创建投递器(接收URL, 请求超时=2)
    返回 投递器(接收URL, 请求超时)
