// 更夫 Nightwatch — 第五轮迭代 · L1 基础设施层 · IM 第二信道适配器（FR-18）
// 职责：把飞书 / 企微的事件字典归一化成统一结构，并提供生成触发、回复消息的封装。
// 分层归属：L1 基础设施层。只依赖领域层常量/类型与标准库 编码.JSON；
//           不依赖 L3 应用层、L4 接入层，供 L3 单向调用。
// 约束（契约 §0）：函数签名完备、可对接，但默认走本地模拟，不发起任何真实外部请求。
// 所有失败都以 {"成功":假,"错误":中文提示} 返回，绝不向上抛异常。

从 领域层.领域 导入 触发, 信道飞书, 信道企微
从 编码 导入 JSON

// ======================== 内部辅助函数 ========================

// 容错取字段：字典缺键或索引失败时返回默认值，绝不抛异常。
函数 安全取(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

// 把任意值安全地转成文本；空值走默认值。
函数 取文本(值, 默认值="")
    如果 值 == 空
        返回 默认值
    尝试
        返回 文本(值)
    捕获 错误
        返回 默认值

// 飞书 content 既可能是纯文本，也可能是 {"text":"..."} 形态的 JSON 串。
// 能解出 text 就取 text，否则原样返回；解码失败也原样返回。
函数 飞书正文(内容)
    定义 原文 = 取文本(内容, "")
    如果 长度(原文) == 0
        返回 原文
    如果 原文[0] != "{"
        返回 原文
    定义 对象 = 空
    尝试
        对象 = JSON.解码(原文)
    捕获 错误
        返回 原文
    定义 正文 = 安全取(对象, "text", 原文)
    返回 取文本(正文, 原文)

// 判定文本或提及列表里是否点名了机器人。
// 文本命中 "@更夫"/"@机器人"/"@bot" 等即视为艾特；提及列表逐项转文本后再判断。
函数 含机器人提及(正文, 提及列表)
    定义 目标 = 取文本(正文, "")
    如果 包含(目标, "@更夫") 或者 包含(目标, "@机器人") 或者 包含(目标, "@nightwatch") 或者 包含(目标, "@Nightwatch") 或者 包含(目标, "@bot") 或者 包含(目标, "@Bot")
        返回 真
    如果 提及列表 == 空
        返回 假
    尝试
        遍历 项 在 提及列表
            定义 项文本 = 文本(项)
            如果 包含(项文本, "更夫") 或者 包含(项文本, "机器人") 或者 包含(项文本, "bot") 或者 包含(项文本, "Bot")
                返回 真
    捕获 错误
        返回 假
    返回 假

// ======================== 事件解析（模块级，供适配器方法分发） ========================

// 飞书事件体形如 {"event":{"message":{"content":"..."},"sender":{...}},"header":{...}}。
// 核心正文缺失时返回降级分支；其余字段逐级容错并用空串兜底。
函数 解析飞书事件(事件字典)
    尝试
        定义 头 = 安全取(事件字典, "header", {})
        定义 事件体 = 安全取(事件字典, "event", {})
        定义 消息体 = 安全取(事件体, "message", {})
        定义 发送体 = 安全取(事件体, "sender", {})
        定义 内容 = 安全取(消息体, "content", 空)
        如果 内容 == 空
            内容 = 安全取(事件体, "content", 空)
        如果 内容 == 空
            返回 {"成功":假, "错误":"飞书事件缺少 event.message.content 字段"}
        定义 正文 = 飞书正文(内容)
        定义 消息编号 = 取文本(安全取(消息体, "message_id", ""), "")
        如果 长度(消息编号) == 0
            消息编号 = 取文本(安全取(头, "event_id", ""), "")
        定义 话题 = 取文本(安全取(消息体, "chat_id", ""), "")
        如果 长度(话题) == 0
            话题 = 取文本(安全取(消息体, "root_id", ""), "")
        定义 身份体 = 安全取(发送体, "sender_id", {})
        定义 发送人 = 取文本(安全取(身份体, "open_id", ""), "")
        如果 长度(发送人) == 0
            发送人 = 取文本(安全取(身份体, "user_id", ""), "")
        如果 长度(发送人) == 0
            发送人 = 取文本(安全取(发送体, "name", ""), "")
        定义 提及 = 安全取(消息体, "mentions", [])
        定义 艾特 = 含机器人提及(正文, 提及)
        返回 {"成功":真, "消息ID":消息编号, "来源信道":信道飞书, "发送人":发送人, "话题键":话题, "文本":正文, "是否@机器人":艾特}
    捕获 错误
        返回 {"成功":假, "错误":`飞书事件解析异常：{错误}`}

// 企微事件体形如 {"FromUserName":..., "Content":..., "ChatId":...}。
// Content 缺失时返回降级分支；其余字段用空串兜底。
函数 解析企微事件(事件字典)
    尝试
        定义 内容 = 安全取(事件字典, "Content", 空)
        如果 内容 == 空
            内容 = 安全取(事件字典, "content", 空)
        如果 内容 == 空
            返回 {"成功":假, "错误":"企微事件缺少 Content 字段"}
        定义 正文 = 取文本(内容, "")
        定义 消息编号 = 取文本(安全取(事件字典, "MsgId", ""), "")
        如果 长度(消息编号) == 0
            消息编号 = 取文本(安全取(事件字典, "MsgID", ""), "")
        定义 发送人 = 取文本(安全取(事件字典, "FromUserName", ""), "")
        定义 话题 = 取文本(安全取(事件字典, "ChatId", ""), "")
        定义 艾特 = 含机器人提及(正文, 安全取(事件字典, "MentionedList", []))
        返回 {"成功":真, "消息ID":消息编号, "来源信道":信道企微, "发送人":发送人, "话题键":话题, "文本":正文, "是否@机器人":艾特}
    捕获 错误
        返回 {"成功":假, "错误":`企微事件解析异常：{错误}`}

// ======================== 适配器对象 ========================

导出 类型 即时通信适配器
    初始化(信道, 凭据一, 凭据二, 本地模式)
        本对象.信道 = 信道
        本对象.凭据一 = 凭据一
        本对象.凭据二 = 凭据二
        本对象.本地模式 = 本地模式

    // 本地模式恒为真；非本地模式仅在两项凭据都非空时为真。全程不发起真实请求。
    函数 可用()
        如果 本对象.本地模式 == 真
            返回 真
        如果 长度(本对象.凭据一) > 0 并且 长度(本对象.凭据二) > 0
            返回 真
        返回 假

    // 按信道分发到对应解析函数；解析函数内部已做全部容错。
    函数 解析消息(事件字典)
        如果 本对象.信道 == 信道企微
            返回 解析企微事件(事件字典)
        返回 解析飞书事件(事件字典)

    // 仅在归一化成功且确实艾特机器人时生成领域触发对象，否则返回空。
    函数 生成触发(事件字典)
        定义 结果 = 本对象.解析消息(事件字典)
        如果 安全取(结果, "成功", 假) != 真
            返回 空
        如果 安全取(结果, "是否@机器人", 假) != 真
            返回 空
        定义 来源 = 安全取(结果, "来源信道", 本对象.信道)
        定义 外部编号 = 安全取(结果, "消息ID", "")
        定义 话题编号 = 安全取(结果, "话题键", "")
        定义 发起人 = 安全取(结果, "发送人", "")
        定义 内容 = 安全取(结果, "文本", "")
        返回 触发(来源, 外部编号, 话题编号, 发起人, 内容, 真, 假)

    // 本地模式直接回显待回复文本并标记本地模拟；非本地模式也只返回待发送载荷。
    函数 回复消息(话题键, 文本)
        如果 本对象.本地模式 == 真
            返回 {"成功":真, "已回复":文本, "本地模拟":真}
        返回 {"成功":真, "待发送":真, "话题键":话题键, "内容":文本, "本地模拟":假}

