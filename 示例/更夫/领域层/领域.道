// 更夫 Nightwatch — 领域模型与状态机
// 对应 PRD《常驻研发协作 Agent》§5/§8：工单、阶段、授权、报告与重开规则。
// 本文件是全部模块共用的「契约」：常量与类型只在此定义，其他模块一律从此处导入。
// 注意：GitHub 相关功能（webhook、PR、Issue 评论）本轮不实现。

从 密码 导入 SHA256

// ======================== 阶段（§8） ========================
// 阶段为推导值，优先级：输入未交付 > 受阻/失败 > 待审核 > 等事件 > 执行中 > 排队
导出 常量 阶段排队   = "排队"
导出 常量 阶段执行中 = "执行中"
导出 常量 阶段等事件 = "等事件"
导出 常量 阶段待审核 = "待审核"
导出 常量 阶段受阻   = "受阻"
导出 常量 阶段失败   = "失败"
导出 常量 阶段结束   = "结束"

// ======================== 三级执行模式（FR-04） ========================
导出 常量 模式关闭 = "off"
导出 常量 模式审计 = "observe"
导出 常量 模式自动 = "auto"

// ======================== 准入类型（FR-02） ========================
// explicit=白名单用户明确请求  candidate=CI变化或普通评论  ignore=噪音  bot=机器人单列
导出 常量 准入显式   = "explicit"
导出 常量 准入候选   = "candidate"
导出 常量 准入忽略   = "ignore"
导出 常量 准入机器人 = "bot"

// ======================== 六类报告（FR-08） ========================
导出 常量 报告进度 = "progress"
导出 常量 报告等待 = "waiting"
导出 常量 报告就绪 = "ready"
导出 常量 报告受阻 = "blocked"
导出 常量 报告失败 = "failed"
导出 常量 报告丢弃 = "dropped"

// ======================== 常驻 Router 会话（FR-17 / v1.1） ========================
// 消息角色与来源信道常量；领域层只放纯数据契约，不依赖任何外部服务。
导出 常量 角色用户 = "用户"
导出 常量 角色助手 = "助手"
导出 常量 角色系统 = "系统"

导出 常量 信道GitHub = "github"
导出 常量 信道飞书 = "feishu"
导出 常量 信道企微 = "wecom"

// ======================== 工单（Ticket） ========================
导出 类型 工单
    初始化(编号, 标题, 来源, 外部编号, 发起人, 内容, 模式=模式审计, 策略版本="v0.1")
        本对象.编号 = 编号
        本对象.标题 = 标题
        本对象.来源 = 来源
        本对象.外部编号 = 外部编号
        本对象.发起人 = 发起人
        本对象.内容 = 内容
        本对象.阶段 = 阶段排队
        本对象.模式 = 模式
        本对象.策略版本 = 策略版本
        本对象.准入 = 准入候选
        本对象.授权 = 空
        本对象.绑定 = 空
        本对象.未交付输入 = []
        本对象.创建时间 = 时间戳()
        本对象.结束原因 = 空

    函数 描述()
        返回 `工单 {本对象.编号} [{本对象.阶段}] {本对象.标题}`

    函数 已结束()
        返回 本对象.阶段 == 阶段结束

    函数 加入输入(消息)
        追加(本对象.未交付输入, 消息)

    函数 取输入()
        如果 长度(本对象.未交付输入) == 0
            返回 空
        定义 首项 = 本对象.未交付输入[0]
        定义 剩余 = []
        遍历 i 从 1 到 长度(本对象.未交付输入) - 1
            追加(剩余, 本对象.未交付输入[i])
        本对象.未交付输入 = 剩余
        返回 首项

    函数 待交付数()
        返回 长度(本对象.未交付输入)

    函数 结束(原因)
        本对象.阶段 = 阶段结束
        本对象.结束原因 = 原因
        如果 本对象.绑定 != 空
            本对象.绑定.结束()

// ======================== 授权（Authorization，不可变） ========================
// FR-05：工单创建即绑定不可变授权；授权记录无 UPDATE 路径；越权评论不扩权。
导出 类型 授权
    初始化(工单编号, 授权人, 策略版本, 范围)
        本对象.工单编号 = 工单编号
        本对象.授权人 = 授权人
        本对象.策略版本 = 策略版本
        本对象.范围 = 范围
        本对象.创建时间 = 时间戳()

    函数 覆盖(请求范围)
        遍历 项 在 请求范围
            如果 项 不在 本对象.范围
                返回 假
        返回 真

    函数 描述()
        返回 `授权({本对象.工单编号}) 授权人={本对象.授权人} 策略={本对象.策略版本}`

// ======================== 触发（Trigger，环境事件） ========================
导出 类型 触发
    初始化(来源, 外部编号, 话题编号, 发起人, 内容, 是否机器人=假, 是否CI=假)
        本对象.来源 = 来源
        本对象.外部编号 = 外部编号
        本对象.话题编号 = 话题编号
        本对象.发起人 = 发起人
        本对象.内容 = 内容
        本对象.是否机器人 = 是否机器人
        本对象.是否CI = 是否CI
        本对象.准入 = 准入忽略
        本对象.策略版本 = "v0.1"
        本对象.时间 = 时间戳()

    // FR-01 去重键：(source, external_id) 哈希
    函数 去重键()
        返回 SHA256(`{本对象.来源}|{本对象.外部编号}`)

    函数 描述()
        返回 `[{本对象.来源}] {本对象.发起人}: {本对象.内容}`

// ======================== 报告（Report） ========================
导出 类型 报告
    初始化(工单编号, 类型, 消息, 数据=空)
        本对象.工单编号 = 工单编号
        本对象.类型 = 类型
        本对象.消息 = 消息
        本对象.数据 = 数据
        本对象.时间 = 时间戳()

    函数 描述()
        返回 `[{本对象.类型}] {本对象.工单编号}: {本对象.消息}`

// ======================== 执行绑定（Assignment） ========================
导出 类型 执行绑定
    初始化(工单编号, 执行者, 槽位)
        本对象.编号 = `A-{工单编号}-{时间戳()}`
        本对象.工单编号 = 工单编号
        本对象.执行者 = 执行者
        本对象.槽位 = 槽位
        本对象.状态 = "pending"
        本对象.开始时间 = 时间戳()

    函数 开始()
        本对象.状态 = "running"

    函数 结束()
        本对象.状态 = "ended"

    函数 描述()
        返回 `绑定 {本对象.编号} ({本对象.状态}) 槽位={本对象.槽位}`

// ======================== 决策记录（Decision） ========================
导出 类型 决策
    初始化(触发编号, 结论, 理由, 策略版本)
        本对象.触发编号 = 触发编号
        本对象.结论 = 结论
        本对象.理由 = 理由
        本对象.策略版本 = 策略版本
        本对象.时间 = 时间戳()

    函数 描述()
        返回 `决策 {本对象.触发编号}: {本对象.结论}（{本对象.理由}）`

// ======================== 话题（Thread） ========================
导出 类型 话题
    初始化(编号, 名称)
        本对象.编号 = 编号
        本对象.名称 = 名称
        本对象.工单列表 = []
        本对象.最后活动 = 时间戳()

    函数 订阅(工单编号)
        如果 工单编号 不在 本对象.工单列表
            追加(本对象.工单列表, 工单编号)
        本对象.最后活动 = 时间戳()

    函数 退订(工单编号)
        定义 剩余 = []
        遍历 项 在 本对象.工单列表
            如果 项 != 工单编号
                追加(剩余, 项)
        本对象.工单列表 = 剩余

    函数 已订阅(工单编号)
        返回 工单编号 在 本对象.工单列表

// ======================== 会话消息与常驻记忆（FR-17） ========================
// 一条会话消息；角色/来源信道/工单编号均为可选元数据，时间由内置时间戳生成。
导出 类型 消息
    初始化(角色, 内容, 来源信道="", 工单编号="")
        本对象.角色 = 角色
        本对象.内容 = 内容
        本对象.来源信道 = 来源信道
        本对象.工单编号 = 工单编号
        本对象.时间 = 时间戳()

    函数 描述()
        返回 `[{本对象.角色}] {本对象.内容}`

// 常驻会话：跨轮保存消息、维护话题键与最后活跃时间，提供最近消息视图。
导出 类型 会话
    初始化(会话编号, 来源信道, 话题键)
        本对象.会话编号 = 会话编号
        本对象.来源信道 = 来源信道
        本对象.话题键 = 话题键
        本对象.消息列表 = []
        本对象.最后活跃 = 时间戳()

    函数 追加消息(角色, 内容, 工单编号="")
        定义 消息对象 = 消息(角色, 内容, 本对象.来源信道, 工单编号)
        追加(本对象.消息列表, 消息对象)
        本对象.最后活跃 = 时间戳()
        返回 消息对象

    函数 消息数()
        返回 长度(本对象.消息列表)

    函数 最近消息(条数=5)
        定义 结果 = []
        定义 总数 = 长度(本对象.消息列表)
        如果 总数 == 0
            返回 结果
        定义 起点 = 总数 - 条数
        如果 起点 < 0
            起点 = 0
        定义 上限 = 总数 - 1
        遍历 i 从 0 到 上限
            如果 i >= 起点
                追加(结果, 本对象.消息列表[i])
        返回 结果

// 链式召回的上下文片段：来源类型可为 工单 / 决策 / 报告。
导出 类型 召回片段
    初始化(来源类型, 来源编号, 内容, 相关度=0.0)
        本对象.来源类型 = 来源类型
        本对象.来源编号 = 来源编号
        本对象.内容 = 内容
        本对象.相关度 = 相关度

    函数 描述()
        返回 `{本对象.来源类型}:{本对象.来源编号} {本对象.内容}`

// ======================== 状态机函数 ========================

// FR-08/§8：阶段判定不得只信单个报告，须结合绑定状态与未交付输入。
导出 函数 推导阶段(工单对象, 报告列表)
    // 优先级 1：输入未交付
    如果 工单对象.待交付数() > 0
        返回 阶段排队

    // 优先级 2：最近报告决定受阻/失败/待审核/等事件
    // 注意：道语言当前实现的「匹配」语句会误命中首个分支，故一律用 如果/否则如果。
    如果 长度(报告列表) > 0
        定义 末报告 = 报告列表[长度(报告列表) - 1]
        定义 报告类型 = 末报告.类型
        如果 报告类型 == 报告受阻
            返回 阶段受阻
        否则 如果 报告类型 == 报告失败
            返回 阶段失败
        否则 如果 报告类型 == 报告就绪
            返回 阶段待审核
        否则 如果 报告类型 == 报告等待
            返回 阶段等事件
        否则 如果 报告类型 == 报告丢弃
            返回 阶段结束

    // 优先级 3：绑定运行中 → 执行中
    如果 工单对象.绑定 != 空 并且 工单对象.绑定.状态 == "running"
        返回 阶段执行中

    // 优先级 4：排队
    返回 阶段排队

// FR-07：人工消息+授权内可重开；bot/CI 不能重开 ended 工单；人工叫停不自动恢复。
导出 函数 可重开(工单对象, 消息来源, 是否授权内)
    如果 工单对象.阶段 != 阶段结束
        返回 假
    如果 消息来源 == "机器人" 或者 消息来源 == "CI"
        返回 假
    如果 不是 是否授权内
        返回 假
    返回 真

// 生成工单编号（内存场景，不落库时也可用）
导出 函数 新工单编号()
    返回 `T-{时间戳()}`

// 六类报告快速构造，便于各模块统一使用
导出 函数 建报告(工单编号, 类型, 消息, 数据=空)
    返回 报告(工单编号, 类型, 消息, 数据)
