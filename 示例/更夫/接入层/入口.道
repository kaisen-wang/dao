// 更夫 Nightwatch — 主入口与端到端演示
// 用道语言实现 PRD《常驻研发协作 Agent》的非 GitHub 部分。
// 演示四类流程：显式请求 / observe 候选审计 / 评审跟进 / 中断恢复。
// 运行方式：先 cd 到 示例/更夫，再 python ../../源码/main.py 接入层/入口.道

从 领域层.领域 导入 工单, 触发, 执行绑定, 话题, 新工单编号
从 领域层.领域 导入 模式审计, 模式自动, 准入显式, 阶段执行中, 阶段待审核
从 领域层.领域 导入 信道飞书
从 领域层.领域 导入 推导阶段, 建报告, 报告进度
从 基础设施层.存储 导入 打开存储, 保存工单, 读取工单, 列出工单, 保存触发
从 基础设施层.存储 导入 保存报告, 列出报告, 保存决策, 列出决策, 保存授权
从 基础设施层.存储 导入 投递入队, 标记投递, 统计
从 应用层.恢复 导入 恢复检查点
从 应用层.准入 导入 创建准入器
从 应用层.授权 导入 授予, 校验, 拒绝扩权
从 应用层.评估 导入 创建评估器, 串行评估
从 应用层.调度 导入 创建调度器, 创建预算
从 调度 导入 等待全部
从 应用层.执行 导入 执行工单, 生成报告序列, 运行异步工具
从 基础设施层.看板 导入 创建看板, 处理暂停
从 基础设施层.语言模型 导入 创建语言模型, 本地模型配置, 日志脱敏
从 大模型 导入 工具定义
从 系统 导入 取环境变量
从 密码 导入 SHA256
从 应用层.路由 导入 创建路由
从 应用层.召回 导入 创建召回器, 串联召回
从 基础设施层.即时通信 导入 创建飞书适配器, 归一化事件
从 基础设施层.会话存储 导入 创建会话存储
从 基础设施层.webhook接入 导入 创建Webhook接入
从 基础设施层.GitHub事件 导入 创建GitHub适配器
从 应用层.观察审计 导入 创建观察审计, 可开启自动模式

// ======================== 全局对象 ========================
定义 存储 = 打开存储(":memory:")
// PRD §10.4：生产白名单初始仅含 AI 本人；演示模式默认放宽为测试用户以便跑通流程，
// 设置环境变量 更夫演示模式=0 即启用生产白名单。auto 模式不得在 observe 未达标时开启。
定义 生产白名单 = ["AI 本人"]
定义 演示白名单 = ["张三", "维护者"]
定义 准入白名单 = 生产白名单
如果 取环境变量("更夫演示模式", "1") != "0"
    准入白名单 = 演示白名单
定义 准入器 = 创建准入器(准入白名单)
定义 调度器 = 创建调度器(2)
定义 预算 = 创建预算(80, 100000, 5.0, 0.01)
定义 状态 = {"暂停中": 假, "模式": 模式审计}

// L1 基础设施层（语言模型适配器）：本地 ollama gemma4:e4b。不可用时评估/执行自动降级，演示不中断。
// GENGFU_NO_LLM=1 可强制走降级路径（关键词规则 + 模板报告），便于无服务时演示。
定义 模型配置 = 本地模型配置()
定义 语言模型 = 空
如果 取环境变量("GENGFU_NO_LLM", "") == ""
    语言模型 = 创建语言模型()

// 审计规则：命中后只记 would_accept，observe 模式下不改代码。
定义 审计规则 = [
    {"名称": "CI失败修复", "关键词": ["构建失败", "测试失败", "红灯"], "结论": "would_accept", "范围": ["本地CI"]},
    {"名称": "明确缺陷修复", "关键词": ["修复", "缺陷", "崩溃"], "结论": "would_accept", "范围": []}
]
定义 评估器 = 创建评估器(审计规则, "v0.1", 语言模型)

// ======================== 辅助函数 ========================

// 报告回调：落库并打印一行中文摘要。
函数 记录报告(报)
    保存报告(报)
    定义 摘要 = 报.描述()
    打印(`    [报告] {摘要}`)

// 异步工具完成回调：打印本地模拟结果。
函数 记录异步结果(结果)
    定义 命令名 = 结果["命令"]
    定义 状态文本 = 结果["状态"]
    打印(`    [异步工具] {命令名} {状态文本}`)

// 看板数据源包装。
函数 取工单()
    返回 列出工单()

函数 取决策()
    返回 列出决策()

// Watchdog 停滞巡检（FR-16）：执行中但已无运行中绑定的工单视为停滞。
函数 巡检停滞()
    定义 列表 = 列出工单()
    定义 停滞数 = 0
    遍历 单 在 列表
        如果 单.阶段 == 阶段执行中
            如果 单.绑定 == 空 或者 单.绑定.状态 != "running"
                停滞数 = 停滞数 + 1
    返回 停滞数

// 打印统计摘要。
函数 打印统计()
    定义 数据 = 统计()
    定义 工单数 = 数据["工单"]
    定义 触发数 = 数据["触发"]
    定义 报告数 = 数据["报告"]
    定义 决策数 = 数据["决策"]
    定义 outbox数 = 数据["outbox"]
    打印(`    工单={工单数} 触发={触发数} 报告={报告数} 决策={决策数} outbox={outbox数}`)

// ======================== 流程一：显式请求 ========================
函数 演示显式请求()
    打印("")
    打印("=== 流程一：显式请求（FR-02/05/06/08/10/11） ===")

    定义 触 = 触发("本地", "E-1", "Th-登录", "张三", "@更夫 请修复登录页崩溃缺陷")
    定义 准入 = 准入器.判定(触)
    保存触发(触)
    打印(`    准入判定：{准入}`)

    定义 单 = 工单(新工单编号(), "修复登录页崩溃", 触.来源, 触.外部编号, 触.发起人, 触.内容, 模式审计)
    授予(单, "张三", "v0.1", ["修复", "测试"])
    单.准入 = 准入
    定义 授 = 单.授权
    定义 授权合法 = 校验(授, ["修复"])
    定义 越权决策 = 拒绝扩权(单, ["发布上线"], "张三")
    打印(`    授权校验：{授权合法}；越权结论：{越权决策.结论}`)

    定义 话题对象 = 话题("Th-登录", "登录缺陷话题")
    话题对象.订阅(单.编号)
    保存工单(单)
    保存授权(授)

    定义 末报 = 执行工单(单, 调度器, 预算, 记录报告, ["定位登录失败原因", "修复并补充测试"], 语言模型)
    单.阶段 = 推导阶段(单, 列出报告(单.编号))
    保存工单(单)

    定义 幂等键 = SHA256(单.编号)
    定义 投递号 = 投递入队(单.编号, "待审核通知", `工单 {单.编号} 已就绪待审核`, 幂等键)
    定义 重复投递号 = 投递入队(单.编号, "待审核通知", "重复投递测试", 幂等键)
    标记投递(投递号)
    定义 幂等有效 = 投递号 == 重复投递号
    打印(`    末报告类型：{末报.类型}；推导阶段：{单.阶段}；outbox幂等：{幂等有效}`)

// ======================== 流程二：observe 候选审计 ========================
函数 演示观察审计()
    打印("")
    打印("=== 流程二：候选事件 observe 审计（FR-03/04） ===")

    定义 触 = 触发("本地CI", "E-2", "Th-登录", "ci-bot", "构建失败：登录测试用例红灯", 假, 真)
    定义 准入 = 准入器.判定(触)
    保存触发(触)
    打印(`    准入判定：{准入}`)

    定义 决 = 评估器.评估(触, 模式审计)
    保存决策(决)
    定义 说明 = 决.描述()
    打印(`    决策：{说明}`)
    打印("    observe 模式只记 would_accept，不改动任何代码")

    定义 全部决策 = 串行评估(评估器, [触], 模式审计)
    定义 条数 = 长度(全部决策)
    打印(`    串行评估条数：{条数}`)

// ======================== 流程三：评审跟进 ========================
函数 演示评审跟进()
    打印("")
    打印("=== 流程三：评审意见直通原工单（FR-06/07） ===")

    定义 单 = 列出工单()[0]
    定义 话题对象 = 话题("Th-登录", "登录缺陷话题")
    话题对象.订阅(单.编号)
    定义 已订阅 = 话题对象.已订阅(单.编号)
    打印(`    话题已订阅原工单：{已订阅}；评审意见不重复建单、不重新评估`)

    单.加入输入("请补充登录失败边界条件测试")
    定义 待交付 = 单.待交付数()
    保存工单(单)
    打印(`    补投后待交付输入数：{待交付}`)

    定义 末报 = 执行工单(单, 调度器, 预算, 记录报告, ["处理评审意见并补充测试"], 语言模型)
    单.阶段 = 推导阶段(单, 列出报告(单.编号))
    保存工单(单)
    定义 已结束 = 单.已结束()
    定义 可重开 = 真
    打印(`    末报告类型：{末报.类型}；工单阶段：{单.阶段}；是否已结束：{已结束}`)

// ======================== 流程四：中断恢复 ========================
函数 演示中断恢复()
    打印("")
    打印("=== 流程四：崩溃恢复（FR-13） ===")

    定义 单 = 工单(新工单编号(), "中断续跑演示", "本地", "E-3", "李四", "模拟执行中进程崩溃", 模式自动)
    定义 绑定 = 执行绑定(单.编号, "worker-1", 1)
    绑定.开始()
    单.绑定 = 绑定
    单.阶段 = 阶段执行中
    保存工单(单)

    定义 结果 = 恢复检查点()
    定义 说明 = 结果["说明"]
    定义 补投数 = 结果["补投数"]
    定义 恢复后 = 读取工单(单.编号)
    定义 恢复阶段 = 恢复后.阶段
    定义 恢复待交付 = 恢复后.待交付数()
    定义 推导后阶段 = 推导阶段(恢复后, 列出报告(恢复后.编号))
    打印(`    {说明}`)
    打印(`    恢复后阶段：{恢复阶段}；按未交付输入推导应为：{推导后阶段}；待交付输入：{恢复待交付}`)

// ======================== 流程五：工具驱动执行（第三轮·工具调用协议层） ========================

// 工具回调一：查询工单状态。回调签名为（名称，参数字典），返回结果文本。
函数 查工单状态(名称, 参数)
    定义 编号 = "未知"
    尝试
        编号 = 参数["编号"]
    捕获 错误
        编号 = "未知"
    返回 `已查询工单 {编号}，当前状态：已完成`

// 工具回调二：生成执行报告。
函数 生成报告(名称, 参数)
    定义 标题 = "未命名"
    尝试
        标题 = 参数["标题"]
    捕获 错误
        标题 = "未命名"
    返回 `已生成执行报告《{标题}》`

// 执行器只接收一个回调，这里按工具名分发到上面两个具体回调。
函数 工具回调(名称, 参数)
    如果 名称 == "查工单状态"
        返回 查工单状态(名称, 参数)
    返回 生成报告(名称, 参数)

// 容错取工具调用记录：降级路径的末报告数据没有该键，返回空列表以便统一遍历。
函数 取工具记录(数据)
    尝试
        返回 数据["工具调用记录"]
    捕获 错误
        返回 []

// 演示用工具调用驱动 Worker 执行：注入工具列表与工具回调，再打印工具调用记录。
// 模型不可用或工具失败一律降级为模板报告，演示不会中断。
函数 演示工具驱动执行()
    打印("")
    打印("=== 流程五：工具驱动执行（第三轮·工具调用协议层） ===")

    定义 工具列表 = [
        工具定义("查工单状态", "按工单编号查询当前状态", {"属性":{"编号":{"类型":"string","描述":"工单编号"}},"必填":["编号"]}),
        工具定义("生成报告", "根据结论生成执行报告", {"属性":{"标题":{"类型":"string","描述":"报告标题"}},"必填":["标题"]})
    ]
    定义 单 = 工单(新工单编号(), "工具驱动执行演示", "本地", "E-工具", "王五", "用工具驱动工单执行", 模式审计)
    定义 末报 = 执行工单(单, 调度器, 预算, 记录报告, ["调用工具查询状态", "生成执行报告"], 语言模型, 工具列表, 工具回调)
    定义 记录列表 = 取工具记录(末报.数据)
    打印(`    末报告类型：{末报.类型}；模型来源：{末报.数据["模型来源"]}；工具调用条数：{长度(记录列表)}`)
    遍历 记录 在 记录列表
        打印(`    [工具调用] {记录["名称"]} 参数={记录["参数"]} 结果={记录["结果"]}`)

// ======================== 流程六：常驻 Router 会话与 IM 第二信道（第五轮） ========================

// 飞书本地事件样例：@更夫 + 建单意图，跑通「IM 归一化 → Router 收消息 → 链式召回 → 统一回复」。
// 全程本地模拟：不发真实 IM 请求、不接 GitHub，语言模型不可用时自动降级。
函数 演示常驻Router()
    打印("")
    打印("=== 流程六：常驻 Router 会话与 IM 第二信道（第五轮·FR-17/18） ===")

    定义 适配器 = 创建飞书适配器()
    定义 飞书事件 = {"event": {"message": {"content": "@更夫 请修复登录页崩溃", "message_id": "om-1", "chat_id": "oc-login"}, "sender": {"sender_id": {"open_id": "ou-1"}}}, "header": {"event_id": "evt-1"}}
    定义 归一化 = 归一化事件(适配器, 飞书事件)
    定义 触发对象 = 适配器.生成触发(飞书事件)
    打印(`    IM 归一化：成功={归一化["成功"]}；来源={归一化["来源信道"]}；@机器人={归一化["是否@机器人"]}`)
    如果 触发对象 == 空
        打印("    未生成触发对象（未@机器人），跳过建单演示")
        返回
    打印(`    生成触发：外部编号={触发对象.外部编号}；话题={触发对象.话题编号}`)

    定义 路由 = 创建路由(空, 语言模型)
    定义 会话编号 = `S-{归一化["消息ID"]}`
    路由.开通会话(会话编号, 归一化["来源信道"], 归一化["话题键"])
    定义 响应 = 路由.收消息(会话编号, 归一化["文本"], 归一化["来源信道"], 归一化["发送人"])
    打印(`    收消息：工单编号={响应["工单编号"]}；会话消息数={响应["消息数"]}`)
    打印(`    回复：{响应["回复"]}`)

    // Router 只维护内存会话；接入层编排把工单与报告落库，供链式召回取数。
    定义 转办工单 = 工单(响应["工单编号"], "IM 事件转工单", 归一化["来源信道"], 归一化["消息ID"], 归一化["发送人"], 归一化["文本"], 模式审计)
    保存工单(转办工单)
    保存报告(建报告(响应["工单编号"], 报告进度, "飞书 @更夫 事件已转入工单"))

    定义 批量 = 路由.批处理(["收到，继续关注", "请处理支付失败"], 会话编号, 归一化["来源信道"])
    打印(`    批处理：{长度(批量)} 条；第二条工单编号={批量[1]["工单编号"]}`)

    定义 召回器 = 创建召回器(空)
    定义 片段列表 = 召回器.按工单(响应["工单编号"])
    定义 串联片段 = 串联召回(片段列表, 2)
    打印(`    链式召回：原始 {长度(片段列表)} 片段 → 串联后 {长度(串联片段)} 片段`)

    定义 记忆列表 = 路由.全局记忆(归一化["话题键"])
    打印(`    全局记忆：{长度(记忆列表)} 条；会话数={路由.会话数()}`)
    打印(`    {路由.统一回复(会话编号)}`)
    打印("    口径：本地模拟，未发起真实 IM 请求，未接 GitHub。")

// ======================== 流程七：会话持久化与 Webhook 接入（第六轮） ========================

// 数据库放 /tmp，webhook 事件本地构造：不发起真实 IM/HTTP 请求、不接 GitHub。
定义 第六轮回调记录 = []
函数 记录第六轮回调(数据)
    追加(第六轮回调记录, 数据)

函数 演示持久化与Webhook()
    打印("")
    打印("=== 流程七：会话持久化与 Webhook 接入（第六轮·M4 收口） ===")

    // 1. Router 注入会话存储：开通与收消息均落库。
    定义 会话库路径 = "/tmp/更夫第六轮_入口演示.db"
    定义 会话存储 = 创建会话存储(会话库路径)
    定义 路由 = 创建路由(空, 语言模型, 会话存储)
    定义 会话编号 = "S-持久化-1"
    路由.开通会话(会话编号, 信道飞书, "话题-持久化")
