// 自举自检.道 —— 用道语言查看自身语言元数据与字节原语
// ============================================================
// 运行方式：
//   cd /home/carson/code/test/道/源码
//   printf 'abc' | ./.venv/bin/python main.py ../示例/自举/自举自检.道
//
// 说明：读字节(3) 从 stdin 取 3 字节。请用管道提供短输入（如 printf），
//       不要在交互终端直接运行，否则 read() 会等待输入而阻塞。
// ============================================================

从 系统 导入 关键字表, 内置函数名, 标准库模块名

定义 关键字 = 关键字表()
定义 内置 = 内置函数名()
定义 模块 = 标准库模块名()

打印("=== 自举自检：语言元数据 ===")
打印(`关键字数量: {长度(关键字)}`)
打印(`内置函数名数量: {长度(内置)}`)
打印(`标准库模块名数量: {长度(模块)}`)
打印(`关键字示例: {关键字[0]}, {关键字[1]}, {关键字[2]}`)
打印(`内置函数名示例: {内置[0]}, {内置[1]}, {内置[2]}`)
打印(`标准库模块名示例: {模块[0]}, {模块[1]}`)

打印("=== 自举自检：字节原语 ===")
打印(`字节长度("你好") = {字节长度("你好")}`)
打印(`字节长度("abc") = {字节长度("abc")}`)
定义 读入 = 读字节(3)
打印(`读字节(3) = {文本(读入)}`)

打印("=== 自举自检完成 ===")
