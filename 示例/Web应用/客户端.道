// Web 应用示例 · 客户端（只请求本机，无外部依赖）
// 改端口的位置：下方「端口 = 取环境变量("WEB示例端口", "18081")」这一行，需与 服务器.道 同步。
// 运行：终端一先起服务器，终端二执行 cd 示例/Web应用 && python ../../源码/main.py 客户端.道

从 网络 导入 请求, URL编码
从 编码 导入 JSON
// 睡眠 与全局内置函数同名，故用「作为」起别名，避免重复定义报错。
从 时间 导入 睡眠 作为 休眠
从 系统 导入 取环境变量

定义 端口 = 取环境变量("WEB示例端口", "18081")
定义 基址 = `http://127.0.0.1:{端口}`
定义 最大尝试次数 = 3
// 中文路径需百分号编码后再交给 urllib；服务器会解码回来匹配路由。
定义 健康路径 = "/api/" + URL编码("健康")
定义 订单路径 = "/api/" + URL编码("订单")

函数 安全取(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

// 有限重试 + 线性退避：网络异常与 5xx 最多 3 次；4xx 不重试。
// 关键：请求() 对 4xx/5xx 返回响应对象而不抛异常，必须判断 响应.状态码。
// （只有 流式请求() 才对 4xx/5xx 抛异常。）
函数 取响应(方法, 路径, 数据)
    定义 次数 = 1
    定义 响应 = 空
    定义 需重试 = 假
    定义 等待秒 = 0

    当 次数 <= 最大尝试次数
        定义 选项 = {"方法": 方法, "请求头": {}, "超时": 5}
        如果 数据 != 空
            选项["请求头"] = {"Content-Type": "application/json"}
            选项["数据"] = JSON.编码(数据)

        尝试
            响应 = 请求(基址 + 路径, 选项)
        捕获 错误
            响应 = 空

        需重试 = 假
        如果 响应 == 空
            需重试 = 真
        否则
            // 5xx（含 500/502/503/504）才重试；4xx 与 2xx/3xx 直接返回。
            如果 响应.状态码 >= 500
                需重试 = 真

        如果 需重试 == 真
            如果 次数 < 最大尝试次数
                等待秒 = 0.05 * 次数
                休眠(等待秒)
                次数 = 次数 + 1
            否则
                次数 = 最大尝试次数 + 1
        否则
            次数 = 最大尝试次数 + 1

    返回 响应

// 链路一：GET 健康接口。
定义 健康响应 = 取响应("GET", 健康路径, 空)
如果 健康响应 == 空
    打印("健康接口：请求失败（网络异常）")
否则
    如果 健康响应.状态码 == 200
        定义 健康数据 = JSON.解码(健康响应.响应体)
        定义 状态文本 = 文本(安全取(健康数据, "状态", "未知"))
        打印(`健康接口：HTTP 200 / 状态={状态文本}`)
    否则
        打印(`健康接口：HTTP {健康响应.状态码}`)

// 链路二：POST 订单成功。
定义 订单响应 = 取响应("POST", 订单路径, {"商品": "键盘", "数量": 2})
如果 订单响应 == 空
    打印("订单创建：请求失败（网络异常）")
否则
    如果 订单响应.状态码 == 201
        定义 订单数据 = JSON.解码(订单响应.响应体)
        定义 商品文本 = 文本(安全取(订单数据, "商品", ""))
        定义 数量文本 = 文本(安全取(订单数据, "数量", 0))
        打印(`订单创建：HTTP 201 / 商品={商品文本} / 数量={数量文本}`)
    否则
        打印(`订单创建：HTTP {订单响应.状态码}`)

// 链路三：POST 缺字段失败（4xx 不重试）。
定义 校验响应 = 取响应("POST", 订单路径, {"商品": "键盘"})
如果 校验响应 == 空
    打印("请求校验：请求失败（网络异常）")
否则
    如果 校验响应.状态码 == 400
        定义 错误数据 = JSON.解码(校验响应.响应体)
        定义 错误文本 = 文本(安全取(错误数据, "错误", ""))
        打印(`请求校验：HTTP 400 / 错误={错误文本}`)
    否则
        打印(`请求校验：HTTP {校验响应.状态码}`)
