// Web 应用示例 · 服务端（无外部依赖）
// 改端口的位置：下方「端口 = 整数(取环境变量("WEB示例端口", "18081"))」这一行；
//               默认值 18081，改动时请同步 客户端.道 的同一行（测试用 WEB示例端口 环境变量同步两侧）。
// 运行：cd 示例/Web应用 && python ../../源码/main.py 服务器.道
// 端口被占用时应先停掉占用者，或临时设置 WEB示例端口 换端口（客户端同步设置）。

从 网络 导入 创建服务器, URL解码
从 编码 导入 JSON
从 系统 导入 取环境变量
从 文本 导入 截取

定义 端口 = 整数(取环境变量("WEB示例端口", "18081"))
定义 JSON类型 = "application/json; charset=utf-8"

// 首页 HTML：用三引号保留多行文本，避免与模板字符串的花括号冲突。
定义 首页HTML = """<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>道语言 Web 示例</title>
</head>
<body>
<h1>道语言 Web 示例</h1>
<p>服务端由「从 网络 导入 创建服务器」提供，可用端点：</p>
<ul>
<li>GET /api/健康 — 健康检查</li>
<li>POST /api/订单 — 创建订单（JSON：商品、数量）</li>
<li>GET /api/用户/用户名 — 通配路由回显用户名</li>
</ul>
</body>
</html>"""

// 安全取字段：字典缺键时返回默认值，不抛异常。
函数 安全取(对象, 键, 默认值)
    尝试
        返回 对象[键]
    捕获 错误
        返回 默认值

// 所有处理器统一返回标准响应字典：状态码 / 内容 / 内容类型。
函数 处理首页(请求对象)
    返回 {
        "状态码": 200,
        "内容": 首页HTML,
        "内容类型": "text/html; charset=utf-8"
    }

函数 处理健康(请求对象)
    返回 {
        "状态码": 200,
        "内容": {"状态": "正常"},
        "内容类型": JSON类型
    }

函数 处理订单(请求对象)
    定义 数据 = 空
    // 非法 JSON 由 .JSON() 的错误路径兜底为 400。
    尝试
        数据 = 请求对象.JSON()
    捕获 错误
        返回 {
            "状态码": 400,
            "内容": {"错误": "请求体不是合法的JSON"},
            "内容类型": JSON类型
        }

    如果 取类型(数据) != "字典"
        返回 {
            "状态码": 400,
            "内容": {"错误": "请求体必须是JSON对象"},
            "内容类型": JSON类型
        }

    // 逐层判断，不依赖 并且 / 或者 的短路行为。
    定义 商品 = 安全取(数据, "商品", 空)
    如果 商品 == 空
        返回 {
            "状态码": 400,
            "内容": {"错误": "缺少商品或数量"},
            "内容类型": JSON类型
        }
    定义 数量 = 安全取(数据, "数量", 空)
    如果 数量 == 空
        返回 {
            "状态码": 400,
            "内容": {"错误": "缺少商品或数量"},
            "内容类型": JSON类型
        }

    定义 订单 = {"商品": 商品, "数量": 数量, "状态": "已创建"}
    返回 {"状态码": 201, "内容": 订单, "内容类型": JSON类型}

// 通配路由：服务器已把百分号编码的路径解码，这里再显式 URL解码 一次作演示。
函数 处理用户(请求对象)
    定义 路径 = 请求对象["路径"]
    定义 用户名 = URL解码(截取(路径, 长度("/api/用户/")))
    返回 {
        "状态码": 200,
        "内容": {"用户": 用户名},
        "内容类型": JSON类型
    }

定义 服务器 = 创建服务器()
服务器.路由("GET", "/", 处理首页)
服务器.路由("GET", "/api/健康", 处理健康)
服务器.路由("POST", "/api/订单", 处理订单)
服务器.路由("GET", "/api/用户/*", 处理用户)

打印("Web 示例服务已启动：http://127.0.0.1:" + 文本(端口) + "/", 刷新=真)
// 阻塞监听；未匹配路径由服务器默认返回 404。
服务器.启动(端口)
